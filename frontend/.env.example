# Astro Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# DIRECTUS_URL: Internal API URL (server-to-server).
# Inside Coolify/Docker, use the service name: http://datadreamer-backend:8055
# Local dev on this branch maps host 8056 → container 8055 (backend/docker-compose.yml).
DIRECTUS_URL=http://localhost:8056

# PUBLIC_DIRECTUS_URL: External URL for browser-side images. Local dev: http://localhost:8056
PUBLIC_DIRECTUS_URL=http://localhost:8056

# DIRECTUS_TOKEN (server-only): static access token used by the v4 repository layer
# (src/lib/directus/client.ts) for public reads where the Directus Public role is not
# open (e.g. local/staging). Leave unset to read via the Public role. NEVER prefix with
# PUBLIC_. This token is not used for gated Field Guides.
# DIRECTUS_TOKEN=

# Required for Field Guide previews, gated bodies, and server-scoped progress. Server
# only. Paste the static token from the dedicated non-admin Guide Server service user.
# Do not use an admin token, learner token, or PUBLIC_ prefix.
# DIRECTUS_SERVICE_TOKEN=

# SITE_URL: canonical public origin, used for canonical URLs and absolute OG images
# (lib/seo/meta.ts). Defaults to https://data-dreamer.net if unset.
SITE_URL=https://data-dreamer.net

# Deployment environment. Set to "staging" on the Coolify staging frontend resource
# so middleware sends X-Robots-Tag: noindex. Leave as "local" or unset elsewhere.
DEPLOY_ENV=local

# PUBLIC_GUIDES_ENABLED: Guides default on. Set to "false" only as an explicit
# operational rollback while Directus schema/permissions are repaired.
PUBLIC_GUIDES_ENABLED=true

# AUTH_COOKIE_DOMAIN: parent domain the Directus session cookie is scoped to, so Google
# sign-out can clear it. Match Directus SESSION_COOKIE_DOMAIN (e.g. .data-dreamer.net).
# Leave unset in local dev.
AUTH_COOKIE_DOMAIN=.data-dreamer.net
