# Astro Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# DIRECTUS_URL: Internal API URL (server-to-server). 
# Inside Coolify/Docker, use the service name: http://datadreamer-backend:8055
DIRECTUS_URL=http://localhost:8055

# PUBLIC_DIRECTUS_URL: External URL for browser-side images.
PUBLIC_DIRECTUS_URL=https://api.data-dreamer.net

# Deployment environment. Set to "staging" on the Coolify staging frontend resource
# so middleware sends X-Robots-Tag: noindex. Leave as "local" or unset elsewhere.
DEPLOY_ENV=local
