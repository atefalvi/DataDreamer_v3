---
/**
 * SiteFooter (03 §2). Four columns / stacked on mobile. Topics come from the
 * repository but are decorative here — a CMS outage degrades to an empty list, never
 * an error (08 §8 error policy). Newsletter slot stays behind the SHOW_NEWSLETTER flag.
 */
import { topicsRepo } from '../../lib/repositories';
import { FLAGS, NAV_ITEMS, SITE, SOCIAL_LINKS } from '../../content/site';
import type { TopicRef } from '../../types/content';
import logoMark from '../../assets/brand/logo-mark.svg?raw';

let topics: TopicRef[] = [];
try {
  topics = await topicsRepo.top(5);
} catch {
  // Decorative footer list — degrade to empty silently (runs on every page; no spam).
  topics = [];
}

const exploreLinks = [{ label: 'Home', href: '/' }, ...NAV_ITEMS, { label: 'Connect', href: '/connect' }];
const year = new Date().getFullYear();
const socialSvg: Record<string, string> = {
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M0 0h24v24H0z" fill="none" /><path fill="currentColor" fill-rule="evenodd" d="M9.429 8.969h3.714v1.85c.535-1.064 1.907-2.02 3.968-2.02c3.951 0 4.889 2.118 4.889 6.004V22h-4v-6.312c0-2.213-.535-3.461-1.897-3.461c-1.889 0-2.674 1.345-2.674 3.46V22h-4zM2.57 21.83h4V8.799h-4zM7.143 4.55a2.53 2.53 0 0 1-.753 1.802a2.57 2.57 0 0 1-1.82.748a2.6 2.6 0 0 1-1.818-.747A2.55 2.55 0 0 1 2 4.55c0-.677.27-1.325.753-1.803A2.58 2.58 0 0 1 4.571 2c.682 0 1.336.269 1.819.747s.753 1.126.753 1.803" clip-rule="evenodd" /></svg>`,
