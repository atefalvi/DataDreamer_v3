  mail: `<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" d="M0 0h24v24H0z" /><path fill="currentColor" d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m-.4 4.25l-7.07 5.3a.88.88 0 0 1-1.06 0L4.4 8.25A1 1 0 0 1 5.6 6.65L12 11.45l6.4-4.8a1 1 0 0 1 1.2 1.6" /></svg>`,
};

const iconFor = (name: string) => socialSvg[name] ?? socialSvg.mail;
---

<footer class="site-footer">
  <div class="site-footer__inner container-wide">
    <div class="site-footer__brand-col">
      <a href="/" class="site-footer__brand" aria-label="DataDreamer — home">
        <span class="site-footer__mark" set:html={logoMark} />
        <span class="site-footer__wordmark" aria-hidden="true">
          <span>Data</span>
          <span>Dreamer</span>
        </span>
      </a>
      <p class="site-footer__mission">{SITE.mission}</p>
      <a href="/connect" class="site-footer__connect">
        Start a conversation
        <span aria-hidden="true">→</span>
      </a>
      {FLAGS.SHOW_NEWSLETTER && (
        <div class="site-footer__newsletter">{/* Newsletter signup — enabled when infra exists (01 §6). */}</div>
      )}
    </div>

    <div class="site-footer__cols">
      <nav class="site-footer__col" aria-label="Explore">
        <h2 class="site-footer__heading">Explore</h2>
        <ul>
          {exploreLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      {topics.length > 0 && (
        <nav class="site-footer__col" aria-label="Topics">
          <h2 class="site-footer__heading">Topics</h2>
          <ul>
            {topics.map((t) => (
              <li><a href={`/blog/topic/${t.slug}`}>{t.name}</a></li>
            ))}
          </ul>
        </nav>
      )}

      <nav class="site-footer__col" aria-label="Elsewhere">
        <h2 class="site-footer__heading">Elsewhere</h2>
        <ul class="site-footer__social">
          {SOCIAL_LINKS.map((s) => (
            <li>
              <a
                href={s.href}
                rel="noopener"
                target={s.href.startsWith('http') ? '_blank' : undefined}
                aria-label={`${s.label}${s.href.startsWith('http') ? ' (opens in a new tab)' : ''}`}
              >
                <span class="site-footer__social-icon" set:html={iconFor(s.icon)} />
                <span>{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>

  <div class="site-footer__legal container-wide">
    <span>© {year} {SITE.name}</span>
    <a href="/privacy">Privacy</a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    padding-top: var(--space-9);
    border-top: 1px solid color-mix(in srgb, var(--border-2) 72%, transparent);
    background:
      radial-gradient(circle at 12% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 30%),
      var(--bg-0);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.8fr);
    gap: var(--space-8) var(--space-9);
    align-items: start;
  }

  /* Nav columns auto-fit across the right side so they always fill the width,
     regardless of whether the optional Topics column is present. */
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: var(--space-7) var(--space-6);
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-1);
    text-decoration: none;
  }

  .site-footer__brand:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  .site-footer__mark :global(svg) {
    display: block;
    height: 42px;
    width: auto;
    color: var(--text-1);
  }

  .site-footer__wordmark {
    display: grid;
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
    line-height: 0.96;
    text-transform: uppercase;
  }

  .site-footer__mission {
    max-width: 38ch;
    margin-top: var(--space-5);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .site-footer__connect {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    min-height: 2.75rem;
    padding-inline: var(--space-5);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: var(--fs-sm);
    font-weight: 650;
    text-decoration: none;
    box-shadow: 0 10px 26px color-mix(in srgb, var(--accent) 22%, transparent);
    transition: background var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }

  .site-footer__connect:hover {
    background: var(--accent-hover);
    color: var(--text-on-accent);
    transform: translateY(-1px);
  }

  .site-footer__connect span {
    transition: transform var(--dur-2) var(--ease-out);
  }

  .site-footer__connect:hover span {
    transform: translateX(3px);
  }

  .site-footer__heading {
    margin-bottom: var(--space-4);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer__col ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__col a {
    color: var(--text-2);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }

  .site-footer__col a:hover {
    color: var(--accent);
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-footer__social-icon {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--border-2) 72%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-2) 72%, transparent);
    color: var(--text-1);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text-1) 8%, transparent);
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .site-footer__social a:hover .site-footer__social-icon {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border-2));
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-2));
    transform: translateY(-1px);
  }

  .site-footer__legal {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-8);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-1);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }

  .site-footer__legal a {
    color: var(--text-2);
  }

  @media (max-width: 63.999rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
  }

  /* Mobile: keep the link columns side by side (2-up) rather than one tall stack. */
  @media (max-width: 29.999rem) {
    .site-footer__cols {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6) var(--space-5);
    }
  }
</style>
