---
/**
 * SiteNav (03 §2, 07 §3.1). Fixed top bar: brand, desktop links, theme toggle,
 * Connect CTA, and the mobile hamburger (which controls MobileMenu). On the homepage
 * it starts transparent over the hero and gains `.is-scrolled` past 24px; elsewhere it
 * is solid from the server (no flash).
 */
import ThemeToggle from './ThemeToggle.astro';
import Icon from '../ui/Icon.astro';
import BrandMark from './BrandMark.astro';
import { NAV_ITEMS } from '../../content/site';
import { userIdentity } from '../../lib/auth/identity';

interface Props {
  transparentOverHero?: boolean;
}

const { transparentOverHero = false } = Astro.props;
const path = Astro.url.pathname.replace(/(.+)\/$/, '$1');
const user = Astro.locals.user;

function isActive(href: string): boolean {
  return href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
}

const identity = user ? userIdentity(user) : undefined;
---

<nav
  class:list={['site-nav', { 'is-scrolled': !transparentOverHero }]}
  data-transparent={transparentOverHero ? '' : undefined}
  aria-label="Primary"
>
  <div class="site-nav__inner container-wide">
    <a href="/" class="site-nav__brand" aria-label="DataDreamer — home">
      <span class="site-nav__mark" aria-hidden="true">
        <BrandMark class="site-nav__logo" />
      </span>
      <span class="site-nav__wordmark" aria-hidden="true">
        <span>Data</span>
        <span>Dreamer</span>
      </span>
    </a>

    <ul class="site-nav__links">
      {NAV_ITEMS.map((item) => (
        <li>
          <a href={item.href} class:list={{ 'is-active': isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="site-nav__actions">
      <ThemeToggle />

      {user ? (
        <details class="site-nav__menu" data-account-menu>
          <summary class="site-nav__avatar" aria-label="Account menu" aria-haspopup="menu">
            <span class:list={['site-nav__avatar-badge', { 'has-image': identity?.avatarUrl }]} aria-hidden="true">
              {identity?.avatarUrl ? <img src={identity.avatarUrl} alt="" width="36" height="36" /> : identity?.initials}
            </span>
            <Icon name="chevron-down" size={16} />
          </summary>
          <div class="site-nav__dropdown" role="menu">
            <div class="site-nav__dropdown-id">
              <span class:list={['site-nav__avatar-badge', 'site-nav__avatar-badge--lg', { 'has-image': identity?.avatarUrl }]} aria-hidden="true">
                {identity?.avatarUrl ? <img src={identity.avatarUrl} alt="" width="44" height="44" /> : identity?.initials}
              </span>
              <span class="site-nav__dropdown-meta">
                <strong>{identity?.displayName}</strong>
                <small>{identity?.secondary}</small>
              </span>
            </div>
            <a href="/account" role="menuitem"><Icon name="compass" size={16} /> My guides</a>
            <form method="post" action="/api/auth/logout">
              <button type="submit" role="menuitem"><Icon name="log-out" size={16} /> Sign out</button>
            </form>
          </div>
        </details>
      ) : (
        <a href="/login" class="site-nav__signin"><Icon name="log-in" size={16} /> Sign in</a>
      )}

      <button
        type="button"
        id="menuButton"
        class="site-nav__hamburger"
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    isolation: isolate;
    background:
      radial-gradient(80% 120% at 82% 0%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 58%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-0) 42%, transparent), color-mix(in srgb, var(--bg-0) 14%, transparent));
    backdrop-filter: blur(24px) saturate(150%);
    -webkit-backdrop-filter: blur(24px) saturate(150%);
    border-bottom: 1px solid color-mix(in srgb, var(--text-1) 9%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--text-1) 9%, transparent),
      0 16px 52px color-mix(in srgb, #000 14%, transparent);
    transition:
      background var(--dur-3) var(--ease-out),
      border-color var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3) var(--ease-out);
  }

  .site-nav::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, transparent, color-mix(in srgb, var(--text-1) 5%, transparent) 48%, transparent),
      linear-gradient(180deg, color-mix(in srgb, var(--text-1) 8%, transparent), transparent 58%);
    opacity: 0.58;
    content: '';
  }

  .site-nav[data-transparent]:not(.is-scrolled) {
    background:
      radial-gradient(70% 120% at 78% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 62%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-0) 18%, transparent), color-mix(in srgb, var(--bg-0) 3%, transparent));
    backdrop-filter: blur(16px) saturate(132%);
    -webkit-backdrop-filter: blur(16px) saturate(132%);
    border-bottom-color: color-mix(in srgb, var(--text-1) 6%, transparent);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--text-1) 8%, transparent);
  }

  .site-nav.is-scrolled {
    background:
      radial-gradient(78% 125% at 80% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-0) 48%, transparent), color-mix(in srgb, var(--bg-0) 20%, transparent));
    backdrop-filter: blur(28px) saturate(160%);
    -webkit-backdrop-filter: blur(28px) saturate(160%);
    border-bottom-color: color-mix(in srgb, var(--text-1) 11%, transparent);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--text-1) 10%, transparent),
      0 18px 54px color-mix(in srgb, #000 16%, transparent);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    gap: var(--space-6);
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    min-width: 9rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .site-nav__brand:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  .site-nav__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    color: var(--text-1);
  }

  .site-nav__mark :global(.site-nav__logo) {
    display: block;
    width: 34px;
    height: 34px;
    shape-rendering: geometricPrecision;
  }

  .site-nav__wordmark {
    display: grid;
    gap: 0;
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 0.96;
    text-transform: uppercase;
  }

  .site-nav__links {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    padding: var(--space-1);
    border: 1px solid color-mix(in srgb, var(--text-1) 9%, transparent);
    border-radius: var(--radius-full);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--text-1) 6%, transparent), transparent),
      color-mix(in srgb, var(--bg-1) 18%, transparent);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .site-nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding-inline: var(--space-4);
    border-radius: var(--radius-full);
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: 560;
    text-decoration: none;
    transition:
      color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .site-nav__links a:hover {
    color: var(--text-1);
    background: color-mix(in srgb, var(--bg-2) 68%, transparent);
  }

  .site-nav__links a.is-active {
    color: var(--text-1);
    background-color: color-mix(in srgb, var(--accent) 14%, var(--bg-1));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  /* Sign in (anonymous) */
  .site-nav__signin {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding-inline: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--accent) 50%, var(--border-2));
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--text-1);
    font-size: var(--fs-sm);
    font-weight: 650;
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out), background var(--dur-2) var(--ease-out);
  }

  .site-nav__signin:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--text-1);
  }

  /* Account avatar + dropdown (signed in) */
  .site-nav__menu {
    position: relative;
  }

  .site-nav__avatar {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 3px 6px 3px 3px;
    border: 1px solid color-mix(in srgb, var(--border-1) 82%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-1) 36%, transparent);
    color: var(--text-3);
    cursor: pointer;
    list-style: none;
    transition: border-color var(--dur-2) var(--ease-out), background var(--dur-2) var(--ease-out);
  }

  .site-nav__avatar::-webkit-details-marker { display: none; }

  .site-nav__menu[open] .site-nav__avatar,
  .site-nav__avatar:hover {
    border-color: color-mix(in srgb, var(--accent) 38%, var(--border-1));
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-1));
    color: var(--text-1);
  }

  .site-nav__menu[open] .site-nav__avatar :global(svg) { transform: rotate(180deg); }
  .site-nav__avatar :global(svg) { transition: transform var(--dur-2) var(--ease-out); }

  .site-nav__avatar-badge {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-full);
    background: linear-gradient(150deg, var(--accent), var(--accent-press));
    color: var(--text-on-accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    overflow: hidden;
  }

  .site-nav__avatar-badge.has-image { background: var(--bg-2); }

  .site-nav__avatar-badge img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .site-nav__avatar-badge--lg {
    width: 2.25rem;
    height: 2.25rem;
    font-size: var(--fs-sm);
  }

  .site-nav__dropdown {
    position: absolute;
    top: calc(100% + var(--space-3));
    right: 0;
    z-index: 10;
    display: grid;
    gap: var(--space-1);
    width: 15rem;
    padding: var(--space-2);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-1) 92%, transparent);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: var(--shadow-3);
  }

  .site-nav__dropdown-id {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    margin-bottom: var(--space-1);
    border-bottom: 1px solid var(--border-1);
  }

  .site-nav__dropdown-meta {
    display: grid;
    min-width: 0;
  }

  .site-nav__dropdown-meta strong {
    color: var(--text-1);
    font-size: var(--fs-sm);
  }

  .site-nav__dropdown-meta small {
    overflow: hidden;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-nav__dropdown a,
  .site-nav__dropdown button {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    width: 100%;
    min-height: 2.5rem;
    padding-inline: var(--space-3);
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-2);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 560;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-2) var(--ease-out), background var(--dur-2) var(--ease-out);
  }

  .site-nav__dropdown a:hover,
  .site-nav__dropdown button:hover {
    color: var(--text-1);
    background: color-mix(in srgb, var(--bg-2) 80%, transparent);
  }

  .site-nav__dropdown button:hover {
    color: var(--danger);
  }

  .site-nav__dropdown form { margin: 0; }

  .site-nav__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 11px;
    background: color-mix(in srgb, var(--bg-1) 58%, transparent);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-full);
    cursor: pointer;
  }

  .site-nav__hamburger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--text-1);
    border-radius: 2px;
    transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-2) var(--ease-out);
  }

  /* Hamburger → X while the menu is open (driven by aria-expanded). */
  .site-nav__hamburger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .site-nav__hamburger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 47.999rem) {
    .site-nav__inner {
      height: var(--nav-height);
      gap: var(--space-3);
    }

    .site-nav__brand {
      min-width: 0;
      width: 44px;
      height: 44px;
      justify-content: center;
      border: 1px solid color-mix(in srgb, var(--text-1) 10%, transparent);
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--text-1) 6%, transparent), transparent),
        color-mix(in srgb, var(--bg-1) 16%, transparent);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .site-nav__mark {
      width: 28px;
      height: 28px;
    }

    .site-nav__mark :global(.site-nav__logo) {
      width: 26px;
      height: 26px;
    }

    .site-nav__wordmark {
      display: none;
    }

    .site-nav__links,
    .site-nav__menu,
    .site-nav__signin {
      display: none;
    }
    .site-nav__hamburger {
      display: flex;
    }
  }
</style>

<script>
  // Transparent → solid on the homepage only (07 §3.1). rAF-throttled, passive.
  const nav = document.querySelector<HTMLElement>('.site-nav[data-transparent]');
  if (nav) {
    let ticking = false;
    const update = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  // Account dropdown: close on outside-click or Escape (native <details> handles toggle).
  const menu = document.querySelector<HTMLDetailsElement>('[data-account-menu]');
  if (menu) {
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
