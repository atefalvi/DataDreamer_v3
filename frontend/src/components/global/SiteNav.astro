---
/**
 * SiteNav (03 §2, 07 §3.1). Sticky top bar: brand, desktop links, theme toggle,
 * Connect CTA, and the mobile hamburger (which controls MobileMenu). On the homepage
 * it starts transparent over the hero and gains `.is-scrolled` past 24px; elsewhere it
 * is solid from the server (no flash).
 */
import ThemeToggle from './ThemeToggle.astro';
import Button from '../ui/Button.astro';
import { NAV_ITEMS } from '../../content/site';
import logoLockup from '../../assets/brand/logo-lockup.svg?raw';

interface Props {
  transparentOverHero?: boolean;
}

const { transparentOverHero = false } = Astro.props;
const path = Astro.url.pathname.replace(/(.+)\/$/, '$1');

function isActive(href: string): boolean {
  return href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
}
---

<nav
  class:list={['site-nav', { 'is-scrolled': !transparentOverHero }]}
  data-transparent={transparentOverHero ? '' : undefined}
  aria-label="Primary"
>
  <div class="site-nav__inner container-wide">
    <a href="/" class="site-nav__brand" aria-label="DataDreamer — home">
      <span class="site-nav__logo" set:html={logoLockup} />
    </a>

    <ul class="site-nav__links">
      {NAV_ITEMS.map((item) => (
        <li>
          <a href={item.href} class:list={{ 'is-active': isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="site-nav__actions">
      <ThemeToggle />
      <span class="site-nav__cta">
        <Button href="/connect" variant="primary" size="sm">Connect</Button>
      </span>
      <button
        type="button"
        id="menuButton"
        class="site-nav__hamburger"
        aria-label="Menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background var(--dur-3) var(--ease-out), border-color var(--dur-3) var(--ease-out);
  }

  .site-nav.is-scrolled {
    background: color-mix(in srgb, var(--bg-0) 78%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom-color: var(--border-1);
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: var(--space-5);
  }

  .site-nav__brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
  }

  .site-nav__brand:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  .site-nav__logo :global(svg) {
    display: block;
    height: 22px;
    width: auto;
    color: var(--text-1);
  }

  .site-nav__links {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__links a {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--text-2);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }

  .site-nav__links a:hover {
    color: var(--text-1);
  }

  .site-nav__links a.is-active {
    color: var(--text-1);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .site-nav__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 11px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .site-nav__hamburger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--text-1);
    border-radius: 2px;
    transition: transform var(--dur-2) var(--ease-out), opacity var(--dur-2) var(--ease-out);
  }

  /* Hamburger → X while the menu is open (driven by aria-expanded). */
  .site-nav__hamburger[aria-expanded='true'] span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .site-nav__hamburger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  @media (max-width: 47.999rem) {
    .site-nav__links,
    .site-nav__cta {
      display: none;
    }
    .site-nav__hamburger {
      display: flex;
    }
  }
</style>

<script>
  // Transparent → solid on the homepage only (07 §3.1). rAF-throttled, passive.
  const nav = document.querySelector<HTMLElement>('.site-nav[data-transparent]');
  if (nav) {
    let ticking = false;
    const update = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 24);
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }
</script>
