---
/**
 * ErrorPage — shared shell for 404/500 (05 §12–13). Wraps BaseLayout with the mono
 * logo watermark, kicker, heading and lead; pages pass actions via the default slot.
 * Pages set `Astro.response.status` themselves (must happen in the page frontmatter).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import logoMono from '../../assets/brand/logo-mono.svg?raw';

interface Props {
  code: number;
  seoTitle: string;
  description: string;
  heading: string;
  lead: string;
}

const { code, seoTitle, description, heading, lead } = Astro.props;
---

<BaseLayout title={seoTitle} description={description} noindex>
  <section class="error-page container-content">
    <span class="error-page__mark" aria-hidden="true" set:html={logoMono} />
    <p class="kicker">Error {code}</p>
    <h1 class="error-page__title">{heading}</h1>
    <p class="error-page__lead">{lead}</p>
    <div class="error-page__actions">
      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding-block: var(--section-y);
  }

  .error-page__mark {
    display: block;
    width: clamp(120px, 22vw, 200px);
    margin-bottom: var(--space-4);
    color: var(--text-1);
    opacity: 0.12;
  }

  .error-page__mark :global(svg) {
    width: 100%;
    height: auto;
  }

  .error-page__title {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .error-page__lead {
    max-width: 52ch;
    color: var(--text-2);
    font-size: var(--fs-lg);
  }

  .error-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>
