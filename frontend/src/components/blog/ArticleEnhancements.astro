---
interface Props {
  hasImageGrid?: boolean;
}

const { hasImageGrid = false } = Astro.props;
---

<span class="visually-hidden" aria-live="polite" data-code-copy-status></span>

{hasImageGrid && (
  <dialog class="article-lightbox" data-article-lightbox aria-label="Image viewer">
    <button type="button" class="article-lightbox__close" data-lightbox-close aria-label="Close image viewer">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <button type="button" class="article-lightbox__nav article-lightbox__nav--prev" data-lightbox-prev aria-label="Previous image">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <figure>
      <img data-lightbox-image alt="" />
      <figcaption data-lightbox-caption aria-live="polite"></figcaption>
    </figure>
    <button type="button" class="article-lightbox__nav article-lightbox__nav--next" data-lightbox-next aria-label="Next image">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </dialog>
)}

<style>
  .article-lightbox {
    position: fixed;
    margin: 0;
    width: min(100% - var(--space-6), 74rem);
    max-width: 74rem;
    max-height: min(100dvh - var(--space-6), 56rem);
    padding: var(--space-5);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-lg);
    background: var(--bg-0);
    color: var(--text-1);
    box-shadow: var(--shadow-3);
  }

  .article-lightbox[open] {
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
  }

  .article-lightbox::backdrop {
    background: color-mix(in srgb, var(--bg-0) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .article-lightbox figure {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-7) 0 0;
    padding-inline: var(--space-8);
    max-height: calc(min(100dvh - var(--space-6), 56rem) - (var(--space-5) * 2));
  }

  .article-lightbox img {
    max-width: 100%;
    max-height: calc(min(100dvh - var(--space-6), 56rem) - (var(--space-5) * 2) - 2.5rem);
    justify-self: center;
    border-radius: var(--radius-md);
    object-fit: contain;
  }

  .article-lightbox figcaption {
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-align: center;
  }

  .article-lightbox__close,
  .article-lightbox__nav {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--border-2);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-1) 88%, transparent);
    backdrop-filter: blur(6px);
    color: var(--text-1);
    cursor: pointer;
    transition:
      border-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .article-lightbox__close:hover,
  .article-lightbox__nav:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .article-lightbox__nav:hover {
    transform: translateY(-50%) scale(1.06);
  }

  .article-lightbox__close:focus-visible,
  .article-lightbox__nav:focus-visible {
    outline: 2px solid var(--focus-ring, var(--accent));
    outline-offset: 2px;
  }

  .article-lightbox__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 1;
  }

  .article-lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .article-lightbox__nav--prev {
    left: var(--space-4);
  }

  .article-lightbox__nav--next {
    right: var(--space-4);
  }

  @media (max-width: 47.999rem) {
    .article-lightbox {
      width: min(100% - var(--space-4), 42rem);
      max-height: calc(100dvh - var(--space-4));
      padding: var(--space-4);
      padding-block-end: var(--space-5);
    }

    .article-lightbox[open] {
      display: grid;
      grid-template-areas:
        "figure figure"
        "prev next";
      grid-template-columns: 1fr 1fr;
      gap: var(--space-3);
    }

    .article-lightbox figure {
      grid-area: figure;
      padding-inline: 0;
      max-height: calc(100dvh - var(--space-4) - (var(--space-4) * 2));
    }

    .article-lightbox img {
      max-height: calc(100dvh - var(--space-4) - (var(--space-4) * 2) - 7rem);
    }

    /* Controls become an intentional row under the image instead of floating overlays. */
    .article-lightbox__nav {
      position: static;
      transform: none;
    }

    .article-lightbox__nav:hover {
      transform: scale(1.06);
    }

    .article-lightbox figure {
      margin-block-start: var(--space-8);
    }

    .article-lightbox__nav--prev {
      grid-area: prev;
      justify-self: end;
    }

    .article-lightbox__nav--next {
      grid-area: next;
      justify-self: start;
    }
  }
</style>

<script>
  import { initCodeCopy } from '../../lib/markdown/codeCopy';

  const prose = document.querySelector<HTMLElement>('[data-article-prose]');

  // Code-block copy (icon + copied state) — shared with project case studies.
  initCodeCopy();

  const dialog = document.querySelector<HTMLDialogElement>('[data-article-lightbox]');
  if (dialog && prose) {
    const image = dialog.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]');
    const close = dialog.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
    const next = dialog.querySelector<HTMLButtonElement>('[data-lightbox-next]');
    const items = [...prose.querySelectorAll<HTMLButtonElement>('.ig-item')];
    let activeItems: HTMLButtonElement[] = [];
    let index = 0;
    let touchX = 0;

    const show = (nextIndex: number) => {
      if (!activeItems.length || !image || !caption) return;
      index = (nextIndex + activeItems.length) % activeItems.length;
      const item = activeItems[index];
      const itemImage = item.querySelector('img');
      const src = item.dataset.src || itemImage?.getAttribute('src') || '';
      const alt = itemImage?.getAttribute('alt') || '';
      // Prefer the authored caption (markdown image title) over alt text.
      const text = item.dataset.caption || alt;
      image.alt = alt;
      image.src = src;
      caption.textContent = `${index + 1} / ${activeItems.length}${text ? ` — ${text}` : ''}`;
    };

    const open = (item: HTMLButtonElement) => {
      const grid = item.closest('.image-grid');
      activeItems = grid ? [...grid.querySelectorAll<HTMLButtonElement>('.ig-item')] : [item];
      show(Math.max(0, activeItems.indexOf(item)));
      dialog.showModal();
      document.body.style.overflow = 'hidden';
      close?.focus();
    };

    const closeDialog = () => {
      dialog.close();
      document.body.style.overflow = '';
    };

    items.forEach((item) => {
      item.addEventListener('click', () => open(item));
    });
    close?.addEventListener('click', closeDialog);
    prev?.addEventListener('click', () => show(index - 1));
    next?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('close', () => {
      document.body.style.overflow = '';
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) closeDialog();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(index - 1);
      if (event.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('touchstart', (event) => {
      touchX = event.changedTouches[0]?.clientX ?? 0;
    }, { passive: true });
    dialog.addEventListener('touchend', (event) => {
      const endX = event.changedTouches[0]?.clientX ?? touchX;
      const delta = endX - touchX;
      if (Math.abs(delta) > 50) show(index + (delta < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
