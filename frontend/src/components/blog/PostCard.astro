---
/**
 * PostCard — one component, multiple layouts (06 §6). This batch implements the
 * `featured`/`compact` serve the homepage; `hero`/`row` serve BLOG-001. The whole
 * card is a single link; author/topic render as plain text in card context (no
 * nested interactive elements).
 */
import Avatar from '../ui/Avatar.astro';
import CollectionFeature from '../ui/CollectionFeature.astro';
import EditorialCardFrame from '../ui/EditorialCardFrame.astro';
import EditorialCover from '../ui/EditorialCover.astro';
import type { PostListItem } from '../../types/content';

interface Props {
  post: PostListItem;
  variant?: 'featured' | 'compact' | 'hero' | 'row' | 'card' | 'index';
}

const { post, variant = 'compact' } = Astro.props;
const href = `/blog/${post.slug}`;
const dateLabel = post.publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const isoDate = post.publishedAt.toISOString();
const topic = post.topics[0];
const cover = post.coverImage;
const showMedia = variant === 'featured' || variant === 'hero' || variant === 'card' || variant === 'index';
const showExcerpt = post.excerpt && (variant === 'featured' || variant === 'hero' || variant === 'row' || variant === 'card' || variant === 'index');
const showAuthor = variant === 'featured' || variant === 'hero' || variant === 'card' || variant === 'index';
const metaTail = post.readingMinutes ? `${post.readingMinutes} min read` : post.seriesLabel;
const mediaSizes = variant === 'index'
    ? '(min-width: 80rem) 400px, (min-width: 48rem) 46vw, 100vw'
    : '(min-width: 64rem) 600px, 100vw';
---

{variant === 'hero' ? (
  <CollectionFeature href={href} image={cover} kind="post" seed={post.slug}>
    <Fragment slot="meta">
      {post.featured && <span data-featured>Featured</span>}
      <time datetime={isoDate}>{dateLabel}</time>
      {topic && <span>{topic.name}</span>}
    </Fragment>
    <Fragment slot="title">{post.title}</Fragment>
    <p slot="summary">{post.excerpt}</p>
    <Fragment slot="byline">
      <Avatar src={post.author.avatar?.src} name={post.author.name} size={24} />
      <span>By <strong>{post.author.name}</strong></span>
    </Fragment>
  </CollectionFeature>
) : variant === 'index' ? (
  <EditorialCardFrame href={href} image={cover} kind="post" seed={post.slug} sizes={mediaSizes}>
    <Fragment slot="meta">
      {post.featured && <span data-featured>Featured</span>}
      <time datetime={isoDate}>{dateLabel}</time>
      {topic && <span data-topic>{topic.name}</span>}
    </Fragment>
    <Fragment slot="title">{post.title}</Fragment>
    <p slot="summary">{post.excerpt}</p>
    <Fragment slot="footer">
      <span class="post-card__index-author">
        <Avatar src={post.author.avatar?.src} name={post.author.name} size={24} />
        <span>{post.author.name}</span>
      </span>
    </Fragment>
  </EditorialCardFrame>
) : (
  <article class:list={['post-card', `post-card--${variant}`]}>
    <a href={href} class="post-card__link">
      {showMedia && (
        <EditorialCover
          image={cover}
          kind="post"
          seed={post.slug}
          sizes={mediaSizes}
          class="post-card__media"
        />
      )}

      <div class="post-card__body">
        <div class="post-card__meta">
          {post.featured && <span class="post-card__feature">Featured</span>}
          <time datetime={isoDate}>{dateLabel}</time>
          {topic && <span class="post-card__topic">{topic.name}</span>}
        </div>

        <h3 class="post-card__title">{post.title}</h3>

        {showExcerpt && <p class="post-card__excerpt">{post.excerpt}</p>}

        {showAuthor && (
          <span class="post-card__author">
            <Avatar src={post.author.avatar?.src} name={post.author.name} size={24} />
            <span>{post.author.name}</span>
          </span>
        )}

        {variant === 'row' && (
          <div class="post-card__row-foot">
            <span>{post.author.name}</span>
            {metaTail && <span>{metaTail}</span>}
          </div>
        )}
      </div>
    </a>
  </article>
)}

<style>
  .post-card__link {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }

  :global(.post-card__media) {
    overflow: hidden;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 10;
    margin-bottom: var(--space-4);
    background: var(--bg-2);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .post-card__topic {
    color: var(--accent);
  }

  .post-card__feature {
    color: var(--accent);
  }

  .post-card__title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 560;
    letter-spacing: -0.01em;
    color: var(--text-1);
    text-wrap: balance;
  }

  .post-card__link:hover .post-card__title {
    color: var(--accent);
  }

  .post-card__excerpt {
    max-width: 56ch;
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__author {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-sm);
  }

  .post-card__index-author {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-2);
  }

  .post-card__row-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .post-card__row-foot span + span::before {
    margin-inline-end: var(--space-3);
    color: var(--border-2);
    content: '/';
  }

  /* Featured: homepage large title. Compact: tighter home list. */
  .post-card--featured .post-card__title {
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
  }

  .post-card--compact {
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-1);
  }

  .post-card--compact .post-card__title {
    font-size: var(--fs-xl);
    line-height: var(--lh-xl);
  }

  /* Card: bordered vertical card for the blog grid. */
  .post-card--card {
    height: 100%;
  }

  .post-card--card .post-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: var(--space-5);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    background: var(--bg-1);
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .post-card--card :global(.post-card__media) {
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-5);
  }

  .post-card--card .post-card__title {
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
  }

  .post-card--card .post-card__excerpt {
    margin-top: var(--space-3);
    -webkit-line-clamp: 3;
  }

  .post-card--card .post-card__author {
    margin-top: auto;
    padding-top: var(--space-5);
  }

  .post-card--card .post-card__link:hover {
    border-color: var(--border-2);
    background: color-mix(in srgb, var(--bg-2) 34%, var(--bg-1));
  }

  .post-card--row {
    border-top: 1px solid var(--border-1);
  }

  .post-card--row .post-card__link {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .post-card--row .post-card__meta {
    align-self: start;
  }

  .post-card--row .post-card__title {
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
  }

  .post-card--row .post-card__excerpt {
    margin-top: var(--space-2);
    -webkit-line-clamp: 2;
  }

  .post-card--row .post-card__link:hover {
    border-color: color-mix(in srgb, var(--accent) 34%, var(--border-2));
  }

  @media (min-width: 48rem) {
    .post-card--row .post-card__link {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: var(--space-6);
    }

    .post-card--row .post-card__body {
      min-width: 0;
    }
  }

  @media (max-width: 47.999rem) {
    .post-card--row .post-card__title {
      font-size: var(--fs-xl);
      line-height: var(--lh-xl);
    }
  }

</style>
