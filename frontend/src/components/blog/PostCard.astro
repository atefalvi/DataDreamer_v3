---
/**
 * PostCard — one component, multiple layouts (06 §6). This batch implements the
 * `featured` and `compact` variants the homepage needs (05 §1.2); BLOG-001 adds `row`
 * and `hero`. The whole card is a single link; author/topic render as plain text in
 * card context (no nested interactive elements).
 */
import Avatar from '../ui/Avatar.astro';
import { directusSrcset } from '../../lib/images';
import type { PostListItem } from '../../types/content';

interface Props {
  post: PostListItem;
  variant?: 'featured' | 'compact';
}

const { post, variant = 'compact' } = Astro.props;
const href = `/blog/${post.slug}`;
const dateLabel = post.publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const isoDate = post.publishedAt.toISOString();
const topic = post.topics[0];
const cover = post.coverImage;
---

<article class:list={['post-card', `post-card--${variant}`]}>
  <a href={href} class="post-card__link">
    {variant === 'featured' && cover && (
      <div class="post-card__media">
        <img
          src={cover.src}
          srcset={directusSrcset(cover.id, [480, 800, 1200])}
          sizes="(min-width: 64rem) 600px, 100vw"
          width={cover.width}
          height={cover.height}
          alt={cover.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="post-card__body">
      <div class="post-card__meta">
        <time datetime={isoDate}>{dateLabel}</time>
        {topic && <span class="post-card__topic">{topic.name}</span>}
      </div>

      <h3 class="post-card__title">{post.title}</h3>

      {variant === 'featured' && post.excerpt && <p class="post-card__excerpt">{post.excerpt}</p>}

      {variant === 'featured' && (
        <span class="post-card__author">
          <Avatar src={post.author.avatar?.src} name={post.author.name} size={24} />
          <span>{post.author.name}</span>
        </span>
      )}
    </div>
  </a>
</article>

<style>
  .post-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .post-card__media {
    overflow: hidden;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 10;
    margin-bottom: var(--space-4);
    background: var(--bg-2);
  }

  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .post-card__link:hover .post-card__media img {
    transform: scale(1.02);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .post-card__topic {
    color: var(--accent);
  }

  .post-card__title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 560;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .post-card__link:hover .post-card__title {
    color: var(--accent);
  }

  .post-card__excerpt {
    max-width: 56ch;
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__author {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-sm);
  }

  /* Featured: large serif title. Compact: a tighter row that sits in a list. */
  .post-card--featured .post-card__title {
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
  }

  .post-card--compact {
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-1);
  }

  .post-card--compact .post-card__title {
    font-size: var(--fs-xl);
    line-height: var(--lh-xl);
  }
</style>
