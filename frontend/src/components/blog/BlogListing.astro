---
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import EmptyState from '../ui/EmptyState.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import CollectionArchive from '../ui/CollectionArchive.astro';
import CollectionHeader from '../ui/CollectionHeader.astro';
import PostCard from './PostCard.astro';
import {
  listingPagePath,
  topicPath,
  withListingFilters,
  type BlogListing as BlogListingModel,
} from '../../lib/blog/listing';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  breadcrumbs?: BreadcrumbItem[];
  clearHref?: string;
  intro: string;
  kicker: string;
  listing: BlogListingModel;
  pageBasePath: string;
  title: string;
}

const { breadcrumbs, clearHref = '/blog', intro, kicker, listing, pageBasePath, title } = Astro.props;
const activeTopic = listing.activeTopic?.slug;
const activeAuthor = listing.activeAuthor;
const activeSearch = listing.activeSearch;
const showAuthorFilter = listing.authors.length > 1;
const hasFilters = Boolean(activeTopic || activeAuthor || activeSearch);
const hasPosts = listing.featured || listing.posts.length > 0;
const displayedCount = listing.posts.length + (listing.featured ? 1 : 0);
const nextHref = listing.page.hasMore
  ? withListingFilters(listingPagePath(activeTopic, listing.page.page + 1), { author: activeAuthor, search: activeSearch })
  : undefined;
const prevHref = listing.page.page > 1
  ? withListingFilters(listingPagePath(activeTopic, listing.page.page - 1), { author: activeAuthor, search: activeSearch })
  : undefined;
---

<section class="blog-listing container-wide" aria-labelledby="blog-title">
  {breadcrumbs && <Breadcrumbs items={breadcrumbs} class="blog-listing__breadcrumbs" />}

  <CollectionHeader kicker={kicker} title={title} intro={intro} headingId="blog-title">
    <span slot="aside" class="blog-listing__count">
      {displayedCount.toString().padStart(2, '0')} post{displayedCount === 1 ? '' : 's'}
      {listing.page.page > 1 && ` / page ${listing.page.page}`}
    </span>
  </CollectionHeader>

  {listing.featured && (
    <div class="blog-listing__featured" data-reveal>
      <PostCard post={listing.featured} variant="hero" />
    </div>
  )}

  <div class:list={['blog-listing__filters', { 'blog-listing__filters--after-feature': listing.featured }]}>
    <nav class="blog-listing__topics" aria-label="Topics">
      <Chip label="All posts" href={withListingFilters('/blog', { author: activeAuthor, search: activeSearch })} selected={!activeTopic} />
      {listing.topics.map(({ topic, count }) => (
        <Chip
          label={`${topic.name} ${count}`}
          href={withListingFilters(topicPath(topic.slug), { author: activeAuthor, search: activeSearch })}
          selected={activeTopic === topic.slug}
        />
      ))}
    </nav>

    <form class="blog-listing__query-filter" method="get" action={pageBasePath} data-author-filter>
      <div class="blog-listing__search-control">
        <label for="blog-search">Search posts</label>
        <input id="blog-search" name="q" type="search" value={activeSearch} maxlength="100" placeholder="Search titles, excerpts, and topics" />
      </div>
      {showAuthorFilter && (
        <div class="blog-listing__author-filter">
          <label for="blog-author-filter">Author</label>
          <select id="blog-author-filter" name="author" data-author-select>
            <option value="">All authors</option>
            {listing.authors.map((author) => (
              <option value={author.slug} selected={author.slug === activeAuthor}>
                {author.name}
              </option>
            ))}
          </select>
        </div>
      )}
      <Button type="submit" variant="secondary" size="sm">Search</Button>
    </form>
  </div>

  {hasPosts ? (
    listing.posts.length > 0 && (
      <CollectionArchive
        headingId="blog-results-title"
        title="Latest posts"
        itemCount={listing.posts.length}
        singular="post"
        page={listing.page.page}
        prevHref={prevHref}
        nextHref={nextHref}
      >
        {listing.posts.map((post) => <PostCard post={post} variant="index" />)}
      </CollectionArchive>
    )
  ) : (
    <EmptyState
      message={hasFilters ? 'No posts match this filter yet.' : 'Published posts will appear here once they are available.'}
      icon="pen-line"
      action={hasFilters ? { label: 'Clear filter', href: clearHref } : undefined}
    />
  )}
</section>

<style>
  .blog-listing {
    padding-block: var(--page-top) var(--page-bottom);
  }

  .blog-listing__breadcrumbs {
    margin-bottom: var(--space-6);
  }

  .blog-listing__count {
    display: block;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .blog-listing__featured {
    margin-top: var(--space-7);
  }

  .blog-listing__filters {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border-1);
  }

  .blog-listing__filters--after-feature {
    border-top: 1px solid var(--border-1);
  }

  .blog-listing__topics {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-1);
    scrollbar-width: thin;
  }

  .blog-listing__topics :global(.ui-chip) {
    flex: 0 0 auto;
  }

  .blog-listing__query-filter {
    display: grid;
    gap: var(--space-3);
    align-items: end;
  }

  .blog-listing__author-filter,
  .blog-listing__search-control {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .blog-listing__author-filter label,
  .blog-listing__search-control label {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .blog-listing__author-filter select,
  .blog-listing__search-control input {
    min-height: 2.75rem;
    min-width: min(100%, 15rem);
    padding-inline: var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-md);
    background: var(--bg-1);
    color: var(--text-1);
    font: inherit;
  }

  .blog-listing :global(.ui-empty-state) {
    margin-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .blog-listing__filters {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .blog-listing__query-filter {
      grid-template-columns: minmax(16rem, 1fr) minmax(10rem, auto) auto;
    }
  }

  @media (max-width: 47.999rem) {
    .blog-listing {
      padding-block-start: var(--page-top);
    }

    .blog-listing__query-filter :global(.ui-button) {
      width: 100%;
    }

    .blog-listing__author-filter select {
      flex: 1 1 auto;
    }

  }
</style>

<script>
  // Auto-submit the author filter; search remains an explicit action.
  const select = document.querySelector<HTMLSelectElement>('[data-author-select]');
  select?.addEventListener('change', () => select.form?.submit());
</script>
