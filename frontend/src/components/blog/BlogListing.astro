---
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import EmptyState from '../ui/EmptyState.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import PostCard from './PostCard.astro';
import {
  listingPagePath,
  topicPath,
  withAuthor,
  type BlogListing as BlogListingModel,
} from '../../lib/blog/listing';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  breadcrumbs?: BreadcrumbItem[];
  clearHref?: string;
  intro: string;
  kicker: string;
  listing: BlogListingModel;
  pageBasePath: string;
  title: string;
}

const { breadcrumbs, clearHref = '/blog', intro, kicker, listing, pageBasePath, title } = Astro.props;
const activeTopic = listing.activeTopic?.slug;
const activeAuthor = listing.activeAuthor;
const showAuthorFilter = listing.authors.length > 1;
const hasFilters = Boolean(activeTopic || activeAuthor);
const hasPosts = listing.featured || listing.posts.length > 0;
const nextHref = listing.page.hasMore
  ? withAuthor(listingPagePath(activeTopic, listing.page.page + 1), activeAuthor)
  : undefined;
const prevHref = listing.page.page > 1
  ? withAuthor(listingPagePath(activeTopic, listing.page.page - 1), activeAuthor)
  : undefined;
---

<section class="blog-listing container-content" aria-labelledby="blog-title">
  {breadcrumbs && <Breadcrumbs items={breadcrumbs} class="blog-listing__breadcrumbs" />}

  <header class="blog-listing__header">
    <div>
      <p class="kicker">{kicker}</p>
      <h1 id="blog-title">{title}</h1>
    </div>
    <p>{intro}</p>
    <span class="blog-listing__count">
      {listing.page.items.length} post{listing.page.items.length === 1 ? '' : 's'}
      {listing.page.page > 1 && ` / page ${listing.page.page}`}
    </span>
  </header>

  {listing.featured && (
    <div class="blog-listing__featured" data-reveal>
      <PostCard post={listing.featured} variant="hero" />
    </div>
  )}

  <div class="blog-listing__filters">
    <nav class="blog-listing__topics" aria-label="Topics">
      <Chip label="All writing" href={withAuthor('/blog', activeAuthor)} selected={!activeTopic} />
      {listing.topics.map(({ topic, count }) => (
        <Chip
          label={`${topic.name} ${count}`}
          href={withAuthor(topicPath(topic.slug), activeAuthor)}
          selected={activeTopic === topic.slug}
        />
      ))}
    </nav>

    {showAuthorFilter && (
      <form class="blog-listing__author-filter" method="get" action={pageBasePath} data-author-filter>
        <label for="blog-author-filter">Author</label>
        <div class="blog-listing__author-control">
          <select id="blog-author-filter" name="author" data-author-select>
            <option value="">All authors</option>
            {listing.authors.map((author) => (
              <option value={author.slug} selected={author.slug === activeAuthor}>
                {author.name}
              </option>
            ))}
          </select>
          {/* No-JS fallback; hidden when JS auto-submits on change. */}
          <Button type="submit" variant="secondary" size="sm" class="blog-listing__apply">Apply</Button>
        </div>
      </form>
    )}
  </div>

  {hasPosts ? (
    <div class="blog-listing__posts" aria-label="Writing">
      {listing.posts.map((post) => (
        <PostCard post={post} variant="card" />
      ))}
    </div>
  ) : (
    <EmptyState
      message={hasFilters ? 'No writing matches this filter yet.' : 'Published writing will appear here once it is available.'}
      icon="pen-line"
      action={hasFilters ? { label: 'Clear filter', href: clearHref } : undefined}
    />
  )}

  {(prevHref || nextHref) && (
    <nav class="blog-listing__pagination" aria-label="Pagination">
      {prevHref ? <Button href={prevHref} variant="secondary">Previous</Button> : <span></span>}
      {nextHref && <Button href={nextHref} variant="secondary" icon="arrow-right">Next</Button>}
    </nav>
  )}
</section>

<style>
  .blog-listing {
    padding-block: calc(var(--nav-height) + var(--section-y)) 0;
  }

  .blog-listing__breadcrumbs {
    margin-bottom: var(--space-6);
  }

  .blog-listing__header {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-7);
    border-bottom: 1px solid color-mix(in srgb, var(--border-2) 72%, transparent);
  }

  .blog-listing__header::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    width: min(18rem, 42vw);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent));
    content: '';
  }

  .blog-listing__header h1 {
    margin-top: var(--space-3);
    font-size: var(--fs-display);
    line-height: var(--lh-display);
  }

  .blog-listing__header p:not(.kicker) {
    max-width: 50rem;
    color: var(--text-2);
    font-size: var(--fs-xl);
    line-height: var(--lh-xl);
  }

  .blog-listing__count {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .blog-listing__featured {
    margin-top: var(--space-7);
  }

  .blog-listing__filters {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--border-2) 68%, transparent);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 32%),
      color-mix(in srgb, var(--bg-1) 74%, transparent);
  }

  .blog-listing__topics {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-1);
    scrollbar-width: thin;
  }

  .blog-listing__topics :global(.ui-chip) {
    flex: 0 0 auto;
  }

  .blog-listing__author-filter {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .blog-listing__author-filter label {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .blog-listing__author-control {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .blog-listing__author-filter select {
    min-height: 2.75rem;
    min-width: min(100%, 15rem);
    padding-inline: var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-md);
    background: var(--bg-1);
    color: var(--text-1);
    font: inherit;
  }

  /* JS auto-submits on change, so the Apply button is a no-JS fallback only. */
  :global(html:not(.no-js)) .blog-listing__author-control :global(.blog-listing__apply) {
    display: none;
  }

  .blog-listing__posts {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .blog-listing :global(.ui-empty-state) {
    margin-top: var(--space-7);
  }

  .blog-listing__pagination {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .blog-listing__header {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr) auto;
      align-items: end;
    }

    .blog-listing__filters {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  @media (max-width: 47.999rem) {
    .blog-listing {
      padding-block-start: calc(var(--nav-height) + var(--space-8));
    }

    .blog-listing__header h1 {
      font-size: var(--fs-4xl);
      line-height: var(--lh-4xl);
    }

    .blog-listing__header p:not(.kicker) {
      font-size: var(--fs-lg);
      line-height: var(--lh-lg);
    }

    .blog-listing__author-filter div,
    .blog-listing__author-filter :global(.ui-button) {
      width: 100%;
    }

    .blog-listing__author-filter select {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 63.999rem) {
    .blog-listing__posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 41.999rem) {
    .blog-listing__posts {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Auto-submit the author filter on change (the Apply button is a no-JS fallback).
  const select = document.querySelector<HTMLSelectElement>('[data-author-select]');
  select?.addEventListener('change', () => select.form?.submit());
</script>
