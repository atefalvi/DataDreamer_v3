---
/**
 * GuideHero (05 §15) — the guide's pitch: topic kicker, title, summary, curator byline,
 * and key facts. Shown identically on the public preview and the authenticated reader.
 */
import { directusSrcset } from '../../lib/images';
import { formatMinutes } from '../../lib/guides/progress';
import Avatar from '../ui/Avatar.astro';
import DifficultyTag from './DifficultyTag.astro';
import type { Guide } from '../../types/content';
import { publicAuthorProfilePath } from '../../lib/authors/publicProfile';

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { title, summary, difficulty, coverImage, estimatedMinutes, itemCount, curator, topics } =
  guide;

const curatorHref = publicAuthorProfilePath(curator);
const CuratorTag = curatorHref ? 'a' : 'div';

const facts = [
  itemCount > 0 ? `${itemCount} ${itemCount === 1 ? 'resource' : 'resources'}` : null,
  estimatedMinutes ? `~${formatMinutes(estimatedMinutes)}` : null,
].filter(Boolean);
---

<header class:list={['g-hero', { 'g-hero--visual': coverImage }] }>
  {coverImage && (
    <div class="g-hero__cover">
      <img
        src={coverImage.src}
        srcset={directusSrcset(coverImage.id, [800, 1200, 1600])}
        sizes="(min-width: 70rem) 1000px, 100vw"
        width={coverImage.width}
        height={coverImage.height}
        alt={coverImage.alt}
        loading="eager"
        decoding="async"
      />
    </div>
  )}

  <div class="g-hero__content">
    {topics.length > 0 && (
      <p class="g-hero__kicker">
        {topics.map((topic, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={`/topics/${topic.slug}`}>{topic.name}</a>
          </>
        ))}
      </p>
    )}

    <h1 class="g-hero__title">{title}</h1>
    <p class="g-hero__summary">{summary}</p>

    <div class="g-hero__meta">
      {/* Curators without a public team profile render as plain text (no dead link). */}
      <CuratorTag
        href={curatorHref}
        class="g-hero__curator"
      >
        <Avatar src={curator.avatar?.src} name={curator.name} size={32} />
        <span>Curated by <strong>{curator.name}</strong></span>
      </CuratorTag>
      <DifficultyTag difficulty={difficulty} />
      {facts.map((fact) => <span class="g-hero__fact">{fact}</span>)}
    </div>
  </div>
</header>

<style>
  .g-hero {
    position: relative;
    isolation: isolate;
  }

  .g-hero--visual {
    display: flex;
    min-height: clamp(32rem, 55vw, 42rem);
    overflow: hidden;
    flex-direction: column;
    justify-content: flex-end;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    background: var(--bg-1);
  }

  .g-hero--visual::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--bg-0) 96%, transparent) 0%, color-mix(in srgb, var(--bg-0) 82%, transparent) 58%, color-mix(in srgb, var(--bg-0) 40%, transparent) 100%),
      linear-gradient(0deg, color-mix(in srgb, var(--bg-0) 96%, transparent) 0%, transparent 76%);
    content: '';
  }

  .g-hero__content {
    position: relative;
    z-index: 1;
  }

  .g-hero:not(.g-hero--visual) .g-hero__content {
    width: min(100%, 62rem);
    margin-inline: auto;
  }

  .g-hero--visual .g-hero__content {
    width: 100%;
    max-width: 68rem;
    padding: clamp(var(--space-6), 6vw, var(--space-8));
  }

  .g-hero__kicker {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-mono-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .g-hero__kicker a {
    color: var(--text-3);
    text-decoration: none;
  }

  .g-hero__kicker a:hover {
    color: var(--accent);
  }

  .g-hero__title {
    max-width: 22ch;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .g-hero__summary {
    max-width: 64ch;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .g-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-5);
  }

  .g-hero__curator {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-3);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .g-hero__curator:hover {
    color: var(--text-1);
  }

  .g-hero__curator strong {
    color: var(--text-2);
    font-weight: 600;
  }

  .g-hero__fact {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .g-hero__cover {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .g-hero__cover img {
    width: 100%;
    height: 100%;
    filter: saturate(0.55) brightness(0.7) contrast(0.94);
    object-fit: cover;
    transform: scale(1.015);
  }

  @media (max-width: 47.999rem) {
    .g-hero--visual {
      min-height: 34rem;
    }

    .g-hero--visual::after {
      background: linear-gradient(0deg, color-mix(in srgb, var(--bg-0) 98%, transparent) 0%, color-mix(in srgb, var(--bg-0) 85%, transparent) 72%, color-mix(in srgb, var(--bg-0) 54%, transparent) 100%);
    }

    .g-hero--visual .g-hero__content {
      padding: var(--space-5);
    }

    .g-hero__title {
      font-size: var(--fs-detail-title-mobile);
      line-height: var(--lh-detail-title-mobile);
    }

    .g-hero__summary {
      font-size: var(--fs-base);
      line-height: var(--lh-base);
    }
  }
</style>
