---
/**
 * GuideCard (05 §14) — Field Guide catalogue card. Whole card links to the guide.
 * Public: shows curator, difficulty, item count, and estimated duration. When the
 * reader has local resume state, the client enhancer upgrades the footer in place
 * (progressive enhancement — see guides/index.astro).
 */
import { formatMinutes } from '../../lib/guides/progress';
import EditorialCover from '../ui/EditorialCover.astro';
import DifficultyTag from './DifficultyTag.astro';
import type { GuideListItem } from '../../types/content';

interface Props {
  guide: GuideListItem;
  class?: string;
  variant?: 'card' | 'index';
}

const { guide, class: className, variant = 'card' } = Astro.props;
const { slug, title, summary, difficulty, coverImage, estimatedMinutes, itemCount, curator } =
  guide;
const href = `/guides/${slug}`;

const meta = [
  itemCount > 0 ? `${itemCount} ${itemCount === 1 ? 'resource' : 'resources'}` : null,
  estimatedMinutes ? `~${formatMinutes(estimatedMinutes)}` : null,
].filter(Boolean);
---

<article class:list={['guide-card', `guide-card--${variant}`, className]} data-guide-card data-slug={slug}>
  <a href={href} class="guide-card__link">
    <EditorialCover
      image={coverImage}
      kind="guide"
      seed={slug}
      sizes={variant === 'index' ? '(min-width: 80rem) 400px, (min-width: 48rem) 46vw, 100vw' : '(min-width: 64rem) 420px, (min-width: 48rem) 50vw, 100vw'}
      class="guide-card__media"
    >
      <DifficultyTag difficulty={difficulty} class="guide-card__difficulty" />
    </EditorialCover>

    <div class="guide-card__body">
      <h3 class="guide-card__title">{title}</h3>
      <p class="guide-card__summary">{summary}</p>
      <div class="guide-card__meta">
        {guide.featured && <span class="guide-card__feature">Featured</span>}
        {meta.map((part) => <span>{part}</span>)}
        <span class="guide-card__curator">{curator.name}</span>
      </div>
      <div class="guide-card__progress" data-guide-progress hidden>
        <div class="guide-card__bar"><span data-progress-fill></span></div>
        <span class="guide-card__resume" data-progress-label>Resume</span>
      </div>
    </div>
  </a>
</article>

<style>
  .guide-card {
    height: 100%;
  }

  .guide-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  :global(.guide-card__media) {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    background: var(--bg-2);
  }

  :global(.guide-card__media) :global(.guide-card__difficulty) {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
  }

  .guide-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: var(--space-4);
  }

  .guide-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    line-height: var(--lh-xl);
    font-weight: 560;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .guide-card__link:hover .guide-card__title {
    color: var(--accent);
  }

  .guide-card__summary {
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guide-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-1);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .guide-card__curator {
    margin-left: auto;
    color: var(--text-2);
  }

  .guide-card__feature {
    color: var(--accent);
  }

  .guide-card__progress {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* `display: flex` above would otherwise override the UA `[hidden] { display: none }`,
     so re-assert it — the resume row only appears once the enhancer reveals it. */
  .guide-card__progress[hidden] {
    display: none;
  }

  .guide-card__bar {
    flex: 1;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--bg-3);
    overflow: hidden;
  }

  .guide-card__bar span {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: inherit;
    background: var(--accent);
  }

  .guide-card__resume {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }

  .guide-card--index {
    min-width: 0;
  }

  .guide-card--index .guide-card__link {
    height: 100%;
  }

  .guide-card--index :global(.guide-card__media) {
    margin-bottom: var(--space-4);
  }

  .guide-card--index .guide-card__body {
    min-width: 0;
  }

  .guide-card--index .guide-card__title {
    font-size: var(--fs-xl);
    line-height: var(--lh-xl);
  }

  .guide-card--index .guide-card__meta {
    justify-content: flex-start;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
    padding-top: 0;
    border-top: 0;
  }

  .guide-card--index .guide-card__curator {
    margin-left: 0;
  }

  :global([data-collection-view='editorial']) .guide-card--index .guide-card__link {
    display: grid;
    grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    padding-block: var(--space-6);
    border-top: 1px solid var(--border-1);
  }

  :global([data-collection-view='editorial']) .guide-card--index :global(.guide-card__media) {
    margin: 0;
  }

  :global([data-collection-view='editorial']) .guide-card--index .guide-card__body {
    padding: 0;
  }

  :global([data-collection-view='editorial']) .guide-card--index .guide-card__title {
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
  }

  :global([data-collection-view='grid']) .guide-card--index .guide-card__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  :global([data-collection-view='list']) .guide-card--index .guide-card__link {
    display: grid;
    grid-template-columns: clamp(6rem, 14vw, 9rem) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-4);
    border-top: 1px solid var(--border-1);
  }

  :global([data-collection-view='list']) .guide-card--index :global(.guide-card__media) {
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
  }

  :global([data-collection-view='list']) .guide-card--index .guide-card__body {
    padding: 0;
  }

  @media (max-width: 35rem) {
    :global([data-collection-view='editorial']) .guide-card--index .guide-card__link {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    :global([data-collection-view='list']) .guide-card--index .guide-card__link {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: var(--space-4);
    }

    :global([data-collection-view='list']) .guide-card--index .guide-card__summary,
    :global([data-collection-view='list']) .guide-card--index .guide-card__curator {
      display: none;
    }
  }
</style>
