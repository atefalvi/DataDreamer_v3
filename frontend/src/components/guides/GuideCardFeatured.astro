---
/**
 * GuideCardFeatured — the lead guide on the catalogue: a quiet split with the
 * cover on the right and the learning-path context on the left.
 */
import { formatMinutes } from '../../lib/guides/progress';
import Avatar from '../ui/Avatar.astro';
import CollectionFeature from '../ui/CollectionFeature.astro';
import type { GuideListItem } from '../../types/content';

interface Props {
  guide: GuideListItem;
}

const { guide } = Astro.props;
const { slug, title, summary, difficulty, coverImage, estimatedMinutes, itemCount, curator, topics } = guide;
const href = `/guides/${slug}`;
const meta = [
  difficulty[0].toUpperCase() + difficulty.slice(1),
  itemCount > 0 ? `${itemCount} ${itemCount === 1 ? 'resource' : 'resources'}` : null,
  estimatedMinutes ? `~${formatMinutes(estimatedMinutes)}` : null,
].filter(Boolean);
---

<CollectionFeature
  href={href}
  image={coverImage}
  kind="guide"
  seed={slug}
  sizes="(min-width: 64rem) 560px, 100vw"
>
  <Fragment slot="meta">
    {guide.featured && <span data-featured>Featured</span>}
    {meta.map((part) => <span>{part}</span>)}
  </Fragment>
  <Fragment slot="title">{title}</Fragment>
  <p slot="summary">{summary}</p>
  <Fragment slot="byline">
    <Avatar src={curator.avatar?.src} name={curator.name} size={32} />
    <span>Curated by <strong>{curator.name}</strong></span>
  </Fragment>
  <span slot="footer" class="guide-feature__cta">Open guide <span aria-hidden="true">→</span></span>
  {topics.length > 0 && (
    <ul slot="media-overlay" class="guide-feature__topics">
      {topics.slice(0, 3).map((topic) => <li>{topic.name}</li>)}
    </ul>
  )}
</CollectionFeature>

<style>
  .guide-feature__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent);
    font-weight: 650;
    font-size: var(--fs-sm);
  }

  .guide-feature__cta span {
    transition: transform var(--dur-2) var(--ease-out);
  }

  :global(.collection-feature__link:hover) .guide-feature__cta span {
    transform: translateX(4px);
  }

  .guide-feature__topics {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .guide-feature__topics li {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-0) 64%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border-1);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

</style>
