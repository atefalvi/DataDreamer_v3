---
/**
 * CaseCard (05 §5) — project index card. Whole card links to the case study; cover is a
 * Directus asset; year + stack render as mono meta; author shown as a byline.
 */
import { directusSrcset } from '../../lib/images';
import type { ProjectListItem } from '../../types/content';

interface Props {
  project: ProjectListItem;
  class?: string;
  variant?: 'card' | 'lead' | 'row';
}

const { project, class: className, variant = 'card' } = Astro.props;
const { title, summary, year, tags, coverImage, author } = project;
const href = `/projects/${project.slug}`;
const mediaSizes = variant === 'lead'
  ? '(min-width: 64rem) 620px, 100vw'
  : variant === 'row'
    ? '(min-width: 64rem) 180px, 30vw'
    : '(min-width: 64rem) 600px, 100vw';
---

<article class:list={['case-card', `case-card--${variant}`, { 'case-card--no-media': !coverImage }, className]}>
  <a href={href} class="case-card__link">
    {coverImage && (
      <div class="case-card__media">
        <img
          src={coverImage.src}
          srcset={directusSrcset(coverImage.id, [480, 800, 1200])}
          sizes={mediaSizes}
          width={coverImage.width}
          height={coverImage.height}
          alt={coverImage.alt}
          loading={variant === 'lead' ? 'eager' : 'lazy'}
          decoding="async"
        />
      </div>
    )}
    <div class="case-card__body">
      <div class="case-card__meta">
        {project.featured && <span class="case-card__feature">Featured</span>}
        <span>{year}</span>
        <span>{tags.slice(0, 3).join(' · ')}</span>
      </div>
      <h3 class="case-card__title">{title}</h3>
      <p class="case-card__byline">By {author.name}</p>
      <p class="case-card__summary">{summary}</p>
    </div>
  </a>
</article>

<style>
  .case-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .case-card__media {
    overflow: hidden;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 10;
    margin-bottom: var(--space-4);
    background: var(--bg-2);
  }

  .case-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter var(--dur-3) var(--ease-out);
  }

  .case-card__link:hover .case-card__media img {
    filter: brightness(1.05);
  }

  .case-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .case-card__feature {
    color: var(--accent);
  }

  .case-card__title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
    font-weight: 560;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .case-card__link:hover .case-card__title {
    color: var(--accent);
  }

  .case-card__byline {
    margin-top: var(--space-2);
    color: var(--text-3);
    font-size: var(--fs-sm);
  }

  .case-card__summary {
    max-width: 56ch;
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
  }

  .case-card--lead {
    padding-block: var(--space-7);
    border-block: 1px solid var(--border-1);
  }

  .case-card--lead .case-card__link {
    display: grid;
    gap: var(--space-6);
  }

  .case-card--lead .case-card__media {
    margin: 0;
    aspect-ratio: 16 / 10;
  }

  .case-card--lead .case-card__body {
    min-width: 0;
    align-self: center;
  }

  .case-card--lead .case-card__meta {
    margin-top: 0;
  }

  .case-card--lead .case-card__title {
    max-width: 17ch;
    margin-top: var(--space-3);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    letter-spacing: -0.02em;
  }

  .case-card--lead .case-card__summary {
    max-width: 48ch;
    margin-top: var(--space-4);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .case-card--row {
    border-top: 1px solid var(--border-1);
  }

  .case-card--row .case-card__link {
    display: grid;
    grid-template-columns: clamp(7rem, 30%, 10rem) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-5);
  }

  .case-card--row .case-card__media {
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
  }

  .case-card--row .case-card__body {
    min-width: 0;
  }

  .case-card--row .case-card__meta {
    margin-top: 0;
  }

  .case-card--row .case-card__title {
    font-size: var(--fs-xl);
    line-height: var(--lh-xl);
  }

  .case-card--row .case-card__byline {
    margin-top: var(--space-1);
  }

  .case-card--row .case-card__summary {
    margin-top: var(--space-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .case-card--row.case-card--no-media .case-card__link {
    grid-template-columns: 1fr;
  }

  @media (min-width: 64rem) {
    .case-card--lead .case-card__link {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(var(--space-7), 6vw, var(--space-9));
      align-items: center;
    }

    .case-card--lead .case-card__media {
      grid-column: 2;
      grid-row: 1;
    }

    .case-card--lead .case-card__body {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (max-width: 35rem) {
    .case-card--lead {
      padding-block: var(--space-6);
    }

    .case-card--lead .case-card__title {
      font-size: var(--fs-3xl);
      line-height: var(--lh-3xl);
    }

    .case-card--lead .case-card__summary {
      font-size: var(--fs-base);
      line-height: var(--lh-base);
    }

    .case-card--row .case-card__link {
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: var(--space-4);
    }

    .case-card--row .case-card__meta span:last-child,
    .case-card--row .case-card__summary {
      display: none;
    }
  }
</style>
