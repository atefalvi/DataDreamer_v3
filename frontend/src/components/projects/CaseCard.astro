---
/**
 * CaseCard (05 §5) — project index card. Whole card links to the case study; cover is
 * an optimized Astro asset; year + stack render as mono meta.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  class?: string;
}

const { project, class: className } = Astro.props;
const { title, summary, year, stack, cover, coverAlt } = project.data;
const href = `/projects/${project.id}`;
---

<article class:list={['case-card', className]}>
  <a href={href} class="case-card__link">
    <div class="case-card__media">
      <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 600px, 100vw" />
    </div>
    <div class="case-card__body">
      <div class="case-card__meta">
        <span>{year}</span>
        <span>{stack.slice(0, 3).join(' · ')}</span>
      </div>
      <h3 class="case-card__title">{title}</h3>
      <p class="case-card__summary">{summary}</p>
    </div>
  </a>
</article>

<style>
  .case-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .case-card__media {
    overflow: hidden;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 10;
    background: var(--bg-2);
  }

  .case-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-3) var(--ease-out);
  }

  .case-card__link:hover .case-card__media :global(img) {
    transform: scale(1.02);
  }

  .case-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .case-card__title {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
    font-weight: 560;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .case-card__link:hover .case-card__title {
    color: var(--accent);
  }

  .case-card__summary {
    max-width: 56ch;
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
  }
</style>
