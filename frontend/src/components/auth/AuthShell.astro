---
/** Focused login/signup shell. Slots: default (form) and `footer` (account switch). */
import BrandMark from '../global/BrandMark.astro';
import AuthSignalField from './AuthSignalField.astro';
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="auth" aria-labelledby="auth-title">
  <AuthSignalField />
  <div class="auth__card">
    <header class="auth__header">
      <span class="auth__mark" aria-hidden="true"><BrandMark /></span>
      <h1 id="auth-title" class="auth__title">{title}</h1>
      {subtitle && <p class="auth__subtitle">{subtitle}</p>}
    </header>
    <div class="auth__body"><slot /></div>
    <footer class="auth__foot"><slot name="footer" /></footer>
  </div>
</section>

<style>
  .auth {
    position: relative;
    display: grid;
    min-height: 100svh;
    isolation: isolate;
    overflow: hidden;
    place-items: center;
    padding: calc(var(--nav-height) + var(--space-4)) var(--gutter) var(--space-4);
    background:
      radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 27rem),
      var(--bg-0);
  }

  .auth::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(ellipse 32rem 36rem at 50% 48%, transparent 45%, color-mix(in srgb, var(--bg-0) 78%, transparent) 100%);
    content: '';
    pointer-events: none;
  }

  .auth__card {
    position: relative;
    z-index: 1;
    width: min(100%, 29rem);
    display: grid;
    padding: var(--space-6);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-1) 97%, var(--bg-0));
    box-shadow: 0 24px 72px -30px rgba(0, 0, 0, 0.72);
  }

  .auth__header {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .auth__mark {
    display: block;
    width: 2rem;
    height: 2rem;
    margin-bottom: var(--space-5);
    color: var(--text-1);
  }

  .auth__title {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
    font-weight: 560;
    letter-spacing: -0.01em;
  }

  .auth__subtitle {
    max-width: 34ch;
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
  }

  .auth__body {
    min-width: 0;
  }

  .auth__foot {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-1);
    color: var(--text-3);
    font-size: var(--fs-sm);
    text-align: center;
  }

  .auth__foot :global(a) {
    color: var(--accent);
    text-decoration: none;
  }

  .auth__foot :global(a:hover) {
    text-decoration: underline;
  }

  @media (max-width: 35rem) {
    .auth {
      align-items: start;
      min-height: 100svh;
      overflow: visible;
      padding: calc(var(--nav-height) + var(--space-5)) var(--gutter) var(--space-5);
    }

    .auth__card {
      padding: var(--space-5);
    }
  }
</style>

<style is:global>
  /* Form chrome shared by /login and /signup (markup lives in the page). */
  .auth-form {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .auth-form .field {
    display: grid;
    gap: 6px;
  }

  .auth-form label {
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .auth-form input {
    width: 100%;
    min-height: 3rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-0) 72%, var(--bg-1));
    color: var(--text-1);
    font-family: var(--font-text);
    font-size: var(--fs-base);
    transition: border-color var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out);
  }

  .auth-form input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-subtle);
  }

  .auth-form .hint {
    color: var(--text-3);
    font-size: var(--fs-xs);
  }

  .auth-submit {
    margin-top: var(--space-1);
    min-height: 3rem;
    border: none;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--text-on-accent);
    font-family: var(--font-text);
    font-size: var(--fs-sm);
    font-weight: 650;
    cursor: pointer;
    box-shadow: none;
    transition: background var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out);
  }

  .auth-submit:hover {
    background: var(--accent-hover);
    box-shadow: inset 0 -2px 0 color-mix(in srgb, black 22%, transparent);
  }

  .auth-notice {
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-2);
    font-size: var(--fs-sm);
  }

  .auth-notice[data-type='error'] {
    border-color: color-mix(in srgb, var(--danger) 50%, var(--border-2));
    background: color-mix(in srgb, var(--danger) 10%, transparent);
    color: var(--text-1);
  }

  .auth-notice[data-type='info'] {
    border-color: color-mix(in srgb, var(--success) 45%, var(--border-2));
    background: color-mix(in srgb, var(--success) 10%, transparent);
    color: var(--text-1);
  }
</style>
