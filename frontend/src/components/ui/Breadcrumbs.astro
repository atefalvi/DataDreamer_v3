---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: item.href } : {}),
  })),
};
const jsonLdText = JSON.stringify(jsonLd).replaceAll("<", "\\u003c");
---

<nav class:list={["ui-breadcrumbs", className]} aria-label="Breadcrumbs">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current={index === items.length - 1 ? "page" : undefined}>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={jsonLdText} />

<style>
  .ui-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    padding: 0;
    margin: 0;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    list-style: none;
  }

  .ui-breadcrumbs li {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
  }

  .ui-breadcrumbs li:not(:last-child)::after {
    width: var(--space-3);
    height: 1px;
    background: var(--border-2);
    content: "";
  }

  .ui-breadcrumbs a {
    color: var(--text-2);
    text-decoration: none;
  }

  .ui-breadcrumbs a:hover {
    color: var(--accent);
  }

  @media (max-width: 63.999rem) {
    .ui-breadcrumbs a,
    .ui-breadcrumbs span {
      display: inline-flex;
      min-width: 2.75rem;
      min-height: 2.75rem;
      align-items: center;
    }
  }
</style>
