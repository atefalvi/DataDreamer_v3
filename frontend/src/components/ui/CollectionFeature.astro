---
/** Shared editorial lead used by the Posts, Projects, and Guides catalogues. */
import EditorialCover from './EditorialCover.astro';
import type { ImageRef } from '../../types/content';

interface Props {
  href: string;
  image?: ImageRef;
  kind: 'post' | 'project' | 'guide';
  seed: string;
  sizes?: string;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const {
  href,
  image,
  kind,
  seed,
  sizes = '(min-width: 64rem) 620px, 100vw',
  headingLevel = 'h2',
  class: className,
} = Astro.props;
const Heading = headingLevel;
---

<article class:list={['collection-feature', className]}>
  <a href={href} class="collection-feature__link">
    <EditorialCover
      image={image}
      kind={kind}
      seed={seed}
      sizes={sizes}
      loading="eager"
      class="collection-feature__media"
    >
      <slot name="media-overlay" />
    </EditorialCover>

    <div class="collection-feature__body">
      <div class="collection-feature__meta"><slot name="meta" /></div>
      <Heading class="collection-feature__title"><slot name="title" /></Heading>
      <div class="collection-feature__summary"><slot name="summary" /></div>
      <div class="collection-feature__byline"><slot name="byline" /></div>
      <div class="collection-feature__footer"><slot name="footer" /></div>
    </div>
  </a>
</article>

<style>
  .collection-feature__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding-block: var(--space-7);
    color: inherit;
    text-decoration: none;
  }

  :global(.collection-feature__media) {
    order: -1;
    margin: 0;
  }

  .collection-feature__body {
    display: flex;
    min-width: 0;
    align-self: center;
    flex-direction: column;
  }

  .collection-feature__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .collection-feature__meta :global([data-featured]) {
    color: var(--accent);
  }

  .collection-feature__title {
    max-width: 17ch;
    margin-top: var(--space-3);
    color: var(--text-1);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: var(--lh-4xl);
    text-wrap: balance;
  }

  .collection-feature__link:hover .collection-feature__title {
    color: var(--accent);
  }

  .collection-feature__summary {
    max-width: 48ch;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .collection-feature__summary :global(*) {
    margin: 0;
  }

  .collection-feature__byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--text-3);
    font-size: var(--fs-sm);
  }

  .collection-feature__byline :global(strong) {
    color: var(--text-2);
    font-weight: 600;
  }

  .collection-feature__footer:empty,
  .collection-feature__byline:empty,
  .collection-feature__summary:empty {
    display: none;
  }

  .collection-feature__footer {
    margin-top: var(--space-3);
  }

  .collection-feature__link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  @media (min-width: 64rem) {
    .collection-feature__link {
      grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
      gap: clamp(var(--space-7), 6vw, var(--space-9));
      align-items: center;
    }

    :global(.collection-feature__media) {
      grid-column: 2;
      grid-row: 1;
      order: initial;
    }

    .collection-feature__body {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (max-width: 35rem) {
    .collection-feature__link {
      padding-block: var(--space-6);
    }

    .collection-feature__title {
      font-size: var(--fs-3xl);
      line-height: var(--lh-3xl);
    }

    .collection-feature__summary {
      font-size: var(--fs-base);
      line-height: var(--lh-base);
    }
  }
</style>
