---
type AvatarSize = 24 | 32 | 48 | 64 | 96 | 128;

interface Props {
  src?: string;
  name: string;
  size?: AvatarSize;
  class?: string;
}

const { src, name, size = 48, class: className } = Astro.props;
const sizeMap: Record<AvatarSize, string> = {
  24: "1.5rem",
  32: "2rem",
  48: "3rem",
  64: "4rem",
  96: "6rem",
  128: "8rem",
};
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase())
  .join("");
---

<span class:list={["ui-avatar", className]} style={`--avatar-size: ${sizeMap[size]};`} aria-label={name}>
  {src ? <img src={src} alt={name} loading="lazy" decoding="async" /> : <span aria-hidden="true">{initials}</span>}
</span>

<style>
  .ui-avatar {
    display: inline-grid;
    width: var(--avatar-size);
    aspect-ratio: 1;
    place-items: center;
    overflow: hidden;
    background: var(--bg-2);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 2px var(--bg-0);
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: calc(var(--avatar-size) * 0.32);
    font-weight: 600;
  }

  .ui-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
