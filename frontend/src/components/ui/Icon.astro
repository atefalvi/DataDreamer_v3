---
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";

type IconSize = 16 | 20 | 24;

interface Props {
  name: string;
  size?: IconSize;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
const iconPath = join(process.cwd(), "node_modules/lucide-static/icons", `${name}.svg`);
const fallbackPath = join(process.cwd(), "node_modules/lucide-static/icons/circle-help.svg");
const rawSvg = readFileSync(existsSync(iconPath) ? iconPath : fallbackPath, "utf8");
const blackStroke = new RegExp(`stroke="${"#"}000"`, "g");
const svg = rawSvg
  .replace("<svg", `<svg class="dd-icon__svg" width="${size}" height="${size}" aria-hidden="true" focusable="false"`)
  .replace(blackStroke, 'stroke="currentColor"')
  .replaceAll('stroke="black"', 'stroke="currentColor"')
  .replaceAll('stroke-width="2"', 'stroke-width="1.75"');
---

<span class:list={["dd-icon", className]} aria-label={label} role={label ? "img" : undefined}>
  <Fragment set:html={svg} />
</span>

<style>
  .dd-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    color: currentColor;
    line-height: 0;
  }

  .dd-icon :global(.dd-icon__svg) {
    display: block;
  }
</style>
