---
import { existsSync, readFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { createRequire } from "node:module";

type IconSize = 16 | 20 | 24;

interface Props {
  name: string;
  size?: IconSize;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;
// Resolve through the module graph, not process.cwd() — the dev server may run
// with a cwd outside frontend/ (e.g. `astro dev --root frontend`).
const require = createRequire(import.meta.url);
const iconsDir = join(dirname(require.resolve("lucide-static/package.json")), "icons");
// Custom brand/glyph SVGs (src/assets/icons), resolved module-relative, take
// precedence over Lucide — lucide dropped brand marks (github/linkedin); 04 §8 allows
// custom SVGs for those.
const customDir = fileURLToPath(new URL("../../assets/icons", import.meta.url));
const customPath = join(customDir, `${name}.svg`);
const lucidePath = join(iconsDir, `${name}.svg`);
const fallbackPath = join(iconsDir, "circle-help.svg");
const iconPath = existsSync(customPath)
  ? customPath
  : existsSync(lucidePath)
    ? lucidePath
    : fallbackPath;
const rawSvg = readFileSync(iconPath, "utf8");
const blackStroke = new RegExp(`stroke="${"#"}000"`, "g");
const svg = rawSvg
  .replace("<svg", `<svg class="dd-icon__svg" width="${size}" height="${size}" aria-hidden="true" focusable="false"`)
  .replace(blackStroke, 'stroke="currentColor"')
  .replaceAll('stroke="black"', 'stroke="currentColor"')
  .replaceAll('stroke-width="2"', 'stroke-width="1.75"');
---

<span class:list={["dd-icon", className]} aria-label={label} role={label ? "img" : undefined}>
  <Fragment set:html={svg} />
</span>

<style>
  .dd-icon {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    color: currentColor;
    line-height: 0;
  }

  .dd-icon :global(.dd-icon__svg) {
    display: block;
  }
</style>
