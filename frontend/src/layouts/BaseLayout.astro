---
/**
 * BaseLayout — the v4 global shell (06 §5). Composes self-hosted fonts, base styles,
 * SeoHead, SkipLink, the pre-paint theme script, SiteNav + MobileMenu, <main>, and
 * SiteFooter. Pass `transparentNav` on the homepage so the bar starts transparent over
 * the hero (07 §3.1).
 */
import frauncesLatinUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import jetbrainsMonoLatinUrl from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import '../styles/fonts.css';
import '../styles/base.css';

import SeoHead from '../components/global/SeoHead.astro';
import SkipLink from '../components/global/SkipLink.astro';
import SiteNav from '../components/global/SiteNav.astro';
import MobileMenu from '../components/global/MobileMenu.astro';
import SiteFooter from '../components/global/SiteFooter.astro';
import { absoluteUrl } from '../lib/seo/meta';
import type { Seo } from '../lib/seo/meta';

interface Props extends Seo {
  bodyClass?: string;
  transparentNav?: boolean;
}

const { bodyClass, transparentNav = false, ...seo } = Astro.props;
const rssFeed = { href: absoluteUrl('/rss.xml'), title: 'DataDreamer RSS', type: 'application/rss+xml' };
const feedMap = new Map([rssFeed, ...(seo.alternateFeeds ?? [])].map((feed) => [feed.href, feed]));
const seoWithDefaults = { ...seo, alternateFeeds: [...feedMap.values()] };
const orbyWidgetUrl = (() => {
  const value = import.meta.env.PUBLIC_ORBY_WIDGET_URL;
  if (!value) return undefined;
  try {
    const url = new URL(value);
    if (!url.searchParams.has('v')) url.searchParams.set('v', '2702507');
    return url.toString();
  } catch {
    return value;
  }
})();
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={frauncesLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrainsMonoLatinUrl} as="font" type="font/woff2" crossorigin />
    <SeoHead {...seoWithDefaults} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          d.setAttribute('data-theme', saved === 'light' || (!saved && !prefersDark) ? 'light' : 'dark');
        } catch (e) {
          d.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <SkipLink />
    <header>
      <SiteNav transparentOverHero={transparentNav} />
    </header>
    <MobileMenu />

    <main id="main">
      <slot />
    </main>

    <SiteFooter />

    <script>
      import { initReveal } from '../lib/motion/reveal';
      initReveal();
    </script>

    {/* Orby chat widget — entirely separate service (github.com/atefalvi/orby). Unset
        PUBLIC_ORBY_WIDGET_URL = no script tag = no Orby; the widget itself also
        fails closed if its backend or the Directus `orby.enabled` flag is off. */}
    {orbyWidgetUrl && (
      <script src={orbyWidgetUrl} data-site="datadreamer" defer is:inline></script>
    )}
  </body>
</html>
