<figure class="diagram-block diagram-block--flow" data-diagram-type="flow" data-diagram-cache-key="a1ede00855676d2509d8:diagram-v1"><figcaption class="diagram-block__head"><span class="diagram-block__kind">Flow diagram</span><span class="diagram-block__title">Data quality gate</span></figcaption><div class="diagram-block__viewport" role="region" aria-label="Data quality gate. Scroll horizontally to inspect the complete diagram." tabindex="0"><svg class="diagram-svg diagram-svg--flow" viewBox="0 0 797 232" width="797" height="232" role="img" aria-label="Data quality gate" style="--diagram-width: 797px;"><title>Data quality gate</title><defs><marker id="diagram-a1ede0085567-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path class="diagram-arrow" d="M0 0L8 4L0 8Z"></path></marker></defs><g class="diagram-edges"><g class="diagram-edge-group"><path class="diagram-edge diagram-edge--same-lane" d="M178.6 58H232.6" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="left-center"></path></g><g class="diagram-edge-group"><path class="diagram-edge diagram-edge--same-lane" d="M376.6 58H430.6" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="left-center"></path><text class="diagram-edge__label" x="403.6" y="44" text-anchor="middle">YES</text></g><g class="diagram-edge-group"><path class="diagram-edge diagram-edge--same-lane" d="M574.6 58H628.6" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="left-center"></path></g><g class="diagram-edge-group"><path class="diagram-edge diagram-edge--branch-down" d="M304.6 86V174H430.6" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="middle-left"></path><text class="diagram-edge__label" x="328.6" y="130" text-anchor="middle">NO</text></g><g class="diagram-edge-group"><path class="diagram-edge diagram-edge--direct-vertical" d="M502.6 146V86" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="bottom-center"></path></g></g><g class="diagram-