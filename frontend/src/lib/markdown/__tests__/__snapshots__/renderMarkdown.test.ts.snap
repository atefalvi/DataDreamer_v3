exports[`renderMarkdown v4 pipeline > matches the golden HTML for diagram-blocks.md > diagram-blocks.md 1`] = `
"<h1 id="diagram-blocks">Diagram blocks<a class="heading-anchor" aria-label="Copy link to this section" href="#diagram-blocks"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 13a5 5 0 0 0 7.54.54l2-2a5 5 0 0 0-7.07-7.07l-1.15 1.15"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-2 2a5 5 0 0 0 7.07 7.07l1.14-1.14"></path></svg></a></h1>
<h2 id="data-quality-gate">Data quality gate<a class="heading-anchor" aria-label="Copy link to this section" href="#data-quality-gate"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M10 13a5 5 0 0 0 7.54.54l2-2a5 5 0 0 0-7.07-7.07l-1.15 1.15"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-2 2a5 5 0 0 0 7.07 7.07l1.14-1.14"></path></svg></a></h2>
<figure class="diagram-block diagram-block--flow" data-diagram-type="flow" data-diagram-cache-key="a1ede00855676d2509d8:diagram-v6"><figcaption class="diagram-block__head"><span class="diagram-block__kind">Flow diagram</span><span class="diagram-block__title">Data quality gate</span></figcaption><div class="diagram-block__viewport" role="region" aria-label="Data quality gate. Scroll horizontally to inspect the complete diagram." tabindex="0"><svg class="diagram-svg diagram-svg--flow" viewBox="0 0 673 216" width="673" height="216" role="img" aria-label="Data quality gate" style="--diagram-width: 673px;"><title>Data quality gate</title><defs><marker id="diagram-a1ede0085567-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path class="diagram-arrow" d="M0 0L8 4L0 8Z"></path></marker><marker id="diagram-a1ede0085567-arrow-accent" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path class="diagram-arrow diagram-arrow--accent" d="M0 0L8 4L0 8Z"></path></marker></defs><g class="diagram-edges"><g class="diagram-edge-group diagram-edge-group--yellow" data-source-node="flow-node-1" data-target-node="flow-node-2"><title>Incoming data to Valid?</title><path class="diagram-edge__hit-area" d="M150.2 50H206.2"></path><path class="diagram-edge diagram-edge--same-lane" d="M150.2 50H206.2" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="left-center"></path></g><g class="diagram-edge-group diagram-edge-group--blue" data-source-node="flow-node-2" data-target-node="flow-node-3"><title>Valid? to Load via yes</title><path class="diagram-edge__hit-area" d="M318.2 50H374.2"></path><path class="diagram-edge diagram-edge--same-lane" d="M318.2 50H374.2" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="left-center"></path><text class="diagram-edge__label" x="346.2" y="36" text-anchor="middle">YES</text></g><g class="diagram-edge-group diagram-edge-group--green" data-source-node="flow-node-3" data-target-node="flow-node-4"><title>Load to Available</title><path class="diagram-edge__hit-area" d="M486.2 50H542.2"></path><path class="diagram-edge diagram-edge--same-lane" d="M486.2 50H542.2" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="left-center"></path></g><g class="diagram-edge-group diagram-edge-group--orange" data-source-node="flow-node-2" data-target-node="flow-node-5"><title>Valid? to Remediate via no</title><path class="diagram-edge__hit-area" d="M262.2 76V166H374.2"></path><path class="diagram-edge diagram-edge--branch-down" d="M262.2 76V166H374.2" marker-end="url(#diagram-a1ede0085567-arrow)" data-target-anchor="middle-left"></path><text class="diagram-edge__label" x="318.2" y="154" text-anchor="middle">NO</text></g><g class="diagram-edge-group diagram-edge-group--blue" data-source-node="flow-node-5" data-target-node="flow-node-3"><title>Remediate to Load</title><path class="diagram-edge__hit-area" d="M430.2 140V76"></path><path class="diagram-edge diagram-edge--direct-vertical diagram-edge--reference" d="M430.2 140V76" marker-end="url(#diagram-a1ede0085567-arrow-accent)" data-target-anchor="bottom-center"></path></g></g><g class="diagram-nodes"><g class="diagram-node diagram-node--default" data-node-id="flow-node-1"><rect x="18" y="24" width="132.2" height="52" rx="8"></rect><text x="84.1" y="50" text-anchor="middle" dominant-baseline="middle">Incoming data</text></g><g class="diagram-node diagram-node--yellow diagram-node--decision" data-node-id="flow-node-2"><rect x="206.2" y="24" width="112" height="52" rx="26"></rect><text x="262.2" y="50" text-anchor="middle" dominant-baseline="middle">Valid?</text></g><g class="diagram-node diagram-node--blue" data-node-id="flow-node-3"><rect x="374.2" y="24" width="112" height="52" rx="8"></rect><text x="430.2" y="50" text-anchor="middle" dominant-baseline="middle">Load</text></g><g class="diagram-node diagram-node--green" data-node-id="flow-node-4"><rect x="542.2" y="24" width="112" height="52" rx="8"></rect><te