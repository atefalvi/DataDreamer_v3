<div class="table-scroll" role="region" aria-label="Scrollable table" tabindex="0"><table><thead><tr><th>Model</th><th align="right">Params</th><th align="right">VRAM</th><th align="right">Throughput</th></tr></thead><tbody><tr><td>Mistral 7B</td><td align="right">7B</td><td align="right">16 GB</td><td align="right">42 tok/s</td></tr><tr><td>Llama 3 8B</td><td align="right">8B</td><td align="right">18 GB</td><td align="right">38 tok/s</td></tr></tbody></table></div>
<div class="code-block"><div class="code-block__header"><span class="code-block__language">python</span><button class="code-block__copy" type="button" aria-label="Copy code" data-code-copy=""><svg class="code-block__icon code-block__icon--copy" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="13" height="13" x="9" y="9" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><svg class="code-block__icon code-block__icon--done" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="visually-hidden" data-copy-label="">Copy</span></button></div><pre class="shiki shiki-themes github-light-default github-dark-default" style="--shiki-light:#1f2328;--shiki-dark:#e6edf3;--shiki-light-bg:#ffffff;--shiki-dark-bg:#0d1117" tabindex="0"><code><span class="line"><span style="--shiki-light:#CF222E;--shiki-dark:#FF7B72">from</span><span style="--shiki-light:#1F2328;--shiki-dark:#E6EDF3"> transformers </span><span style="--shiki-light:#CF222E;--shiki-dark:#FF7B72">import</span><span style="--shiki-light:#1F2328;--shiki-dark:#E6EDF3"> AutoModelForCausalLM</span></span>
<span class="line"></span>
<span class="line"><span style="--shiki-light:#1F2328;--shiki-dark:#E6EDF3">model </span><span style="--shiki-light:#CF222E;--shiki-dark:#FF7B72">=</span><span style="--shiki-light:#1F2328;--shiki-dark:#E6EDF3"> AutoModelForCausalLM.from_pretrained(</span><span style="--shiki-light:#0A3069;--shiki-dark:#A5D6FF">"mistralai/Mistral-7B-v0.1"</span><span style="--shiki-light:#1F2328;--shiki-dark:#E6EDF3">)</span></span></code></pre></div>
<p>:::mystery Unsupported Block</p>
