---
/** Privacy policy for the account-backed Field Guides release. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../content/site';
import '../styles/prose.css';

const updated = 'July 16, 2026';
const sections = [
  ['information', 'Information we handle'],
  ['use', 'How we use it'],
  ['storage', 'Cookies and storage'],
  ['services', 'Services and sharing'],
  ['retention', 'Retention and choices'],
] as const;
---

<BaseLayout
  title="Privacy"
  description="A plain-language explanation of how Data Dreamer handles account, learning, and site data."
  ogImage={{ url: '/og/og-default.png' }}
>
  <div class="privacy container-content">
    <header class="privacy__head">
      <div>
        <p class="kicker">Privacy</p>
        <h1>Clear data practices,<br />without the fine-print maze.</h1>
      </div>
      <p class="privacy__dek">
        Data Dreamer uses the minimum information needed to run learner accounts, remember
        guide progress, and keep the service secure. We do not sell personal data,
        run advertising profiles, or use cross-site tracking.
      </p>
      <p class="privacy__meta">Effective {updated}</p>
    </header>

    <div class="privacy__layout">
      <aside class="privacy__rail" aria-label="Privacy policy sections">
        <p>On this page</p>
        <nav>
          {sections.map(([id, label], index) => (
            <a href={`#${id}`}><span>{String(index + 1).padStart(2, '0')}</span>{label}</a>
          ))}
        </nav>
      </aside>

      <div class="prose privacy__prose">
        <section id="information">
          <p class="privacy__section-number">01</p>
          <h2>Information we handle</h2>
          <p>
            You can browse the site and preview Guides without an account. If
            you create an account, Directus stores your email address, account identifier,
            optional name, authentication details, and account status. Passwords are handled
            by Directus and are not visible to Data Dreamer staff as readable text.
          </p>
          <p>
            When you use a Guide, we store the guide you started, completed resource
            identifiers, your last position, completion percentage, status, and relevant
            timestamps. This is what lets the reader resume across devices.
          </p>
          <p>
            Our infrastructure also creates standard request and security logs. These may
            include an IP address, timestamp, requested URL, referrer, browser user-agent,
            and error details. We use them to operate, protect, and debug the service.
          </p>
        </section>

        <section id="use">
          <p class="privacy__section-number">02</p>
          <h2>How we use it</h2>
          <p>We process this information only to:</p>
          <ul>
            <li>create and secure your account;</li>
            <li>open account-only Guide content;</li>
            <li>save, calculate, and display learning progress;</li>
            <li>respond to support, privacy, or security requests; and</li>
            <li>maintain service reliability and prevent abuse.</li>
          </ul>
          <p>
            We do not use guide progress to make automated decisions about you, and we do
            not sell or rent account information.
          </p>
        </section>

        <section id="storage">
          <p class="privacy__section-number">03</p>
          <h2>Cookies and browser storage</h2>
          <p>
            Signed-in sessions require strictly necessary, HTTP-only authentication cookies.
            Depending on how you sign in, these may include short-lived access and refresh
            credentials or a Directus session token. They are used only to keep you signed in,
            authorize guide access, and sign you out. Blocking them prevents account features
            from working.
          </p>
          <p>
            A <code>theme</code> preference is stored in your browser's local storage so the
            site remembers light or dark mode. It is not used for tracking and can be removed
            through your browser controls.
          </p>
        </section>

        <section id="services">
          <p class="privacy__section-number">04</p>
          <h2>Services and sharing</h2>
          <p>
            Data Dreamer uses self-managed hosting and Directus to deliver content, accounts,
            and progress. Those systems process information only as needed to provide and
            secure the service. Fonts are self-hosted and we do not send visits to an
            advertising or analytics network.
          </p>
          <p>
            When enabled, the optional Orby chat widget is loaded from the separately hosted
            <code>chat.data-dreamer.net</code> service. If you choose to send a chat message,
            the text you submit is sent to that service so it can return a response. Do not
            include sensitive, confidential, or unnecessary personal information in a chat.
            For questions about a chat interaction or a data request, contact us using the
            address below.
          </p>
          <p>
            If you choose “Continue with Google,” Google provides Directus with the basic
            identity details needed to create or locate your account, such as your email and
            profile name. Google's own privacy terms apply to that sign-in interaction. We may
            also disclose information when legally required or when necessary to protect the
            service and its users.
          </p>
          <p>
            Links to third-party resources, GitHub, LinkedIn, and other sites are governed by
            those services after you leave Data Dreamer.
          </p>
        </section>

        <section id="retention">
          <p class="privacy__section-number">05</p>
          <h2>Retention and your choices</h2>
          <p>
            Account and progress records remain while your account is active so the service
            can preserve your learning history. Operational logs are kept only for the period
            needed for security and troubleshooting. Support correspondence is retained as
            needed to resolve the request and maintain an appropriate record.
          </p>
          <p>
            You may ask to access, correct, or delete account information and guide progress.
            Signing out removes active Data Dreamer session cookies from your browser; clearing
            browser storage removes the saved theme preference. Some limited records may be
            retained where required for security, legal compliance, or resolving disputes.
          </p>
        </section>

        <section id="changes">
          <p class="privacy__section-number">06</p>
          <h2>Changes and contact</h2>
          <p>
            We will revise this page when the way Data Dreamer handles information materially
            changes and will update the effective date above.
          </p>
          <p>
            For a privacy request or question, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            or use the <a href="/connect">contact page</a>.
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .privacy {
    padding-block: calc(var(--nav-height) + var(--section-y)) var(--section-y);
  }

  .privacy__head {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-2);
  }

  .privacy__head h1 {
    max-width: 15ch;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .privacy__dek {
    max-width: 48rem;
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .privacy__meta,
  .privacy__rail > p,
  .privacy__section-number {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
  }

  .privacy__layout {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .privacy__rail nav {
    display: grid;
    margin-top: var(--space-3);
    border-top: 1px solid var(--border-1);
  }

  .privacy__rail a {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: var(--space-2);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-1);
    color: var(--text-2);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .privacy__rail a:hover { color: var(--accent); }
  .privacy__rail a span { color: var(--accent); font-family: var(--font-mono); font-size: var(--fs-xs); }

  .privacy__prose {
    max-width: var(--container-prose);
  }

  .privacy__prose section {
    scroll-margin-top: calc(var(--nav-height) + var(--space-6));
  }

  .privacy__prose section + section {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-1);
  }

  .privacy__section-number {
    margin-bottom: var(--space-2);
    color: var(--accent);
  }

  .privacy__prose section h2 {
    margin-top: 0;
  }

  @media (min-width: 64rem) {
    .privacy__head {
      grid-template-columns: minmax(0, 1.1fr) minmax(22rem, 0.9fr);
      align-items: end;
    }

    .privacy__meta { grid-column: 1 / -1; }

    .privacy__layout {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-9);
      align-items: start;
    }

    .privacy__rail {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-6));
    }
  }
</style>
