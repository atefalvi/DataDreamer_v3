---
/**
 * V4-DT-002 — Dream Team (05 §7, 07 §5.3–5.5). SSR SVG "constellation" with a
 * server-computed deterministic layout (DT-001), a specialty legend that doubles as a
 * filter, and the grouped AuthorCard list that is the graph's accessible equivalent and
 * the sole content on small screens. Graph needs zero JS to be usable (real <a> nodes);
 * the enhancer only adds tooltips, dimming, and roving-tabindex.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/dream-team/AuthorCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Icon from '../../components/ui/Icon.astro';
import { authorsRepo } from '../../lib/repositories';
import { computeGraphLayout, GRAPH } from '../../lib/graph/layout';
import { itemListJsonLd, personJsonLd } from '../../lib/seo/jsonld';
import type { AuthorSummary } from '../../types/content';

let authors: AuthorSummary[] = [];
try {
  authors = await authorsRepo.allWithCounts();
} catch (error) {
  console.error('[dream-team] authors unavailable:', error instanceof Error ? error.message : error);
}

// Derive the specialty set + member counts from the authors themselves (no separate
// repo needed). Sorted by member count desc, as the layout expects.
const specialtyMap = new Map<string, { slug: string; name: string; colorKey: string; memberCount: number }>();
for (const author of authors) {
  for (const specialty of author.specialties) {
    const existing = specialtyMap.get(specialty.slug);
    if (existing) existing.memberCount += 1;
    else specialtyMap.set(specialty.slug, { ...specialty, memberCount: 1 });
  }
}
const specialties = [...specialtyMap.values()].sort((a, b) => b.memberCount - a.memberCount);
const colorBySlug = new Map(specialties.map((s) => [s.slug, s.colorKey]));

const authorBySlug = new Map(authors.map((a) => [a.slug, a]));
const showGraph = authors.length >= 2 && specialties.length > 0;

const layout = showGraph
  ? computeGraphLayout(
      specialties.map((s) => ({ id: s.slug, slug: s.slug, memberCount: s.memberCount })),
      authors.map((a) => ({
        id: a.slug,
        specialtyIds: a.specialties.map((s) => s.slug),
        posts: a.postCount,
        guides: a.guideCount,
      })),
    )
  : null;

const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? '')
    .join('');

const graphNodeCount = authors.length + specialties.length;
const graphLinkCount = layout?.edges.length ?? 0;
const sharedSkillCount = specialties.filter((s) => s.memberCount > 1).length;

const jsonLd = [
  itemListJsonLd({
    name: 'DataDreamer Dream Team',
    items: authors.map((author) =>
      personJsonLd({
        name: author.name,
        jobTitle: author.roleTitle,
        url: `/dream-team/${author.slug}`,
        image: author.avatar?.src,
      }),
    ),
  }),
];
---

<BaseLayout
  title="Dream Team"
  description="The data engineers, analysts, AI builders, and creative technologists behind DataDreamer."
  ogImage={{ url: '/og/og-team.png' }}
  jsonLd={jsonLd}
>
  <div class="dt container-wide">
    <header class="dt__head">
      <p class="kicker">The people</p>
      <h1>Dream Team</h1>
      <p class="dt__intro">
        Different fields, one language. Each person below works in their own world — HR, capital
        markets, engineering — but we’re connected by the same thing: <em>data</em>. The pillars are
        the disciplines; the lines are how the work flows between them.
      </p>
    </header>

    {authors.length === 0 ? (
      <EmptyState
        message="The Dream Team graph is waiting for author profiles. The system is ready; the first nodes come next."
        icon="orbit"
        action={{ label: 'Get in touch', href: '/connect' }}
      />
    ) : (
      <>
        {showGraph && layout && (
          <section class="dt-stage" aria-label="Interactive Dream Team network" data-team-network>
            <span class="dt-stage__bg" aria-hidden="true"></span>
            <div class="dt-stage__panel dt-inspector" aria-live="polite" data-team-inspector>
              <div class="dt-panel__head">
                <div>
                  <p class="kicker">Network map</p>
                  <h2 data-team-inspector-title>Select a node</h2>
                </div>
                <button class="dt-help" type="button" aria-label="Network interaction help">
                  <Icon name="circle-help" size={16} />
                  <span>Search, select, or drag nodes. Reset returns the original layout.</span>
                </button>
              </div>

              <p class="dt-panel__summary" data-team-inspector-summary>Select a node for details.</p>

              <label class="dt-search" for="team-search">
                <span>Search network</span>
                <input id="team-search" type="search" placeholder="Search people or skills" data-team-search />
              </label>

              <div class="dt-actions" aria-label="Network actions">
                <button type="button" data-team-reset-layout>Reset layout</button>
                <button type="button" data-team-clear-selection>Clear selection</button>
              </div>

              <div class="dt-inspector__meta" data-team-inspector-meta>
                <span>{authors.length} people</span>
                <span>{specialties.length} skills</span>
                <span>{sharedSkillCount} shared</span>
                <span>{graphLinkCount} links</span>
              </div>
            </div>

            <div class="dt-stage__canvas">
              <div class="dt-stage__topline" aria-hidden="true">
                <span>{graphNodeCount} nodes</span>
                <span>{graphLinkCount} links</span>
                <span>radial graph</span>
              </div>
              <svg
                class="tg"
                viewBox={`0 0 ${layout.width} ${layout.height}`}
                role="group"
                aria-label="Interactive team network; the list below contains the same people"
                data-team-graph
              >
                <defs>
                  <radialGradient id="tg-core" cx="50%" cy="50%" r="50%">
                    <stop offset="0" stop-color="var(--accent)" stop-opacity="0.38" />
                    <stop offset="0.55" stop-color="var(--accent)" stop-opacity="0.08" />
                    <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
                  </radialGradient>
                  {layout.authorNodes.map((node) => {
                    const author = authorBySlug.get(node.id);
                    if (!author?.avatar?.src) return null;
                    return (
                      <clipPath id={`clip-${node.id}`}>
                        <circle cx="0" cy="0" r={node.r - 3} />
                      </clipPath>
                    );
                  })}
                </defs>

                <ellipse class="tg-orbit tg-orbit--outer" cx={GRAPH.cx} cy={GRAPH.cy} rx={GRAPH.rx} ry={GRAPH.ry} />
                <ellipse class="tg-orbit tg-orbit--inner" cx={GRAPH.cx} cy={GRAPH.cy} rx={GRAPH.rx * 0.58} ry={GRAPH.ry * 0.54} />
                <circle class="tg-core" cx={GRAPH.cx} cy={GRAPH.cy} r="176" fill="url(#tg-core)" />

                <g class="tg-links">
                  {layout.edges.map((edge) => {
                    const specialty = specialtyMap.get(edge.specialtyId);
                    const flowColor = colorBySlug.get(edge.specialtyId) ?? 'accent';
                    const d = `M ${edge.x1} ${edge.y1} Q ${edge.cx} ${edge.cy} ${edge.x2} ${edge.y2}`;
                    return (
                      <g
                        class="tg-link-group"
                        data-source={edge.authorId}
                        data-target={edge.specialtyId}
                        data-kind={specialty && specialty.memberCount > 1 ? 'shared' : 'has'}
                        style={`--node-flow: var(--${flowColor});`}
                      >
                        <path class="tg-link" d={d} />
                        <path class="tg-link-flow" d={d} />
                      </g>
                    );
                  })}
                </g>

                <g class="tg-nodes">
                  {layout.specialtyAnchors.map((anchor, i) => {
                    const specialty = specialtyMap.get(anchor.id);
                    if (!specialty) return null;
                    const color = colorBySlug.get(anchor.id) ?? 'accent';
                    const r = specialty.memberCount > 1 ? 21 : 17;
                    const type = specialty.memberCount > 1 ? 'shared skill' : 'skill';
                    return (
                      <g
                        class:list={['tg-node', 'tg-node--skill', { 'tg-node--shared': specialty.memberCount > 1 }]}
                        data-id={specialty.slug}
                        data-type={type}
                        data-label={specialty.name}
                        data-search={`${specialty.name} ${type}`}
                        data-x={anchor.x}
                        data-y={anchor.y}
                        data-home-x={anchor.x}
                        data-home-y={anchor.y}
                        data-r={r}
                        tabindex={i === 0 ? 0 : -1}
                        role="button"
                        aria-label={`${specialty.name}, ${type}`}
                        style={`--node-color: var(--${color});`}
                        transform={`translate(${anchor.x} ${anchor.y})`}
                      >
                        <circle class="tg-node-halo" cx="0" cy="0" r={r + 8} />
                        <circle class="tg-node-core" cx="0" cy="0" r={r} />
                        <text class="tg-node-label tg-node-label--skill" x="0" y={r + 17} text-anchor="middle">
                          {specialty.name}
                        </text>
                      </g>
                    );
                  })}

                  {layout.authorNodes.map((node, i) => {
                    const author = authorBySlug.get(node.id);
                    if (!author) return null;
                    const color = colorBySlug.get(author.specialties[0]?.slug ?? '') ?? 'accent';
                    const r = node.r + 8;
                    return (
                      <g
                        class="tg-node tg-node--person"
                        data-id={author.slug}
                        data-type="person"
                        data-label={author.name}
                        data-role={author.roleTitle}
                        data-href={`/dream-team/${author.slug}`}
                        data-specialties={author.specialties.map((s) => s.name).join(', ')}
                        data-posts={author.postCount}
                        data-guides={author.guideCount}
                        data-search={`${author.name} ${author.roleTitle} ${author.specialties.map((s) => s.name).join(' ')}`}
                        data-x={node.x}
                        data-y={node.y}
                        data-home-x={node.x}
                        data-home-y={node.y}
                        data-r={r}
                        tabindex={specialties.length === 0 && i === 0 ? 0 : -1}
                        role="link"
                        aria-label={`${author.name}, ${author.roleTitle}`}
                        style={`--node-color: var(--${color});`}
                        transform={`translate(${node.x} ${node.y})`}
                      >
                        <circle class="tg-node-halo" cx="0" cy="0" r={r + 7} />
                        <circle class="tg-node-core" cx="0" cy="0" r={r} />
                        {author.avatar?.src ? (
                          <image
                            href={author.avatar.src}
                            x={-(r - 4)}
                            y={-(r - 4)}
                            width={(r - 4) * 2}
                            height={(r - 4) * 2}
                            clip-path={`url(#clip-${author.slug})`}
                            preserveAspectRatio="xMidYMid slice"
                          />
                        ) : (
                          <text class="tg-node-initials" x="0" y="0" text-anchor="middle" dominant-baseline="central">
                            {initialsOf(author.name)}
                          </text>
                        )}
                        <text class="tg-node-label tg-node-label--person" x="0" y={r + 18} text-anchor="middle">
                          {author.name.split(/\s+/)[0]}
                        </text>
                      </g>
                    );
                  })}
                </g>
              </svg>
            </div>
          </section>
        )}

        <section class="dt-list" aria-label="Everyone">
          <p class="kicker">Everyone</p>
          <div class="dt-list__grid">
            {authors.map((author) => <AuthorCard author={author} />)}
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>

<style>
  .dt {
    padding-block: calc(var(--nav-height) + var(--section-y)) var(--section-y);
  }

  .dt__head h1 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .dt__intro {
    max-width: 60ch;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  /* Interactive graph stage. Uses the existing Observatory palette, but follows the
     prototype's editorial radial interaction model: search, inspect, drag, reset. */
  .dt-stage {
    position: relative;
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding: clamp(var(--space-4), 2vw, var(--space-6));
    overflow: hidden;
    isolation: isolate;
    border: 1px solid color-mix(in srgb, var(--border-2) 64%, transparent);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(48rem 28rem at 20% 6%, color-mix(in srgb, var(--viz-2) 12%, transparent), transparent 72%),
      radial-gradient(40rem 26rem at 84% 22%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
      linear-gradient(150deg, color-mix(in srgb, var(--bg-2) 48%, transparent), color-mix(in srgb, var(--bg-1) 94%, transparent));
    box-shadow: var(--shadow-2);
  }

  @media (min-width: 64rem) {
    .dt-stage {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 21rem);
      align-items: stretch;
    }

    .dt-stage__canvas {
      grid-column: 1;
      grid-row: 1;
    }

    .dt-stage__panel {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .dt-stage__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(58% 58% at 50% 48%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%),
      linear-gradient(90deg, color-mix(in srgb, var(--border-1) 52%, transparent) 1px, transparent 1px),
      linear-gradient(180deg, color-mix(in srgb, var(--border-1) 36%, transparent) 1px, transparent 1px);
    background-size: 100% 100%, 56px 56px, 56px 56px;
    mask-image: radial-gradient(78% 78% at 50% 48%, #000, transparent 90%);
    opacity: 0.6;
  }

  .dt-stage__panel,
  .dt-inspector {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: start;
    gap: var(--space-5);
    padding: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--text-1) 9%, transparent);
    border-radius: var(--radius-md);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--text-1) 5%, transparent), transparent 36%),
      color-mix(in srgb, var(--bg-1) 62%, transparent);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
  }

  .dt-panel__head {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    justify-content: space-between;
  }

  .dt-panel__head h2,
  .dt-inspector h2 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(var(--fs-xl), 2.2vw, var(--fs-2xl));
    line-height: var(--lh-xl);
    font-weight: 620;
    letter-spacing: 0;
  }

  .dt-panel__summary,
  .dt-inspector p:not(.kicker) {
    margin: 0;
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
  }

  .dt-help {
    position: relative;
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--border-2) 66%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-0) 36%, transparent);
    color: var(--text-3);
    cursor: help;
  }

  .dt-help span {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    z-index: 3;
    width: min(16rem, 70vw);
    padding: var(--space-3);
    border: 1px solid color-mix(in srgb, var(--border-2) 76%, transparent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-0) 92%, transparent);
    color: var(--text-2);
    font-size: var(--fs-xs);
    line-height: var(--lh-xs);
    text-align: left;
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
    box-shadow: var(--shadow-2);
  }

  .dt-help:hover,
  .dt-help:focus-visible {
    color: var(--text-1);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border-2));
    outline: none;
  }

  .dt-help:hover span,
  .dt-help:focus-visible span {
    opacity: 1;
    transform: translateY(0);
  }

  .dt-search {
    display: grid;
    gap: var(--space-2);
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 650;
    text-transform: uppercase;
  }

  .dt-search input {
    min-width: 0;
    min-height: 2.75rem;
    padding-inline: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--border-2) 68%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-0) 46%, transparent);
    color: var(--text-1);
    font-family: var(--font-text);
    font-size: var(--fs-sm);
    text-transform: none;
    outline: none;
  }

  .dt-search input:focus-visible {
    border-color: var(--focus-ring);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 18%, transparent);
  }

  .dt-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .dt-actions button {
    min-height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--border-2) 70%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-2) 48%, transparent);
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: 620;
    cursor: pointer;
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .dt-actions button:hover {
    color: var(--text-1);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border-2));
    background: color-mix(in srgb, var(--accent) 11%, var(--bg-2));
    transform: translateY(-1px);
  }

  .dt-stage__canvas {
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text-1) 9%, transparent);
    border-radius: var(--radius-md);
    background:
      radial-gradient(38rem 24rem at 50% 50%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 72%),
      radial-gradient(30rem 22rem at 22% 18%, color-mix(in srgb, var(--viz-2) 8%, transparent), transparent 70%),
      color-mix(in srgb, var(--bg-0) 74%, transparent);
    backdrop-filter: blur(12px) saturate(130%);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
  }

  .dt-stage__topline {
    position: absolute;
    inset: var(--space-4) var(--space-4) auto;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    pointer-events: none;
  }

  .dt-stage__topline span {
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--border-1) 70%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-0) 48%, transparent);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .tg {
    width: 100%;
    height: clamp(30rem, 62vh, 48rem);
    min-height: 30rem;
    overflow: visible;
    touch-action: none;
    user-select: none;
  }

  .tg-orbit {
    fill: none;
    stroke: color-mix(in srgb, var(--border-2) 85%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 10;
    opacity: 0.4;
    animation: tg-ring-march 50s linear infinite;
  }

  .tg-orbit--inner {
    opacity: 0.22;
    stroke-dasharray: 2 12;
  }

  .tg-core {
    transform-box: fill-box;
    transform-origin: center;
    animation: tg-core-pulse 7s var(--ease-in-out) infinite;
  }

  .tg-link {
    fill: none;
    stroke: var(--border-2);
    stroke-width: 1;
    opacity: 0.42;
    transition: opacity var(--dur-2) var(--ease-out), stroke var(--dur-2) var(--ease-out);
  }

  .tg-link-flow {
    fill: none;
    stroke: var(--node-flow, var(--accent));
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-dasharray: 1.5 15;
    opacity: 0.42;
    animation: tg-flow 2.6s linear infinite;
  }

  .tg.is-focused .tg-link-group:not(.is-lit),
  .tg.is-searching .tg-link-group:not(.is-lit) {
    opacity: 0.1;
  }

  .tg-link-group.is-lit .tg-link {
    stroke: var(--accent);
    opacity: 0.86;
  }

  .tg-link-group.is-lit .tg-link-flow {
    opacity: 1;
    stroke-width: 2.4;
  }

  .tg-node {
    cursor: grab;
    touch-action: none;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .tg-node.is-dragging {
    cursor: grabbing;
  }

  .tg-node-halo {
    fill: none;
    stroke: color-mix(in srgb, var(--node-color) 34%, transparent);
    stroke-width: 1;
    opacity: 0.34;
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
  }

  .tg-node-core {
    fill: color-mix(in srgb, var(--node-color) 15%, var(--bg-1));
    stroke: color-mix(in srgb, var(--node-color) 72%, var(--border-2));
    stroke-width: 1.4;
    transition:
      stroke var(--dur-2) var(--ease-out),
      fill var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
  }

  .tg-node--person .tg-node-core {
    fill: color-mix(in srgb, var(--bg-0) 82%, var(--node-color));
    stroke: color-mix(in srgb, var(--node-color) 76%, var(--text-1));
    stroke-width: 1.7;
  }

  .tg-node--shared .tg-node-core {
    fill: color-mix(in srgb, var(--accent) 13%, var(--bg-1));
    stroke: color-mix(in srgb, var(--accent) 68%, var(--text-1));
    stroke-width: 1.7;
  }

  .tg-node image {
    pointer-events: none;
  }

  .tg-node-initials {
    fill: var(--text-1);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .tg-node-label {
    fill: var(--text-2);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 560;
