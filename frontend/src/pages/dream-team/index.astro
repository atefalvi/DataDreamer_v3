---
/**
 * V4-DT-002 — Dream Team (05 §7, 07 §5.3–5.5). SSR SVG "constellation" with a
 * server-computed deterministic layout (DT-001), a specialty legend that doubles as a
 * filter, and the grouped AuthorCard list that is the graph's accessible equivalent and
 * the sole content on small screens. Graph needs zero JS to be usable (real <a> nodes);
 * the enhancer only adds tooltips, dimming, and roving-tabindex.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/dream-team/AuthorCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { authorsRepo } from '../../lib/repositories';
import { computeGraphLayout, GRAPH } from '../../lib/graph/layout';
import { itemListJsonLd, personJsonLd } from '../../lib/seo/jsonld';
import type { AuthorSummary } from '../../types/content';

let authors: AuthorSummary[] = [];
try {
  authors = await authorsRepo.allWithCounts();
} catch (error) {
  console.error('[dream-team] authors unavailable:', error instanceof Error ? error.message : error);
}

// Derive the specialty set + member counts from the authors themselves (no separate
// repo needed). Sorted by member count desc, as the layout expects.
const specialtyMap = new Map<string, { slug: string; name: string; colorKey: string; memberCount: number }>();
for (const author of authors) {
  for (const specialty of author.specialties) {
    const existing = specialtyMap.get(specialty.slug);
    if (existing) existing.memberCount += 1;
    else specialtyMap.set(specialty.slug, { ...specialty, memberCount: 1 });
  }
}
const specialties = [...specialtyMap.values()].sort((a, b) => b.memberCount - a.memberCount);
const colorBySlug = new Map(specialties.map((s) => [s.slug, s.colorKey]));

const authorBySlug = new Map(authors.map((a) => [a.slug, a]));
const showGraph = authors.length >= 2 && specialties.length > 0;

const layout = showGraph
  ? computeGraphLayout(
      specialties.map((s) => ({ id: s.slug, slug: s.slug, memberCount: s.memberCount })),
      authors.map((a) => ({
        id: a.slug,
        specialtyIds: a.specialties.map((s) => s.slug),
        posts: a.postCount,
        courses: a.courseCount,
      })),
    )
  : null;

const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase() ?? '')
    .join('');

const jsonLd = [
  itemListJsonLd({
    name: 'DataDreamer Dream Team',
    items: authors.map((author) =>
      personJsonLd({
        name: author.name,
        jobTitle: author.roleTitle,
        url: `/dream-team/${author.slug}`,
        image: author.avatar?.src,
      }),
    ),
  }),
];
---

<BaseLayout
  title="Dream Team"
  description="The data engineers, analysts, AI builders, and creative technologists behind DataDreamer."
  ogImage={{ url: '/og/og-team.png' }}
  jsonLd={jsonLd}
>
  <div class="dt container-wide">
    <header class="dt__head">
      <p class="kicker">The people</p>
      <h1>Dream Team</h1>
      <p class="dt__intro">
        Different fields, one language. Each person below works in their own world — HR, capital
        markets, engineering — but we’re connected by the same thing: <em>data</em>. The pillars are
        the disciplines; the lines are how the work flows between them.
      </p>
    </header>

    {authors.length === 0 ? (
      <EmptyState
        message="The Dream Team graph is waiting for author profiles. The system is ready; the first nodes come next."
        icon="orbit"
        action={{ label: 'Get in touch', href: '/connect' }}
      />
    ) : (
      <>
        {showGraph && layout && (
          <section class="dt-stage" aria-hidden="false">
            <span class="dt-stage__bg" aria-hidden="true"></span>
            <svg
              class="tg"
              viewBox={`0 0 ${layout.width} ${layout.height}`}
              role="group"
              aria-label="Team constellation; the list below contains the same people"
              data-team-graph
            >
              <defs>
                <radialGradient id="tg-core" cx="50%" cy="50%" r="50%">
                  <stop offset="0" stop-color="var(--accent)" stop-opacity="0.5" />
                  <stop offset="0.6" stop-color="var(--accent)" stop-opacity="0.08" />
                  <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
                </radialGradient>
                {layout.authorNodes.map((node) => {
                  const author = authorBySlug.get(node.id);
                  if (!author?.avatar?.src) return null;
                  return (
                    <clipPath id={`clip-${node.id}`}>
                      <circle cx={node.x} cy={node.y} r={node.r - 2} />
                    </clipPath>
                  );
                })}
              </defs>

              {/* Shared "pillar ring" the disciplines sit on + a faint data core. */}
              <ellipse
                class="tg-ring"
                cx={GRAPH.cx}
                cy={GRAPH.cy}
                rx={GRAPH.rx}
                ry={GRAPH.ry}
              />
              <circle class="tg-core" cx={GRAPH.cx} cy={GRAPH.cy} r="170" fill="url(#tg-core)" />

              <g class="tg-edges">
                {layout.edges.map((edge) => {
                  const flowColor = colorBySlug.get(edge.specialtyId) ?? 'accent';
                  const d = `M ${edge.x1} ${edge.y1} Q ${edge.cx} ${edge.cy} ${edge.x2} ${edge.y2}`;
                  return (
                    <g
                      class="tg-edge-group"
                      data-author={edge.authorId}
                      data-specialty={edge.specialtyId}
                      style={`--node-flow: var(--${flowColor});`}
                    >
                      <path class="tg-edge" d={d} />
                      <path class="tg-edge-flow" d={d} />
                    </g>
                  );
                })}
              </g>

              <g class="tg-anchors">
                {layout.specialtyAnchors.map((anchor) => {
                  const specialty = specialtyMap.get(anchor.id);
                  const color = colorBySlug.get(anchor.id) ?? 'accent';
                  return (
                    <g
                      class="tg-anchor"
                      data-specialty={anchor.id}
                      data-anchor-x={anchor.x}
                      data-anchor-y={anchor.y}
                      data-label-x={anchor.labelX}
                      data-label-y={anchor.labelY}
                      style={`--anchor-color: var(--${color});`}
                    >
                      <circle class="tg-anchor-dot" cx={anchor.x} cy={anchor.y} r="5" />
                      <text class="tg-anchor-label" x={anchor.labelX} y={anchor.labelY} text-anchor={anchor.labelAnchor}>
                        {specialty?.name ?? anchor.id}
                      </text>
                    </g>
                  );
                })}
              </g>

              <g class="tg-nodes">
                {layout.authorNodes.map((node, i) => {
                  const author = authorBySlug.get(node.id);
                  if (!author) return null;
                  const color = colorBySlug.get(author.specialties[0]?.slug ?? '') ?? 'accent';
                  const r = node.r;
                  return (
                    <a
                      href={`/dream-team/${author.slug}`}
                      class="tg-node"
                      data-author={author.slug}
                      data-specialties={author.specialties.map((s) => s.slug).join(',')}
                      data-name={author.name}
                      data-role={author.roleTitle}
                      data-posts={author.postCount}
                      data-courses={author.courseCount}
                      data-x={node.x}
                      data-y={node.y}
                      data-r={r}
                      tabindex={i === 0 ? 0 : -1}
                      aria-label={`${author.name}, ${author.roleTitle}`}
                      style={`--node-color: var(--${color});`}
                    >
                      <circle class="tg-node-ring" cx={node.x} cy={node.y} r={r} />
                      {author.avatar?.src ? (
                        <image
                          href={author.avatar.src}
                          x={node.x - (r - 2)}
                          y={node.y - (r - 2)}
                          width={(r - 2) * 2}
                          height={(r - 2) * 2}
                          clip-path={`url(#clip-${author.slug})`}
                          preserveAspectRatio="xMidYMid slice"
                        />
                      ) : (
                        <text class="tg-node-initials" x={node.x} y={node.y} text-anchor="middle" dominant-baseline="central">
                          {initialsOf(author.name)}
                        </text>
                      )}
                      <text class="tg-node-name" x={node.x} y={node.y + r + 15} text-anchor="middle">
                        {author.name.split(/\s+/)[0]}
                      </text>
                    </a>
                  );
                })}
              </g>
            </svg>

            <ul class="dt-legend" aria-label="Filter by specialty" data-team-legend>
              {specialties.map((s) => (
                <li>
                  <button
                    type="button"
                    class="dt-legend__chip"
                    data-specialty={s.slug}
                    aria-pressed="false"
                    style={`--chip-color: var(--${s.colorKey});`}
                  >
                    <span class="dt-legend__dot" aria-hidden="true"></span>
                    {s.name}
                    <span class="dt-legend__count">{s.memberCount}</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="dt-list" aria-label="Everyone">
          <p class="kicker">Everyone</p>
          <div class="dt-list__grid">
            {authors.map((author) => <AuthorCard author={author} />)}
          </div>
        </section>
      </>
    )}
  </div>

  <div class="tg-tooltip" data-team-tooltip hidden aria-hidden="true"></div>
</BaseLayout>

<style>
  .dt {
    padding-block: calc(var(--nav-height) + var(--section-y)) var(--section-y);
  }

  .dt__head h1 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .dt__intro {
    max-width: 60ch;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  /* Graph stage — TL+ only (07 §5; on smaller screens the list is the page).
     Sits in an ambient "observatory" field; the graph is subtly alive. */
  .dt-stage {
    display: none;
  }

  @media (min-width: 64rem) {
    .dt-stage {
      position: relative;
      display: block;
      margin-top: var(--space-7);
      padding: var(--space-6);
      overflow: hidden;
      isolation: isolate;
      border: 1px solid color-mix(in srgb, var(--border-2) 64%, transparent);
      border-radius: var(--radius-lg);
      background:
        radial-gradient(circle at 18% 8%, color-mix(in srgb, var(--viz-2) 10%, transparent), transparent 28rem),
        linear-gradient(160deg, color-mix(in srgb, var(--bg-2) 55%, transparent), var(--bg-1));
      box-shadow: var(--shadow-2);
    }
  }

  .dt-stage__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(58% 58% at 50% 48%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%),
      linear-gradient(90deg, color-mix(in srgb, var(--border-1) 52%, transparent) 1px, transparent 1px),
      linear-gradient(180deg, color-mix(in srgb, var(--border-1) 36%, transparent) 1px, transparent 1px);
    background-size: 100% 100%, 56px 56px, 56px 56px;
    mask-image: radial-gradient(78% 78% at 50% 48%, #000, transparent 90%);
    opacity: 0.6;
  }

  .tg {
    width: 100%;
    height: min(78vh, 820px);
    min-height: 660px;
    overflow: visible;
    touch-action: none;
  }

  /* Shared pillar ring (disciplines sit on it) + breathing data core. */
  .tg-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--border-2) 85%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 8;
    opacity: 0.45;
    animation: tg-ring-march 50s linear infinite;
  }

  .tg-core {
    transform-box: fill-box;
    transform-origin: center;
    animation: tg-core-pulse 7s var(--ease-in-out) infinite;
  }

  /* Edges + the data flowing along them. */
  .tg-edge {
    fill: none;
    stroke: var(--border-2);
    stroke-width: 1;
    opacity: 0.5;
    transition: opacity var(--dur-2) var(--ease-out), stroke var(--dur-2) var(--ease-out);
  }

  .tg-edge-flow {
    fill: none;
    stroke: var(--node-flow, var(--accent));
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1.5 15;
    opacity: 0.5;
    animation: tg-flow 2.6s linear infinite;
  }

  .tg.has-focus .tg-edge-group:not(.is-lit) {
    opacity: 0.12;
  }

  .tg-edge-group.is-lit .tg-edge {
    stroke: var(--accent);
    opacity: 0.85;
  }

  .tg-edge-group.is-lit .tg-edge-flow {
    opacity: 1;
    stroke-width: 2.5;
  }

  .tg-anchor-dot {
    fill: var(--anchor-color);
    transform-box: fill-box;
    transform-origin: center;
    animation: tg-anchor-pulse 4.5s var(--ease-in-out) infinite;
  }

  .tg-anchor-label {
    fill: var(--text-2);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .tg-node {
    cursor: grab;
    touch-action: none;
  }

  .tg-node.is-dragging {
    cursor: grabbing;
  }

  .tg-node.is-dragging .tg-node-ring {
    transform: scale(1.14);
    animation: none;
  }

  .tg-node-ring {
    fill: var(--bg-2);
    stroke: var(--node-color);
    stroke-width: 2;
    transition: transform var(--dur-2) var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
    animation: tg-breathe 6s var(--ease-in-out) infinite;
  }

  .tg-node-initials {
    fill: var(--text-1);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .tg-node-name {
    fill: var(--text-2);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 560;
  }

  .tg-node:hover .tg-node-ring,
  .tg-node:focus-visible .tg-node-ring,
  .tg-node.is-active .tg-node-ring {
    transform: scale(1.1);
    animation: none;
  }

  .tg-node:focus-visible {
    outline: none;
  }

  .tg-node:focus-visible .tg-node-ring {
    stroke: var(--focus-ring);
    stroke-width: 3;
  }

  .tg.has-focus .tg-node:not(.is-active) {
    opacity: 0.4;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .tg.is-filtered .tg-node.is-dimmed {
    opacity: 0.18;
  }

  @keyframes tg-flow {
    to {
      stroke-dashoffset: -16.5;
    }
  }

  @keyframes tg-ring-march {
    to {
      stroke-dashoffset: -200;
    }
  }

  @keyframes tg-breathe {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  @keyframes tg-anchor-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.55);
      opacity: 0.55;
    }
  }

  @keyframes tg-core-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.12);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tg-node-ring,
    .tg-edge,
    .tg-node,
    .tg-ring,
    .tg-core,
    .tg-anchor-dot {
      animation: none;
      transition: none;
    }
    .tg-edge-flow {
      display: none;
    }
  }

  /* Legend / filters. */
  .dt-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .dt-legend__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-full);
    background: var(--bg-1);
    color: var(--text-2);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
  }

  .dt-legend__chip:hover {
    color: var(--text-1);
    border-color: var(--border-2);
  }

  .dt-legend__chip[aria-pressed='true'] {
    color: var(--text-1);
    border-color: var(--chip-color);
    background: color-mix(in srgb, var(--chip-color) 12%, var(--bg-1));
  }

  .dt-legend__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--chip-color);
  }

  .dt-legend__count {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  /* Member list. */
  .dt-list {
    margin-top: var(--section-y);
    padding-top: var(--space-7);
    border-top: 1px solid color-mix(in srgb, var(--border-2) 62%, transparent);
  }

  .dt-list__group {
    margin-top: var(--space-7);
  }

  .dt-list__group-title {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-1);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-1);
    box-shadow: inset 0 -2px 0 var(--group-color, var(--accent));
    width: fit-content;
  }

  .dt-list__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 63.999rem) {
    .dt-list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 41.999rem) {
    .dt-list__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Tooltip (enhancer-driven). */
  .tg-tooltip {
    position: fixed;
    z-index: 50;
    max-width: 16rem;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-1) 96%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-2);
    pointer-events: none;
    font-size: var(--fs-sm);
  }

  .tg-tooltip[hidden] {
    display: none;
  }

  .tg-tooltip strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-base);
  }

  .tg-tooltip span {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
</style>

<script>
  import { initTeamGraph } from '../../lib/graph/enhancer';
  initTeamGraph();
</script>
