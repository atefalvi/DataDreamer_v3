---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/dream-team/AuthorCard.astro';
import Avatar from '../../components/ui/Avatar.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { authorsRepo } from '../../lib/repositories';
import { computeGraphLayout } from '../../lib/graph/layout';
import { itemListJsonLd, personJsonLd } from '../../lib/seo/jsonld';
import type { AuthorSummary } from '../../types/content';

let authors: AuthorSummary[] = [];
try {
  authors = await authorsRepo.allWithCounts(Astro.locals);
} catch (error) {
  console.error('[dream-team] authors unavailable:', error instanceof Error ? error.message : error);
}

type NetworkSpecialty = {
  slug: string;
  name: string;
  colorKey: string;
  memberCount: number;
};

const specialtyMap = new Map<string, NetworkSpecialty>();
for (const author of authors) {
  for (const specialty of author.specialties) {
    const existing = specialtyMap.get(specialty.slug);
    if (existing) existing.memberCount += 1;
    else specialtyMap.set(specialty.slug, { ...specialty, memberCount: 1 });
  }
}

const specialties = [...specialtyMap.values()].sort(
  (a, b) => b.memberCount - a.memberCount || a.name.localeCompare(b.name),
);
const sharedSpecialties = specialties.filter((specialty) => specialty.memberCount > 1);
// The visual is intentionally about common ground. Unique specialties remain visible
// in member profiles and cards without adding one-ended branches to the network.
const graphSpecialties = sharedSpecialties.length > 0 ? sharedSpecialties : specialties;
const graphSpecialtyIds = new Set(graphSpecialties.map((specialty) => specialty.slug));
const authorBySlug = new Map(authors.map((author) => [author.slug, author]));
const authorsBySpecialty = new Map(
  graphSpecialties.map((specialty) => [
    specialty.slug,
    authors.filter((author) => author.specialties.some((item) => item.slug === specialty.slug)),
  ]),
);

const showGraph = authors.length >= 2 && graphSpecialties.length > 0;
const layout = showGraph
  ? computeGraphLayout(
      graphSpecialties.map((specialty) => ({
        id: specialty.slug,
        slug: specialty.slug,
        label: specialty.name,
        memberCount: specialty.memberCount,
      })),
      authors.map((author) => ({
        id: author.slug,
        specialtyIds: author.specialties
          .map((specialty) => specialty.slug)
          .filter((slug) => graphSpecialtyIds.has(slug)),
        posts: author.postCount,
        guides: author.guideCount,
      })),
    )
  : null;

const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase() ?? '')
    .join('');

const graphNameOf = (name: string) => {
  const parts = name.trim().split(/\s+/);
  return parts.length > 1 ? `${parts[0]} ${parts.at(-1)?.[0] ?? ''}.` : parts[0];
};

const colorValue = (colorKey: string) =>
  /^[a-z0-9-]+$/i.test(colorKey) ? `var(--${colorKey})` : 'var(--accent)';

const graphLinkCount = layout?.edges.length ?? 0;
const sharedSkillCount = sharedSpecialties.length;

const jsonLd = [
  itemListJsonLd({
    name: 'Data Dreamer Dream Team',
    items: authors.map((author) =>
      personJsonLd({
        name: author.name,
        jobTitle: author.roleTitle,
        url: `/dream-team/${author.slug}`,
        image: author.avatar?.src,
      }),
    ),
  }),
];
---

<BaseLayout
  title="Dream Team"
  description="Meet people across industries and departments through the data skills and problems they share."
  ogImage={{ url: '/og/og-team.png' }}
  jsonLd={jsonLd}
>
  <!--
    THESIS: Different careers share a common data language; this page refuses a control-heavy graph workspace.
    OWN-WORLD: Data Dreamer's ink-dark editorial field, warm signal orange, Fraunces display type, fine rules, and direct labels.
    STORY: Meet the people, trace a shared capability, then open a profile to see that skill in context.
    FIRST VIEWPORT: A split editorial statement leads directly into a people-around-capabilities constellation.
    FORM: Grounded structure 5, a common-ground field staged as a single readable artifact; concept seed 1aa50aa8.
  -->
  <div class="dt container-wide">
    <header class="dt-hero">
      <div class="dt-hero__copy">
        <p class="kicker">Dream Team</p>
        <h1>Different worlds.<span>Shared data.</span></h1>
        <p class="dt-hero__intro">
          People work in different industries, functions, and departments. The questions change.
          The underlying data skills travel with us.
        </p>
      </div>

      <aside class="dt-hero__note" aria-label="The Dream Team idea">
        <p>
          This is a living map of that common ground—where analytics, automation, modelling,
          communication, and other data practices connect people who might otherwise look unrelated.
        </p>
        {authors.length > 0 && (
          <dl>
            <div>
              <dt>{authors.length}</dt>
              <dd>{authors.length === 1 ? 'person' : 'people'}</dd>
            </div>
            <div>
              <dt>{sharedSkillCount}</dt>
              <dd>shared {sharedSkillCount === 1 ? 'capability' : 'capabilities'}</dd>
            </div>
            <div>
              <dt>{graphLinkCount}</dt>
              <dd>points of connection</dd>
            </div>
          </dl>
        )}
      </aside>
    </header>

    {authors.length === 0 ? (
      <EmptyState
        message="Dream Team profiles will appear here as the network grows."
        icon="orbit"
        action={{ label: 'Get in touch', href: '/connect' }}
      />
    ) : (
      <>
        {showGraph && layout && (
          <section
            class="dt-network"
            aria-labelledby="network-title"
            data-team-network
            data-default-title="Showing every shared connection"
          >
            <header class="dt-network__head">
              <div class="dt-network__title">
                <p>The data commons</p>
                <h2 id="network-title">Trace the common ground.</h2>
                <p>
                  Choose a shared capability or a person to see the paths that connect them.
                </p>
              </div>
              <output class="dt-network__status" data-network-status aria-live="polite">
                Showing every shared connection
              </output>
            </header>

            <div class="dt-filters" aria-label="Filter the network by shared capability">
              <button type="button" class="is-active" data-network-filter="" aria-pressed="true">
                All connections
              </button>
              {graphSpecialties.map((specialty) => (
                <button
                  type="button"
                  data-network-filter={specialty.slug}
                  aria-pressed="false"
                  style={`--node-color: ${colorValue(specialty.colorKey)};`}
                >
                  <span aria-hidden="true"></span>
                  {specialty.name}
                  <small>{specialty.memberCount}</small>
                </button>
              ))}
            </div>

            <div class="dt-network__body">
              <div class="dt-graph-wrap">
                <svg
                  class="dt-graph"
                  viewBox={`0 0 ${layout.width} ${layout.height}`}
                  role="group"
                  aria-labelledby="network-title network-description"
                  data-team-graph
                >
                  <desc id="network-description">
                    Dream Team members appear around shared data capabilities. Curved lines connect
                    each person to the capabilities they share with others. The member list below
                    contains the same people and details.
                  </desc>
                  <defs>
                    {layout.authorNodes.map((node) => {
                      const author = authorBySlug.get(node.id);
                      if (!author?.avatar?.src) return null;
                      return (
                        <clipPath id={`clip-${node.id}`}>
                          <circle cx="0" cy="0" r={node.r - 3} />
                        </clipPath>
                      );
                    })}
                  </defs>

                  <g class="dt-graph__links" aria-hidden="true">
                    {layout.edges.map((edge) => {
                      const specialty = specialtyMap.get(edge.specialtyId);
                      const d = `M ${edge.x1} ${edge.y1} C ${edge.c1x} ${edge.c1y} ${edge.c2x} ${edge.c2y} ${edge.x2} ${edge.y2}`;
                      return (
                        <path
                          class="dt-graph__link"
                          d={d}
                          data-network-link
                          data-source={edge.authorId}
                          data-target={edge.specialtyId}
                          style={`--node-color: ${colorValue(specialty?.colorKey ?? 'accent')};`}
                        />
                      );
                    })}
                  </g>

                  <g class="dt-graph__skills">
                    {layout.specialtyAnchors.map((anchor) => {
                      const specialty = specialtyMap.get(anchor.id);
                      if (!specialty) return null;
                      return (
                        <g
                          class="dt-graph__node dt-graph__node--skill"
                          role="button"
                          tabindex="0"
                          aria-label={`${specialty.name}, shared by ${specialty.memberCount} people`}
                          aria-pressed="false"
                          data-network-node
                          data-id={specialty.slug}
                          data-label={specialty.name}
                          style={`--node-color: ${colorValue(specialty.colorKey)};`}
                          transform={`translate(${anchor.x} ${anchor.y})`}
                        >
                          <rect
                            class="dt-graph__skill-hit"
                            x={-anchor.w / 2 - 8}
                            y={-anchor.h / 2 - 8}
                            width={anchor.w + 16}
                            height={anchor.h + 16}
                            rx="16"
                          />
                          <rect
                            class="dt-graph__skill-shape"
                            x={-anchor.w / 2}
                            y={-anchor.h / 2}
                            width={anchor.w}
                            height={anchor.h}
                            rx="11"
                          />
                          <text class="dt-graph__skill-name" x="0" y="-3" text-anchor="middle">
                            {specialty.name}
                          </text>
                          <text class="dt-graph__skill-count" x="0" y="14" text-anchor="middle">
                            shared by {specialty.memberCount}
                          </text>
                        </g>
                      );
                    })}
                  </g>

                  <g class="dt-graph__people">
                    {layout.authorNodes.map((node) => {
                      const author = authorBySlug.get(node.id);
                      if (!author) return null;
                      const primary = graphSpecialties.find((specialty) =>
                        author.specialties.some((item) => item.slug === specialty.slug),
                      );
                      return (
                        <g
                          class="dt-graph__node dt-graph__node--person"
                          role="button"
                          tabindex="0"
                          aria-label={`${author.name}, ${author.roleTitle || 'Dream Team member'}`}
                          aria-pressed="false"
                          data-network-node
                          data-id={author.slug}
                          data-label={author.name}
                          style={`--node-color: ${colorValue(primary?.colorKey ?? 'accent')};`}
                          transform={`translate(${node.x} ${node.y})`}
                        >
                          <circle class="dt-graph__person-hit" cx="0" cy="0" r={node.r + 13} />
                          <circle class="dt-graph__person-ring" cx="0" cy="0" r={node.r + 4} />
                          <circle class="dt-graph__person-shape" cx="0" cy="0" r={node.r} />
                          {author.avatar?.src ? (
                            <image
                              href={author.avatar.src}
                              x={-(node.r - 3)}
                              y={-(node.r - 3)}
                              width={(node.r - 3) * 2}
                              height={(node.r - 3) * 2}
                              clip-path={`url(#clip-${author.slug})`}
                              preserveAspectRatio="xMidYMid slice"
                            />
                          ) : (
                            <text
                              class="dt-graph__initials"
                              x="0"
                              y="1"
                              text-anchor="middle"
                              dominant-baseline="central"
                            >
                              {initialsOf(author.name)}
                            </text>
                          )}
                          <text
                            class="dt-graph__person-name"
                            x="0"
                            y={node.r + 22}
                            text-anchor="middle"
                          >
                            {graphNameOf(author.name)}
                          </text>
                        </g>
                      );
                    })}
                  </g>
                </svg>
              </div>

              <aside class="dt-story" aria-label="Selected network connection" aria-live="polite">
                <div data-network-detail="">
                  <p class="dt-story__label">What you are seeing</p>
                  <h3>Data skills travel.</h3>
                  <p>
                    People sit at the edge of the field. The shared capabilities between them form
                    the centre. Every line is a real overlap in how they work.
                  </p>
                  <div class="dt-story__legend" aria-label="Network key">
                    <span><i class="dt-story__person-key" aria-hidden="true"></i>People</span>
                    <span><i class="dt-story__skill-key" aria-hidden="true"></i>Shared capability</span>
                  </div>
                </div>

                {graphSpecialties.map((specialty) => {
                  const connectedAuthors = authorsBySpecialty.get(specialty.slug) ?? [];
                  return (
                    <div data-network-detail={specialty.slug} hidden>
                      <p class="dt-story__label">Shared data point</p>
                      <h3>{specialty.name}</h3>
                      <p>
                        A working capability shared by {connectedAuthors.length} people—useful in
                        different roles, industries, and departments.
                      </p>
                      <div class="dt-story__people">
                        {connectedAuthors.map((author) => (
                          <a href={`/dream-team/${author.slug}`}>
                            <Avatar src={author.avatar?.src} name={author.name} size={32} />
                            <span>
                              <strong>{author.name}</strong>
                              {author.roleTitle && <small>{author.roleTitle}</small>}
                            </span>
                          </a>
                        ))}
                      </div>
                    </div>
                  );
                })}

                {authors.map((author) => (
                  <div data-network-detail={author.slug} hidden>
                    <p class="dt-story__label">Dream Team member</p>
                    <div class="dt-story__identity">
                      <Avatar src={author.avatar?.src} name={author.name} size={48} />
                      <div>
                        <h3>{author.name}</h3>
                        {author.roleTitle && <p>{author.roleTitle}</p>}
                      </div>
                    </div>
                    {author.specialties.length > 0 && (
                      <ul class="dt-story__tags" aria-label={`${author.name}'s capabilities`}>
                        {author.specialties.map((specialty) => <li>{specialty.name}</li>)}
                      </ul>
                    )}
                    <a class="dt-story__profile" href={`/dream-team/${author.slug}`}>
                      View {author.name.split(/\s+/)[0]}'s profile <span aria-hidden="true">→</span>
                    </a>
                  </div>
                ))}
              </aside>

              <div class="dt-mobile-map" aria-label="Shared capabilities and connected people">
                <div data-mobile-network-panel="">
                  <p class="dt-mobile-map__intro">
                    Start with a shared data point. Each one opens the people and roles it connects.
                  </p>
                  <div class="dt-mobile-map__branches">
                    {graphSpecialties.map((specialty) => {
                      const connectedAuthors = authorsBySpecialty.get(specialty.slug) ?? [];
                      return (
                        <button
                          type="button"
                          class="dt-branch"
                          data-network-node
                          data-id={specialty.slug}
                          data-label={specialty.name}
                          aria-pressed="false"
                          style={`--node-color: ${colorValue(specialty.colorKey)};`}
                        >
                          <span class="dt-branch__mark" aria-hidden="true"></span>
                          <span class="dt-branch__copy">
                            <strong>{specialty.name}</strong>
                            <small>Connects {connectedAuthors.length} people</small>
                          </span>
                          <span class="dt-branch__avatars" aria-hidden="true">
                            {connectedAuthors.slice(0, 4).map((author) => (
                              <Avatar src={author.avatar?.src} name={author.name} size={32} />
                            ))}
                          </span>
                          <span class="dt-branch__arrow" aria-hidden="true">→</span>
                        </button>
                      );
                    })}
                  </div>
                </div>

                {graphSpecialties.map((specialty) => {
                  const connectedAuthors = authorsBySpecialty.get(specialty.slug) ?? [];
                  return (
                    <section
                      class="dt-mobile-path"
                      data-mobile-network-panel={specialty.slug}
                      aria-label={`${specialty.name} connections`}
                      hidden
                    >
                      <button
                        type="button"
                        class="dt-mobile-path__back"
                        data-network-filter=""
                        aria-label="Back to all shared capabilities"
                      >
                        <span aria-hidden="true">←</span> All shared capabilities
                      </button>
                      <header style={`--node-color: ${colorValue(specialty.colorKey)};`}>
                        <span aria-hidden="true"></span>
                        <div tabindex="-1" data-mobile-panel-title>
                          <p>Shared data point</p>
                          <h3>{specialty.name}</h3>
                          <small>{connectedAuthors.length} connected people</small>
                        </div>
                      </header>
                      <div class="dt-mobile-path__people">
                        {connectedAuthors.map((author) => (
                          <a href={`/dream-team/${author.slug}`}>
                            <Avatar src={author.avatar?.src} name={author.name} size={48} />
                            <span>
                              <strong>{author.name}</strong>
                              {author.roleTitle && <small>{author.roleTitle}</small>}
                            </span>
                            <b aria-hidden="true">→</b>
                          </a>
                        ))}
                      </div>
                    </section>
                  );
                })}

                <noscript>
                  <div class="dt-nojs-network">
                    <p>Shared capabilities and the people they connect</p>
                    {graphSpecialties.map((specialty) => {
                      const connectedAuthors = authorsBySpecialty.get(specialty.slug) ?? [];
                      return (
                        <section>
                          <h3>{specialty.name}</h3>
                          <ul>
                            {connectedAuthors.map((author) => (
                              <li><a href={`/dream-team/${author.slug}`}>{author.name}</a></li>
                            ))}
                          </ul>
                        </section>
                      );
                    })}
                  </div>
                </noscript>
              </div>
            </div>
          </section>
        )}

        <section class="dt-list" aria-labelledby="team-list-title">
          <header class="dt-list__head">
            <div>
              <p class="kicker">The people</p>
              <h2 id="team-list-title">Meet the Dream Team.</h2>
            </div>
            <p>
              Open a profile to see the experience, work, and perspective behind each point in the network.
            </p>
          </header>
          <div class="dt-list__grid">
            {authors.map((author) => <AuthorCard author={author} />)}
          </div>
        </section>
      </>
    )}
  </div>
</BaseLayout>

<style>
  .dt {
    padding-block: var(--page-top) var(--page-bottom);
  }

  .dt-hero {
    display: grid;
    gap: var(--space-8);
    align-items: end;
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-2);
  }

  .dt-hero__copy {
    max-width: 57rem;
  }

  .dt-hero h1 {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--fs-page-title);
    font-weight: 610;
    letter-spacing: -0.025em;
    line-height: var(--lh-page-title);
  }

  .dt-hero h1 span {
    display: block;
    color: var(--accent);
  }

  .dt-hero__intro {
    max-width: 43rem;
    margin-top: var(--space-6);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .dt-hero__note {
    max-width: 31rem;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-2);
  }

  .dt-hero__note > p {
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
  }

  .dt-hero__note dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .dt-hero__note dl div {
    min-width: 0;
  }

  .dt-hero__note dt {
    color: var(--text-1);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: 1;
  }

  .dt-hero__note dd {
    margin-top: var(--space-2);
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: var(--lh-xs);
  }

  .dt-network {
    position: relative;
    margin-top: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
    border: 1px solid var(--border-2);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 48% 44%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 33rem),
      var(--bg-1);
  }

  .dt-network__head {
    display: flex;
    gap: var(--space-6);
    align-items: end;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border-1);
  }

  .dt-network__title > p:first-child {
    color: var(--accent);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .dt-network__title h2 {
    margin-top: var(--space-2);
    font-size: clamp(2rem, 4vw, 3.75rem);
    font-weight: 590;
    letter-spacing: -0.02em;
  }

  .dt-network__title > p:last-child {
    max-width: 42rem;
    margin-top: var(--space-3);
    font-size: var(--fs-base);
  }

  .dt-network__status {
    flex: 0 0 auto;
    color: var(--text-3);
    font-size: var(--fs-xs);
    text-align: right;
  }

  .dt-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-4) clamp(1.5rem, 4vw, 3rem);
    border-bottom: 1px solid var(--border-1);
  }

  .dt-filters button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-2);
    font-size: var(--fs-sm);
    cursor: pointer;
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .dt-filters button > span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--node-color, var(--accent));
  }

  .dt-filters button small {
    color: var(--text-3);
    font-size: var(--fs-xs);
  }

  .dt-filters button:hover,
  .dt-filters button.is-active {
    border-color: color-mix(in srgb, var(--node-color, var(--accent)) 70%, var(--border-2));
    background: color-mix(in srgb, var(--node-color, var(--accent)) 10%, transparent);
    color: var(--text-1);
  }

  .dt-network__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 23rem);
    min-height: 41rem;
  }

  .dt-graph-wrap {
    min-width: 0;
    padding: var(--space-3);
  }

  .dt-graph {
    width: 100%;
    height: 100%;
    min-height: 39rem;
    overflow: visible;
  }

  .dt-graph__link {
    fill: none;
    stroke: color-mix(in srgb, var(--node-color) 56%, var(--border-2));
    stroke-linecap: round;
    stroke-width: 1.7;
    opacity: 0.7;
    transition:
      opacity var(--dur-2) var(--ease-out),
      stroke-width var(--dur-2) var(--ease-out);
  }

  .dt-graph__link.is-active {
    stroke-width: 2.8;
    opacity: 0.98;
  }

  .dt-graph__link.is-dimmed {
    opacity: 0.07;
  }

  .dt-graph__node {
    cursor: pointer;
    outline: none;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .dt-graph__node.is-dimmed {
    opacity: 0.16;
  }

  .dt-graph__node.is-connected {
    opacity: 0.82;
  }

  .dt-graph__skill-hit,
  .dt-graph__person-hit {
    fill: transparent;
  }

  .dt-graph__skill-shape {
    fill: color-mix(in srgb, var(--node-color) 8%, var(--bg-2));
