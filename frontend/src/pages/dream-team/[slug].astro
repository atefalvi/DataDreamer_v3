---
/**
 * V4-DT-003 — Author page (05 §8). Profile header, bio + statement, tools, the author's
 * writing, featured work, and related teammates. SSR; 404-rewrites for unknown/inactive
 * authors. Every section omits gracefully (renders fully with zero posts).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Avatar from '../../components/ui/Avatar.astro';
import Icon from '../../components/ui/Icon.astro';
import PostCard from '../../components/blog/PostCard.astro';
import AuthorCard from '../../components/dream-team/AuthorCard.astro';
import { authorsRepo, postsRepo } from '../../lib/repositories';
import { profilePageJsonLd } from '../../lib/seo/jsonld';
import type { Author, AuthorSummary, PostListItem } from '../../types/content';
import '../../styles/prose.css';

const slug = Astro.params.slug;
if (!slug) return Astro.rewrite('/404');

let author: Author | null = null;
try {
  author = await authorsRepo.bySlug(slug);
} catch (error) {
  console.error('[author] lookup failed:', error instanceof Error ? error.message : error);
}
if (!author) return Astro.rewrite('/404');

let posts: PostListItem[] = [];
let related: AuthorSummary[] = [];
try {
  [posts, related] = await Promise.all([postsRepo.byAuthor(slug, 10), authorsRepo.related(author, 3)]);
} catch (error) {
  console.error('[author] sections failed:', error instanceof Error ? error.message : error);
}

/** Map a link's label (or URL) to an icon name — covers the popular socials + a
 *  globe fallback for personal sites/portfolios. */
const iconFor = (link: { label: string; url: string }): string => {
  const s = `${link.label} ${link.url}`.toLowerCase();
  if (s.includes('github')) return 'github';
  if (s.includes('linkedin')) return 'linkedin';
  if (s.includes('twitter') || s.includes('x.com') || /\bx\b/.test(link.label.toLowerCase())) return 'x';
  if (s.includes('instagram') || s.includes('insta')) return 'instagram';
  if (s.includes('youtube') || s.includes('youtu.be')) return 'youtube';
  if (s.includes('mail') || s.includes('@') || link.url.startsWith('mailto:')) return 'mail';
  return 'globe';
};

const jsonLd = [
  profilePageJsonLd({
      name: author.name,
      jobTitle: author.roleTitle,
      url: `/dream-team/${author.slug}`,
      image: author.avatar?.src,
      sameAs: author.links.map((l) => l.url),
  }),
];
---

<BaseLayout
  title={`${author.name} — ${author.roleTitle}`}
  description={`${author.name}, ${author.roleTitle} at DataDreamer.`}
  ogType="profile"
  ogImage={{ url: '/og/og-team.png' }}
  jsonLd={jsonLd}
>
  <div class="author container-wide">
    <Breadcrumbs
      items={[{ label: 'Dream Team', href: '/dream-team' }, { label: author.name }]}
      class="author__crumbs"
    />

    <header class="author__hero">
      <span class="author__hero-grid" aria-hidden="true"></span>
      <div class="author__hero-inner">
        <span class="author__avatar-wrap">
          <Avatar src={author.avatar?.src} name={author.name} size={128} class="author__avatar" />
        </span>
        <div class="author__id">
          <p class="kicker">Dream Team</p>
          <h1>{author.name}</h1>
          <p class="author__role">{author.roleTitle}</p>
          {author.specialties.length > 0 && (
            <ul class="author__specialties">
              {author.specialties.map((s) => (
                <li class="author__specialty">{s.name}</li>
              ))}
            </ul>
          )}
          {author.links.length > 0 && (
            <div class="author__links">
              {author.links.map((link) => (
                <a
                  href={link.url}
                  class="author__link"
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={`${author!.name} on ${link.label}`}
                >
                  <Icon name={iconFor(link)} size={16} />
                  <span>{link.label}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="author__body">
      <div class="author__main">
        {author.statement && <blockquote class="author__statement">{author.statement}</blockquote>}
        {author.bioHtml && <div class="author__bio prose" set:html={author.bioHtml} />}
      </div>

      {(author.tools.length > 0 || author.links.length > 0) && (
        <aside class="author__side" aria-label="Profile details">
          {author.tools.length > 0 && (
            <section class="author__tools" aria-label="Tools & tech">
              <p class="kicker">Tools</p>
              <ul>
                {author.tools.map((tool) => <li>{tool}</li>)}
              </ul>
            </section>
          )}
          {author.links.length > 0 && (
            <section class="author__connect" aria-label="Connect">
              <p class="kicker">Connect</p>
              <ul>
                {author.links.map((link) => (
                  <li>
                    <a href={link.url} rel="noopener noreferrer" target="_blank">
                      <Icon name={iconFor(link)} size={16} />
                      <span>{link.label}</span>
                      <Icon name="arrow-up-right" size={16} class="author__connect-arrow" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      )}
    </div>

    {posts.length > 0 && (
      <section class="author__writing" aria-label={`Writing by ${author.name}`}>
        <p class="kicker">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
        <h2>Writing</h2>
        <div class="author__posts">
          {posts.map((post) => <PostCard post={post} variant="card" />)}
        </div>
      </section>
    )}

    {author.featuredWork.length > 0 && (
      <section class="author__featured" aria-label="Featured work">
        <p class="kicker">Featured work</p>
        <div class="author__featured-grid">
          {author.featuredWork.slice(0, 2).map((work) => (
            <a href={work.url} class="featured-card" rel="noopener noreferrer" target="_blank">
              <h3>{work.title}</h3>
              {work.description && <p>{work.description}</p>}
              <span class="featured-card__arrow" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
            </a>
          ))}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="author__related" aria-label="More of the team">
        <p class="kicker">More of the team</p>
        <div class="author__related-grid">
          {related.map((member) => <AuthorCard author={member} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .author {
    padding-block: calc(var(--nav-height) + var(--space-7)) var(--section-y);
  }

  .author__crumbs {
    margin-bottom: var(--space-6);
  }

  /* Premium profile hero — ambient backdrop, ringed avatar (matches home cards). */
  .author__hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: var(--space-7);
    border: 1px solid color-mix(in srgb, var(--border-2) 82%, transparent);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 130% at 100% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 46%),
      linear-gradient(150deg, color-mix(in srgb, var(--bg-2) 80%, transparent), var(--bg-1));
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--text-1) 7%, transparent),
      0 18px 54px color-mix(in srgb, #000 20%, transparent);
  }

  .author__hero-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--border-1) 60%, transparent) 1px, transparent 1px),
      linear-gradient(180deg, color-mix(in srgb, var(--border-1) 40%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(70% 70% at 85% 10%, #000, transparent 75%);
    opacity: 0.5;
  }

  .author__hero-inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .author__hero-inner {
      grid-template-columns: auto 1fr;
      gap: var(--space-7);
    }
  }

  /* Avatar with accent ring + glow. */
  .author__avatar-wrap {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(140deg, var(--accent), color-mix(in srgb, var(--accent) 20%, transparent));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent), 0 12px 32px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .author__avatar-wrap :global(.ui-avatar) {
    box-shadow: 0 0 0 4px var(--bg-1);
  }

  .author__id h1 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .author__role {
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: var(--fs-lg);
  }

  .author__specialties {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .author__specialty {
    padding: var(--space-1) var(--space-3);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .author__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .author__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.25rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--bg-1) 70%, transparent);
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: 560;
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out);
  }

  .author__link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Body — main column + sticky detail rail so content fills the width. */
  .author__body {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--section-y);
  }

  @media (min-width: 64rem) {
    .author__body {
      grid-template-columns: minmax(0, 1fr) 17rem;
      gap: var(--space-9);
      align-items: start;
    }
    .author__side {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-5));
    }
  }

  .author__statement {
    max-width: 42ch;
    margin: 0;
    padding-left: var(--space-5);
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
    color: var(--text-1);
  }

  .author__bio {
    max-width: none;
    margin-top: var(--space-6);
  }

  .author__side {
    display: grid;
    gap: var(--space-6);
  }

  .author__tools ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .author__tools li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-full);
    background: var(--bg-1);
    font-size: var(--fs-sm);
  }

  /* Connect rail. */
  .author__connect ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .author__connect a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-md);
    background: var(--bg-1);
    color: var(--text-1);
    font-size: var(--fs-sm);
    font-weight: 560;
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
  }

  .author__connect a span {
    flex: 1;
  }

  .author__connect-arrow {
    color: var(--text-3);
  }

  .author__connect a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .author__connect a:hover .author__connect-arrow {
    color: var(--accent);
  }

  .author__writing,
  .author__featured,
  .author__related {
    margin-top: var(--section-y);
    padding-top: var(--space-8);
    border-top: 1px solid color-mix(in srgb, var(--border-2) 64%, transparent);
  }

  .author__writing h2 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
    font-weight: 600;
  }

  .author__posts {
    display: grid;
    gap: clamp(var(--space-4), 2.2vw, var(--space-6));
    margin-top: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    align-items: stretch;
  }

  .author__posts :global(.post-card--card .post-card__link) {
    min-height: 100%;
    padding: clamp(var(--space-4), 2vw, var(--space-6));
  }

  .author__posts :global(.post-card--card .post-card__title) {
    font-size: clamp(var(--fs-xl), 2.1vw, var(--fs-2xl));
    line-height: var(--lh-2xl);
  }

  .author__posts :global(.post-card--card .post-card__excerpt) {
    -webkit-line-clamp: 3;
  }

  .author__featured-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  }

  .featured-card {
    position: relative;
    display: block;
    padding: var(--space-5);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    background: var(--bg-1);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }

  .featured-card:hover {
    border-color: var(--border-2);
    transform: translateY(-2px);
  }

  .featured-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 580;
    padding-right: var(--space-5);
  }

  .featured-card p {
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
  }

  .featured-card__arrow {
    position: absolute;
    top: var(--space-5);
    right: var(--space-5);
    color: var(--text-3);
  }

  .featured-card:hover .featured-card__arrow {
    color: var(--accent);
  }

  .author__related-grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }

  @media (max-width: 41.999rem) {
    .author__hero {
      padding: var(--space-5);
    }

    .author__posts {
      gap: var(--space-4);
    }
  }
</style>
