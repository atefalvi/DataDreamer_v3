---
/**
 * V4-PROJ-002 — Case study (05 §6). Renders a Directus `projects` entry. The body is
 * rendered through the SAME markdown pipeline as blog articles (mapProject → bodyHtml),
 * so `:::` callouts render identically. Cover via Directus asset; sticky fact rail on TL+.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { projectsRepo } from '../../lib/repositories';
import { directusSrcset } from '../../lib/images';
import { breadcrumbListJsonLd, creativeWorkJsonLd } from '../../lib/seo/jsonld';
import '../../styles/prose.css';

const { slug } = Astro.params;
if (!slug) return Astro.rewrite('/404');

const project = await projectsRepo.bySlug(slug);
if (!project) return Astro.rewrite('/404');

const { title, summary, year, role, author, tags, coverImage, links, bodyHtml } = project;
// Authors without a public team profile render as plain text (no dead link).
const authorHref = author.dreamTeam ? `/dream-team/${author.slug}` : undefined;

// Prev/next in display order.
let all: Awaited<ReturnType<typeof projectsRepo.list>> = [];
try {
  all = await projectsRepo.list();
} catch (error) {
  console.error('[case study] neighbors unavailable:', error instanceof Error ? error.message : error);
}
const index = all.findIndex((p) => p.slug === project.slug);
const previous = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;

const jsonLd = [
  creativeWorkJsonLd({
    name: title,
    description: summary,
    datePublished: String(year),
    url: `/projects/${project.slug}`,
    keywords: tags,
  }),
  breadcrumbListJsonLd([
    { label: 'Projects', href: '/projects' },
    { label: title },
  ]),
];
---

<BaseLayout
  title={title}
  description={summary}
  ogType="article"
  ogImage={{ url: '/og/og-projects.png', alt: title }}
  jsonLd={jsonLd}
>
  <article class="case container-content">
    <header class="case__head">
      <p class="kicker">Case study · {year}</p>
      <h1>{title}</h1>
      <p class="case__byline">
        By {authorHref ? <a href={authorHref}>{author.name}</a> : <span>{author.name}</span>}
      </p>
      <p class="case__lede">{summary}</p>
    </header>

    {coverImage && (
      <div class="case__cover">
        <img
          src={coverImage.src}
          srcset={directusSrcset(coverImage.id, [640, 1024, 1600])}
          sizes="(min-width: 80rem) 1200px, 100vw"
          width={coverImage.width}
          height={coverImage.height}
          alt={coverImage.alt}
          loading="eager"
        />
      </div>
    )}

    <span class="visually-hidden" role="status" aria-live="polite" data-code-copy-status></span>

    <div class="case__layout">
      <div class="case__body blog-content article-prose" set:html={bodyHtml} />

      <aside class="case__rail" aria-label="Project facts">
        <dl>
          <div>
            <dt>Author</dt>
            <dd>{authorHref ? <a href={authorHref}>{author.name}</a> : author.name}</dd>
          </div>
          <div><dt>Role</dt><dd>{role}</dd></div>
          <div><dt>Year</dt><dd>{year}</dd></div>
          <div>
            <dt>Stack</dt>
            <dd>
              <ul class="case__stack">{tags.map((s) => <li>{s}</li>)}</ul>
            </dd>
          </div>
          {links && links.length > 0 && (
            <div>
              <dt>Links</dt>
              <dd>
                <ul class="case__links">
                  {links.map((link) => (
                    <li>
                      <a href={link.url} rel="noopener noreferrer" target="_blank">
                        {link.label}
                        <Icon name="arrow-up-right" size={16} />
                      </a>
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>

    {(previous || next) && (
      <nav class="case__pager" aria-label="More projects">
        {previous ? (
          <a href={`/projects/${previous.slug}`} class="case__pager-link case__pager-link--prev">
            <span class="case__pager-dir">← Previous</span>
            <span class="case__pager-title">{previous.title}</span>
          </a>
        ) : <span />}
        {next && (
          <a href={`/projects/${next.slug}`} class="case__pager-link case__pager-link--next">
            <span class="case__pager-dir">Next →</span>
            <span class="case__pager-title">{next.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>

  <script>
    import { initCodeCopy } from '../../lib/markdown/codeCopy';
    initCodeCopy();
  </script>
</BaseLayout>

<style>
  .case {
    padding-block: calc(var(--nav-height) + var(--space-7)) var(--section-y);
  }

  .case__head {
    max-width: var(--container-prose);
  }

  .case__head h1 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .case__lede {
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-xl);
    line-height: var(--lh-xl);
  }

  .case__byline {
    margin-top: var(--space-3);
    color: var(--text-3);
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
  }

  .case__byline a {
    color: var(--text-2);
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-underline-offset: 0.2em;
  }

  .case__byline a:hover {
    color: var(--accent);
  }

  .case__cover {
    overflow: hidden;
    margin-top: var(--space-7);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    aspect-ratio: 21 / 9;
    background: var(--bg-2);
  }

  .case__cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    margin-top: var(--space-8);
  }

  .case__body,
  .case__rail {
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .case__layout {
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: var(--space-9);
      align-items: start;
    }
    .case__rail {
      position: sticky;
      top: calc(var(--nav-height) + var(--space-5));
      order: 2;
    }
  }

  /* Fact rail. */
  .case__rail dl {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-5);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    background: var(--bg-1);
  }

  .case__rail dt {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .case__rail dd {
    margin: var(--space-2) 0 0;
    color: var(--text-1);
    font-size: var(--fs-base);
  }

  .case__rail dd > a {
    color: var(--text-1);
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-underline-offset: 0.2em;
  }

  .case__rail dd > a:hover {
    color: var(--accent);
  }

  .case__stack,
  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case__stack li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-full);
    font-size: var(--fs-sm);
  }

  .case__links {
    flex-direction: column;
    gap: var(--space-2);
  }

  .case__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--accent);
    font-size: var(--fs-sm);
    text-decoration: none;
  }

  .case__links a:hover {
    text-decoration: underline;
  }

  /* Pager. */
  .case__pager {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--section-y);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-1);
  }

  @media (min-width: 48rem) {
    .case__pager {
      grid-template-columns: 1fr 1fr;
    }
    .case__pager-link--next {
      text-align: right;
    }
  }

  .case__pager-link {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .case__pager-link:hover {
    border-color: var(--border-2);
  }

  .case__pager-dir {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .case__pager-title {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-weight: 560;
  }

  .case__pager-link:hover .case__pager-title {
    color: var(--accent);
  }
</style>
