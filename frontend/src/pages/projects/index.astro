---
/**
 * Project index. Shared-topic chips are SSR `?topic=` links and technical stack tags
 * remain searchable card metadata. The client-side search composes with topic filters.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/projects/CaseCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Icon from '../../components/ui/Icon.astro';
import Chip from '../../components/ui/Chip.astro';
import CollectionHeader from '../../components/ui/CollectionHeader.astro';
import CollectionViewToggle from '../../components/ui/CollectionViewToggle.astro';
import { projectsRepo } from '../../lib/repositories';
import { collectionPageJsonLd } from '../../lib/seo/jsonld';
import type { ProjectListItem } from '../../types/content';

let sorted: ProjectListItem[] = [];
try {
  sorted = await projectsRepo.list();
} catch (error) {
  console.error('[projects] list unavailable:', error instanceof Error ? error.message : error);
}
const all = sorted;

const activeTopic = Astro.url.searchParams.get('topic');

// Shared topic facets, busiest first. Technical stack tags remain project metadata.
const topicCounts = new Map<string, { name: string; slug: string; count: number }>();
for (const project of all) for (const topic of project.topics) {
  const entry = topicCounts.get(topic.slug) ?? { ...topic, count: 0 };
  entry.count += 1;
  topicCounts.set(topic.slug, entry);
}
const topics = [...topicCounts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const visible = activeTopic ? sorted.filter((p) => p.topics.some((topic) => topic.slug === activeTopic)) : sorted;
const leadProject = !activeTopic ? visible.find((project) => project.featured) : undefined;
const archiveProjects = leadProject
  ? visible.filter((project) => project.slug !== leadProject.slug)
  : visible;
const searchOf = (p: ProjectListItem) =>
  [p.title, p.summary, p.role, ...p.tags, ...p.topics.map((topic) => topic.name)].join(' ').toLowerCase();

const jsonLd = [
  collectionPageJsonLd({
    name: 'Projects — Data Dreamer',
    url: '/projects',
    description: 'Proof of work and the thinking behind practical data, AI, and business systems.',
  }),
];
---

<BaseLayout
  title="Projects"
  description="Proof of work and the thinking behind practical data, AI, and business systems."
  ogImage={{ url: '/og/og-projects.png' }}
  jsonLd={jsonLd}
>
  <div class="projects container-wide">
    <CollectionHeader
      kicker="Projects"
      title="Proof of work, not just proof of tools."
      intro="Projects show how ideas move from a business problem to a practical system, including the decisions, trade-offs, models, interfaces, implementation, outcomes, and lessons behind the build."
    >
      <span slot="aside" class="projects__count">
        {all.length.toString().padStart(2, '0')} published {all.length === 1 ? 'project' : 'projects'}
      </span>
    </CollectionHeader>

    {all.length === 0 ? (
      <EmptyState message="Projects will appear here as the work is documented." icon="folder-open" />
    ) : (
      <>
        {leadProject && (
          <section class="projects__featured" aria-label="Featured project" data-project-item data-search={searchOf(leadProject)}>
            <CaseCard project={leadProject} variant="lead" />
          </section>
        )}

        <div class="projects__controls">
          {topics.length > 0 && (
            <nav class="projects__filter" aria-label="Filter by project topic">
              <Chip label={`All ${all.length}`} href="/projects" selected={!activeTopic} />
              {topics.map((topic) => (
                <Chip
                  label={`${topic.name} ${topic.count}`}
                  href={`/projects?topic=${encodeURIComponent(topic.slug)}`}
                  selected={activeTopic === topic.slug}
                />
              ))}
            </nav>
          )}

          <div class="projects__query-filter">
            <label for="project-search">Search projects</label>
            <div class="projects__search">
              <Icon name="search" size={16} />
              <input
                type="search"
                id="project-search"
                placeholder="Search titles, summaries, and topics"
                autocomplete="off"
                data-project-search
              />
            </div>
          </div>
        </div>

        {visible.length === 0 ? (
          <EmptyState message={`No projects in “${activeTopic}” yet.`} icon="search-x" action={{ label: 'Clear filter', href: '/projects' }} />
        ) : (
          <>
            {archiveProjects.length > 0 && <section class="projects__results" aria-labelledby="project-results-heading" data-collection-view-root data-collection-view="editorial">
              <div class="projects__results-head">
                <h2 id="project-results-heading">{leadProject ? 'More selected work' : 'Selected work'}</h2>
                <div class="projects__results-meta">
                  <span>{archiveProjects.length.toString().padStart(2, '0')} {archiveProjects.length === 1 ? 'case study' : 'case studies'}</span>
                  {archiveProjects.length > 1 && <CollectionViewToggle />}
                </div>
              </div>
              <div class="projects__grid" data-collection-archive>
                {archiveProjects.map((project) => (
                  <div class="projects__item" data-project-item data-search={searchOf(project)}>
                    <CaseCard project={project} variant="row" />
                  </div>
                ))}
              </div>
            </section>}
            <p class="projects__noresults" data-project-noresults hidden>
              No projects match your search. <a href="/projects">Reset</a>.
            </p>
          </>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .projects {
    padding-block: var(--page-top) var(--page-bottom);
  }

  .projects__count {
    display: block;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .projects__controls {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-block: 1px solid var(--border-1);
  }

  .projects__featured {
    margin-top: var(--space-7);
  }

  .projects__query-filter {
    display: grid;
    gap: var(--space-2);
  }

  .projects__query-filter > label {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .projects__search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-md);
    background: var(--bg-1);
    color: var(--text-3);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .projects__search:focus-within {
    border-color: var(--accent);
    color: var(--accent);
  }

  .projects__search input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-1);
    font-family: var(--font-text);
    font-size: var(--fs-sm);
  }

  .projects__search input::-webkit-search-cancel-button {
    appearance: none;
  }

  .projects__filter {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-1);
    scrollbar-width: thin;
  }

  .projects__filter :global(.ui-chip) {
    flex: 0 0 auto;
  }

  .projects__results-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .projects__results-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 560;
    line-height: var(--lh-2xl);
  }

  .projects__results-meta {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .projects__results-meta > span {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    white-space: nowrap;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    margin-top: var(--space-5);
  }

  .projects__item {
    min-width: 0;
  }

  /* Search hides items via [hidden]; the explicit display rules above would otherwise
     override the UA [hidden] { display: none }, so re-assert it with higher specificity. */
  .projects__item[hidden] {
    display: none;
  }

  .projects__noresults {
    margin-top: var(--space-7);
    color: var(--text-2);
  }

  .projects__noresults a {
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    [data-collection-view='grid'] .projects__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    [data-collection-view='editorial'] .projects__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 75rem) {
    [data-collection-view='grid'] .projects__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .projects__controls {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
      align-items: end;
    }
  }

  @media (max-width: 40rem) {
    .projects__results-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .projects__results-meta {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-project-search]');
  const root = document.querySelector<HTMLElement>('.projects');
  const noResults = document.querySelector<HTMLElement>('[data-project-noresults]');

  if (input && root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-project-item]'));
    const run = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const match = !q || (item.dataset.search ?? '').includes(q);
        item.hidden = !match;
        if (match) shown += 1;
      }
      if (noResults) noResults.hidden = shown !== 0;
    };
    input.addEventListener('input', run);
  }
</script>
