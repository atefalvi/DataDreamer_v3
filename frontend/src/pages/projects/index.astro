---
/**
 * Project index. Shared-topic chips are SSR `?topic=` links and technical stack tags
 * remain searchable card metadata. The client-side search composes with topic filters.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/projects/CaseCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Icon from '../../components/ui/Icon.astro';
import { projectsRepo } from '../../lib/repositories';
import { collectionPageJsonLd } from '../../lib/seo/jsonld';
import type { ProjectListItem } from '../../types/content';

let sorted: ProjectListItem[] = [];
try {
  sorted = await projectsRepo.list();
} catch (error) {
  console.error('[projects] list unavailable:', error instanceof Error ? error.message : error);
}
const all = sorted;

const activeTopic = Astro.url.searchParams.get('topic');

// Shared topic facets, busiest first. Technical stack tags remain project metadata.
const topicCounts = new Map<string, { name: string; slug: string; count: number }>();
for (const project of all) for (const topic of project.topics) {
  const entry = topicCounts.get(topic.slug) ?? { ...topic, count: 0 };
  entry.count += 1;
  topicCounts.set(topic.slug, entry);
}
const topics = [...topicCounts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const visible = activeTopic ? sorted.filter((p) => p.topics.some((topic) => topic.slug === activeTopic)) : sorted;
const searchOf = (p: ProjectListItem) =>
  [p.title, p.summary, p.role, ...p.tags, ...p.topics.map((topic) => topic.name)].join(' ').toLowerCase();

const jsonLd = [
  collectionPageJsonLd({
    name: 'Projects — Data Dreamer',
    url: '/projects',
    description: 'Proof of work and the thinking behind practical data, AI, and business systems.',
  }),
];
---

<BaseLayout
  title="Projects"
  description="Proof of work and the thinking behind practical data, AI, and business systems."
  ogImage={{ url: '/og/og-projects.png' }}
  jsonLd={jsonLd}
>
  <div class="projects container-content">
    <header class="projects__head">
      <p class="kicker">Projects</p>
      <h1>Proof of work, not just proof of tools.</h1>
      <p class="projects__intro">
        Projects show how ideas move from a business problem to a practical system, including the
        decisions, trade-offs, models, interfaces, implementation, outcomes, and lessons behind the build.
      </p>
    </header>

    {all.length === 0 ? (
      <EmptyState message="Projects will appear here as the work is documented." icon="folder-open" />
    ) : (
      <>
        <div class="projects__controls">
          <div class="projects__search">
            <Icon name="search" size={16} />
            <input
              type="search"
              id="project-search"
              placeholder="Search projects…"
              autocomplete="off"
              aria-label="Search projects"
              data-project-search
            />
          </div>

          {topics.length > 0 && (
            <nav class="projects__filter" aria-label="Filter by project topic">
              <a href="/projects" class:list={['tagchip', { 'is-active': !activeTopic }]}>
                All <span class="tagchip__count">{all.length}</span>
              </a>
              {topics.map((topic) => (
                <a
                  href={`/projects?topic=${encodeURIComponent(topic.slug)}`}
                  class:list={['tagchip', { 'is-active': activeTopic === topic.slug }]}
                >
                  {topic.name} <span class="tagchip__count">{topic.count}</span>
                </a>
              ))}
            </nav>
          )}
        </div>

        {visible.length === 0 ? (
          <EmptyState message={`No projects in “${activeTopic}” yet.`} icon="search-x" action={{ label: 'Clear filter', href: '/projects' }} />
        ) : (
          <>
            <section class="projects__results" aria-labelledby="project-results-heading">
              <h2 id="project-results-heading" class="visually-hidden">Project proof of work</h2>
              <div class="projects__grid" data-project-grid>
                {visible.map((project, i) => (
                  <div class="projects__item" data-search={searchOf(project)}>
                    <CaseCard project={project} class={i % 3 === 0 ? 'case-card--wide' : ''} />
                  </div>
                ))}
              </div>
            </section>
            <p class="projects__noresults" data-project-noresults hidden>
              No projects match your search. <a href="/projects">Reset</a>.
            </p>
          </>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .projects {
    padding-block: var(--page-top) var(--page-bottom);
  }

  .projects__head h1 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .projects__intro {
    max-width: 56ch;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .projects__controls {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-block: 1px solid var(--border-1);
  }

  .projects__search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 24rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-md);
    background: var(--bg-1);
    color: var(--text-3);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .projects__search:focus-within {
    border-color: var(--accent);
    color: var(--accent);
  }

  .projects__search input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-1);
    font-family: var(--font-text);
    font-size: var(--fs-sm);
  }

  .projects__search input::-webkit-search-cancel-button {
    appearance: none;
  }

  /* Tag chips with count pile — wraps as the set grows. */
  .projects__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tagchip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-full);
    background: var(--bg-1);
    color: var(--text-2);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out);
  }

  .tagchip:hover {
    color: var(--text-1);
    border-color: var(--border-2);
  }

  .tagchip.is-active {
    color: var(--text-1);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-1));
  }

  .tagchip__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 var(--space-1);
    border-radius: var(--radius-full);
    background: var(--bg-3);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .tagchip.is-active .tagchip__count {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .projects__grid {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
    grid-template-columns: 1fr;
  }

  .projects__item {
    display: contents;
  }

  /* Search hides items via [hidden]; the explicit display rules above would otherwise
     override the UA [hidden] { display: none }, so re-assert it with higher specificity. */
  .projects__item[hidden] {
    display: none;
  }

  .projects__noresults {
    margin-top: var(--space-7);
    color: var(--text-2);
  }

  .projects__noresults a {
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-7);
    }
    .projects__item {
      display: block;
    }
    /* Asymmetric offset: every third card spans full width as a feature row. */
    .projects__item:has(.case-card--wide) {
      grid-column: 1 / -1;
    }
    .projects__item:has(.case-card--wide) :global(.case-card__media) {
      aspect-ratio: 21 / 9;
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-project-search]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  const noResults = document.querySelector<HTMLElement>('[data-project-noresults]');

  if (input && grid) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.projects__item'));
    const run = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const match = !q || (item.dataset.search ?? '').includes(q);
        item.hidden = !match;
        if (match) shown += 1;
      }
      if (noResults) noResults.hidden = shown !== 0;
    };
    input.addEventListener('input', run);
  }
</script>
