---
/**
 * V4-PROJ-001 — Project index (05 §5). Reads the Directus `projects` collection. Tag
 * chips are SSR `?tag=` links (work with no JS) that show a per-tag count badge and are
 * sorted by count; a client-side search box filters the visible cards by
 * title/summary/role/tags. Search + tag filter compose.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/projects/CaseCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Icon from '../../components/ui/Icon.astro';
import { projectsRepo } from '../../lib/repositories';
import { collectionPageJsonLd } from '../../lib/seo/jsonld';
import type { ProjectListItem } from '../../types/content';

let sorted: ProjectListItem[] = [];
try {
  sorted = await projectsRepo.list();
} catch (error) {
  console.error('[projects] list unavailable:', error instanceof Error ? error.message : error);
}
const all = sorted;

const activeTag = Astro.url.searchParams.get('tag');

// Tag → count, sorted by count desc then alpha (so the busiest tags lead and the list
// stays scannable as it grows).
const tagCounts = new Map<string, number>();
for (const p of all) for (const t of p.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([label, count]) => ({ label, count }));

const visible = activeTag ? sorted.filter((p) => p.tags.includes(activeTag)) : sorted;
const searchOf = (p: ProjectListItem) =>
  [p.title, p.summary, p.role, ...p.tags].join(' ').toLowerCase();

const jsonLd = [
  collectionPageJsonLd({
    name: 'Projects — DataDreamer',
    url: '/projects',
    description: 'Selected projects from DataDreamer — data platforms, analytics, and applied-AI case studies.',
  }),
];
---

<BaseLayout
  title="Projects"
  description="Selected projects from DataDreamer — data platforms, analytics, and applied-AI case studies."
  ogImage={{ url: '/og/og-projects.png' }}
  jsonLd={jsonLd}
>
  <div class="projects container-content">
    <header class="projects__head">
      <p class="kicker">Selected work</p>
      <h1>Projects</h1>
      <p class="projects__intro">
        Case studies from the studio — data platforms, analytics craft, and the engineering behind
        systems that ship.
      </p>
    </header>

    {all.length === 0 ? (
      <EmptyState message="Case studies are being written up. Check back soon." icon="folder-open" />
    ) : (
      <>
        <div class="projects__controls">
          <div class="projects__search">
            <Icon name="search" size={16} />
            <input
              type="search"
              id="project-search"
              placeholder="Search work…"
              autocomplete="off"
              aria-label="Search work"
              data-project-search
            />
          </div>

          {tags.length > 0 && (
            <nav class="projects__filter" aria-label="Filter by stack">
              <a href="/projects" class:list={['tagchip', { 'is-active': !activeTag }]}>
                All <span class="tagchip__count">{all.length}</span>
              </a>
              {tags.map((tag) => (
                <a
                  href={`/projects?tag=${encodeURIComponent(tag.label)}`}
                  class:list={['tagchip', { 'is-active': activeTag === tag.label }]}
                >
                  {tag.label} <span class="tagchip__count">{tag.count}</span>
                </a>
              ))}
            </nav>
          )}
        </div>

        {visible.length === 0 ? (
          <EmptyState message={`No projects tagged “${activeTag}”.`} icon="search-x" action={{ label: 'Clear filter', href: '/projects' }} />
        ) : (
          <>
            <section class="projects__results" aria-labelledby="project-results-heading">
              <h2 id="project-results-heading" class="visually-hidden">Project case studies</h2>
              <div class="projects__grid" data-project-grid>
                {visible.map((project, i) => (
                  <div class="projects__item" data-search={searchOf(project)}>
                    <CaseCard project={project} class={i % 3 === 0 ? 'case-card--wide' : ''} />
                  </div>
                ))}
              </div>
            </section>
            <p class="projects__noresults" data-project-noresults hidden>
              No work matches your search. <a href="/projects">Reset</a>.
            </p>
          </>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .projects {
    padding-block: calc(78px + var(--section-y)) var(--section-y);
  }

  .projects__head h1 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .projects__intro {
    max-width: 56ch;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .projects__controls {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .projects__search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 24rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-full);
    background: var(--bg-1);
    color: var(--text-3);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .projects__search:focus-within {
    border-color: var(--accent);
    color: var(--accent);
  }

  .projects__search input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-1);
    font-family: var(--font-text);
    font-size: var(--fs-sm);
  }

  .projects__search input::-webkit-search-cancel-button {
    appearance: none;
  }

  /* Tag chips with count pile — wraps as the set grows. */
  .projects__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tagchip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-full);
    background: var(--bg-1);
    color: var(--text-2);
    font-size: var(--fs-sm);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out);
  }

  .tagchip:hover {
    color: var(--text-1);
    border-color: var(--border-2);
  }

  .tagchip.is-active {
    color: var(--text-1);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg-1));
  }

  .tagchip__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 var(--space-1);
    border-radius: var(--radius-full);
    background: var(--bg-3);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .tagchip.is-active .tagchip__count {
    background: var(--accent);
    color: var(--text-on-accent);
  }

  .projects__grid {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
    grid-template-columns: 1fr;
  }

  .projects__item {
    display: contents;
  }

  .projects__noresults {
    margin-top: var(--space-7);
    color: var(--text-2);
  }

  .projects__noresults a {
    color: var(--accent);
  }

  @media (min-width: 48rem) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-7);
    }
    .projects__item {
      display: block;
    }
    /* Asymmetric offset: every third card spans full width as a feature row. */
    .projects__item:has(.case-card--wide) {
      grid-column: 1 / -1;
    }
    .projects__item:has(.case-card--wide) :global(.case-card__media) {
      aspect-ratio: 21 / 9;
    }
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-project-search]');
  const grid = document.querySelector<HTMLElement>('[data-project-grid]');
  const noResults = document.querySelector<HTMLElement>('[data-project-noresults]');

  if (input && grid) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.projects__item'));
    const run = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const item of items) {
        const match = !q || (item.dataset.search ?? '').includes(q);
        item.hidden = !match;
        if (match) shown += 1;
      }
      if (noResults) noResults.hidden = shown !== 0;
    };
    input.addEventListener('input', run);
  }
</script>
