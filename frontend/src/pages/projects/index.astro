---
/**
 * V4-PROJ-001 — Project index (05 §5). Reads the repo-owned `projects` content
 * collection (zero Directus). Tag filter is implemented as SSR `?tag=` links so it works
 * with no JS, mirroring the blog's filter decision.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/projects/CaseCard.astro';
import Chip from '../../components/ui/Chip.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import { SITE_URL } from '../../lib/seo/meta';

const all = await getCollection('projects');
const sorted = all.sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

const activeTag = Astro.url.searchParams.get('tag');
const tags = [...new Set(all.flatMap((p) => p.data.stack))].sort((a, b) => a.localeCompare(b));
const visible = activeTag ? sorted.filter((p) => p.data.stack.includes(activeTag)) : sorted;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Work — DataDreamer',
    url: `${SITE_URL}/projects`,
  },
];
---

<BaseLayout
  title="Work"
  description="Selected work from DataDreamer — data platforms, analytics, and applied-AI case studies."
  ogImage={{ url: '/og/og-projects.png' }}
  jsonLd={jsonLd}
>
  <div class="projects container-content">
    <header class="projects__head">
      <p class="kicker">Selected work</p>
      <h1>Work</h1>
      <p class="projects__intro">
        Case studies from the studio — data platforms, analytics craft, and the engineering behind
        systems that ship.
      </p>
    </header>

    {all.length === 0 ? (
      <EmptyState message="Case studies are being written up. Check back soon." icon="folder-open" />
    ) : (
      <>
        {tags.length > 0 && (
          <nav class="projects__filter" aria-label="Filter by stack">
            <Chip label="All" href="/projects" selected={!activeTag} />
            {tags.map((tag) => (
              <Chip label={tag} href={`/projects?tag=${encodeURIComponent(tag)}`} selected={activeTag === tag} />
            ))}
          </nav>
        )}

        {visible.length === 0 ? (
          <EmptyState message={`No projects tagged “${activeTag}”.`} icon="search-x" action={{ label: 'Clear filter', href: '/projects' }} />
        ) : (
          <div class="projects__grid">
            {visible.map((project, i) => (
              <CaseCard project={project} class={i % 3 === 0 ? 'case-card--wide' : ''} />
            ))}
          </div>
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .projects {
    padding-block: calc(78px + var(--section-y)) var(--section-y);
  }

  .projects__head h1 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .projects__intro {
    max-width: 56ch;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  .projects__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .projects__grid {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .projects__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-7);
    }
    /* Asymmetric offset: every third card spans full width as a feature row. */
    .projects__grid :global(.case-card--wide) {
      grid-column: 1 / -1;
    }
    .projects__grid :global(.case-card--wide) :global(.case-card__media) {
      aspect-ratio: 21 / 9;
    }
  }
</style>
