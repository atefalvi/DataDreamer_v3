---
/**
 * Project index. Shared-topic chips are SSR `?topic=` links and technical stack tags
 * remain searchable card metadata. Topic/search filters paginate consistently at nine
 * archive cards per page; the featured project remains a separate editorial module.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseCard from '../../components/projects/CaseCard.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import Icon from '../../components/ui/Icon.astro';
import Chip from '../../components/ui/Chip.astro';
import CollectionArchive from '../../components/ui/CollectionArchive.astro';
import CollectionHeader from '../../components/ui/CollectionHeader.astro';
import Button from '../../components/ui/Button.astro';
import { projectsRepo } from '../../lib/repositories';
import { collectionPageJsonLd } from '../../lib/seo/jsonld';
import { absoluteUrl } from '../../lib/seo/meta';
import { paginateCollection, parseCollectionPage } from '../../lib/collections/pagination';
import { collectionPageRedirect, collectionQueryPath, normalizeCollectionSearch } from '../../lib/collections/query';
import type { ProjectListItem } from '../../types/content';

let sorted: ProjectListItem[] = [];
try {
  sorted = await projectsRepo.list();
} catch (error) {
  console.error('[projects] list unavailable:', error instanceof Error ? error.message : error);
}
const all = sorted;

const activeTopic = Astro.url.searchParams.get('topic');
const activeSearch = normalizeCollectionSearch(Astro.url.searchParams.get('q'));
const rawPage = Astro.url.searchParams.get('page');
const page = parseCollectionPage(rawPage) ?? 1;

// Shared topic facets, busiest first. Technical stack tags remain project metadata.
const topicCounts = new Map<string, { name: string; slug: string; count: number }>();
for (const project of all) for (const topic of project.topics) {
  const entry = topicCounts.get(topic.slug) ?? { ...topic, count: 0 };
  entry.count += 1;
  topicCounts.set(topic.slug, entry);
}
const topics = [...topicCounts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const searchOf = (p: ProjectListItem) =>
  [p.title, p.summary, p.role, ...p.tags, ...p.topics.map((topic) => topic.name)].join(' ').toLowerCase();
const topicFiltered = activeTopic ? sorted.filter((p) => p.topics.some((topic) => topic.slug === activeTopic)) : sorted;
const visible = activeSearch
  ? topicFiltered.filter((project) => searchOf(project).includes(activeSearch.toLowerCase()))
  : topicFiltered;
const featuredProject = !activeTopic && !activeSearch ? visible.find((project) => project.featured) : undefined;
const leadProject = page === 1 ? featuredProject : undefined;
const archive = featuredProject
  ? visible.filter((project) => project.slug !== featuredProject.slug)
  : visible;
const archivePage = paginateCollection(archive, page);
const archiveProjects = archivePage.items;
const totalPages = archivePage.totalPages;

const projectHref = ({
  nextPage = 1,
  topic = activeTopic,
  search = activeSearch,
}: { nextPage?: number; topic?: string | null; search?: string | null } = {}) => {
  return collectionQueryPath('/projects', { topic, q: search }, nextPage);
};

const pageRedirect = collectionPageRedirect(rawPage, page, totalPages, (nextPage) => projectHref({ nextPage }));
if (pageRedirect) {
  return Astro.redirect(pageRedirect.href, pageRedirect.status);
}

const prevHref = page > 1 ? projectHref({ nextPage: page - 1 }) : undefined;
const nextHref = page < totalPages ? projectHref({ nextPage: page + 1 }) : undefined;

const jsonLd = [
  collectionPageJsonLd({
    name: 'Projects — Data Dreamer',
    url: '/projects',
    description: 'Proof of work and the thinking behind practical data, AI, and business systems.',
  }),
];
---

<BaseLayout
  title={page > 1 ? `Projects page ${page}` : 'Projects'}
  description="Proof of work and the thinking behind practical data, AI, and business systems."
  ogImage={{ url: '/og/og-projects.png' }}
  pagination={{
    prev: prevHref ? absoluteUrl(prevHref) : undefined,
    next: nextHref ? absoluteUrl(nextHref) : undefined,
  }}
  jsonLd={jsonLd}
  noindex={Boolean(activeSearch)}
>
  <div class="projects container-wide">
    <CollectionHeader
      kicker="Projects"
      title="Proof of work, not just proof of tools."
      intro="Projects show how ideas move from a business problem to a practical system, including the decisions, trade-offs, models, interfaces, implementation, outcomes, and lessons behind the build."
    >
      <span slot="aside" class="projects__count">
        {all.length.toString().padStart(2, '0')} published {all.length === 1 ? 'project' : 'projects'}
      </span>
    </CollectionHeader>

    {all.length === 0 ? (
      <EmptyState message="Projects will appear here as the work is documented." icon="folder-open" />
    ) : (
      <>
        {leadProject && (
          <section class="projects__featured" aria-label="Featured project" data-project-item data-search={searchOf(leadProject)}>
            <CaseCard project={leadProject} variant="lead" />
          </section>
        )}

        <div class:list={['projects__controls', { 'projects__controls--after-feature': leadProject }]}>
          {topics.length > 0 && (
            <nav class="projects__filter" aria-label="Filter by project topic">
              <Chip label={`All ${all.length}`} href={projectHref({ topic: null, nextPage: 1 })} selected={!activeTopic} />
              {topics.map((topic) => (
                <Chip
                  label={`${topic.name} ${topic.count}`}
                  href={projectHref({ topic: topic.slug, nextPage: 1 })}
                  selected={activeTopic === topic.slug}
                />
              ))}
            </nav>
          )}

          <form class="projects__query-filter" method="get" action="/projects">
            <label for="project-search">Search projects</label>
            {activeTopic && <input type="hidden" name="topic" value={activeTopic} />}
            <div class="projects__query-row">
              <div class="projects__search">
                <Icon name="search" size={16} />
                <input
                  type="search"
                  id="project-search"
                  name="q"
                  value={activeSearch}
                  maxlength="100"
                  placeholder="Search titles, summaries, and topics"
                  autocomplete="off"
                />
              </div>
              <Button type="submit" variant="secondary" size="sm">Search</Button>
            </div>
          </form>
        </div>

        {visible.length === 0 ? (
          <EmptyState
            message={activeSearch ? `No projects match “${activeSearch}”.` : `No projects in “${activeTopic}” yet.`}
            icon="search-x"
            action={{ label: 'Clear filters', href: '/projects' }}
          />
        ) : (
          archiveProjects.length > 0 && (
            <CollectionArchive
              headingId="project-results-heading"
              title={leadProject ? 'More projects' : 'Projects'}
              itemCount={archiveProjects.length}
              singular="project"
              page={page}
              prevHref={prevHref}
              nextHref={nextHref}
            >
              {archiveProjects.map((project) => <CaseCard project={project} variant="row" />)}
            </CollectionArchive>
          )
        )}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .projects {
    padding-block: var(--page-top) var(--page-bottom);
  }

  .projects__count {
    display: block;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .projects__controls {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border-1);
  }

  .projects__controls--after-feature {
    border-top: 1px solid var(--border-1);
  }

  .projects__featured {
    margin-top: var(--space-7);
  }

  .projects__query-filter {
    display: grid;
    gap: var(--space-2);
  }

  .projects__query-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2);
    align-items: stretch;
  }

  .projects__query-filter > label {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .projects__search {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-md);
    background: var(--bg-1);
    color: var(--text-3);
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .projects__search:focus-within {
    border-color: var(--accent);
    color: var(--accent);
  }

  .projects__search input {
    flex: 1;
    min-width: 0;
    padding: var(--space-3) 0;
    background: transparent;
    border: none;
    outline: none;
    color: var(--text-1);
    font-family: var(--font-text);
    font-size: var(--fs-sm);
  }

  .projects__search input::-webkit-search-cancel-button {
    appearance: none;
  }

  .projects__filter {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-bottom: var(--space-1);
    scrollbar-width: thin;
  }

  .projects__filter :global(.ui-chip) {
    flex: 0 0 auto;
  }

  @media (min-width: 64rem) {
    .projects__controls {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
      align-items: end;
    }
  }

</style>
