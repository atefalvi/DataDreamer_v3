---
/**
 * /account (05 §18). Two states:
 *  - Anonymous → a premium onboarding/sign-in page (no dead redirect).
 *  - Signed in → a lightweight learning dashboard: profile + My Guides + progress.
 * noindex; personalized HTML is private/no-store (set below + middleware).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { guidesRepo } from '../lib/repositories';
import { formatMinutes } from '../lib/guides/progress';
import type { AccountGuideProgress, GuideListItem } from '../types/content';
import { userIdentity } from '../lib/auth/identity';
import { allSpecialties, authorForEdit, ownPosts, toolSuggestions } from '../lib/account/authorProfile';
import type { EditableAuthorProfile, OwnPost, SpecialtyOption } from '../lib/account/authorProfile';
import { PUBLIC_DIRECTUS_URL } from '../lib/directus/client';

const user = Astro.locals.user;

// Contributor tabs (v4.3): visible when an authors profile is linked to this account.
const isContributor = Boolean(user?.hasAuthorProfile);
const TABS = ['account', 'guides', 'author', 'posts'] as const;
type Tab = (typeof TABS)[number];
const requestedTab = Astro.url.searchParams.get('tab') as Tab | null;
const tab: Tab = isContributor && requestedTab && TABS.includes(requestedTab) ? requestedTab : 'account';
const savedFlash = Astro.url.searchParams.get('saved') === '1';
const errorFlash = Astro.url.searchParams.get('error') ?? undefined;

let guides: AccountGuideProgress[] = [];
let recommended: GuideListItem | undefined;
let authorProfile: EditableAuthorProfile | undefined;
let specialtyOptions: SpecialtyOption[] = [];
let toolOptions: string[] = [];
let posts: OwnPost[] = [];

if (user) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  const showGuides = !isContributor || tab === 'guides';
  if (showGuides) {
    try {
      guides = await guidesRepo.myGuides(user.id);
    } catch (error) {
      console.error('[account] myGuides failed:', error instanceof Error ? error.message : error);
    }
    if (guides.length === 0) {
      try {
        recommended = (await guidesRepo.latest(1))[0];
      } catch {
        recommended = undefined;
      }
    }
  }
  if (isContributor && tab === 'author' && user.authorId) {
    [authorProfile, specialtyOptions, toolOptions] = await Promise.all([
      authorForEdit(user.authorId).catch(() => undefined),
      allSpecialties().catch(() => []),
      toolSuggestions().catch(() => []),
    ]);
  }
  if (isContributor && tab === 'posts') {
    posts = await ownPosts(user.id).catch(() => []);
  }
}

const directusPostsUrl = `${PUBLIC_DIRECTUS_URL}/admin/content/posts`;
const avatarPreview = authorProfile?.avatarId
  ? `${PUBLIC_DIRECTUS_URL}/assets/${authorProfile.avatarId}?width=96&height=96&fit=cover&format=webp`
  : undefined;
const tabLabel: Record<Tab, string> = {
  account: 'Account',
  guides: 'Guides',
  author: 'Author Profile',
  posts: 'Posts',
};

const inProgress = guides.filter((g) => g.status !== 'completed');
const completed = guides.filter((g) => g.status === 'completed');

const identity = user ? userIdentity(user) : undefined;

const benefits = [
  { icon: 'bookmark', title: 'Save your progress', text: 'Pick up any guide where you left off — your path is remembered.' },
  { icon: 'lock-open', title: 'Unlock the full path', text: 'Open every resource, embed, and the curator’s notes for each step.' },
  { icon: 'compass', title: 'A vetted route', text: 'Follow ordered paths built by practitioners — skip the endless searching.' },
];
---

<BaseLayout
  title={user ? 'My account' : 'Sign in'}
  description="Access guide resources and saved learning progress in your Data Dreamer account."
  noindex
>
  {user ? (
    <div class="account container-content">
      {isContributor && (
        <nav class="account__tabs" aria-label="Account sections">
          {TABS.map((t) => (
            <a
              href={`/account${t === 'account' ? '' : `?tab=${t}`}`}
              class:list={['account__tab', { 'is-active': tab === t }]}
              aria-current={tab === t ? 'page' : undefined}
            >
              {tabLabel[t]}
            </a>
          ))}
        </nav>
      )}

      {(!isContributor || tab === 'account') && (
      <section class="account__profile">
        <span class:list={['account__avatar', { 'has-image': identity?.avatarUrl }]} aria-hidden="true">
          {identity?.avatarUrl ? <img src={identity.avatarUrl} alt="" width="80" height="80" /> : identity?.initials}
        </span>
        <div class="account__id">
          <p class="kicker">Learning profile</p>
          <h1>{identity?.displayName}</h1>
          <p class="account__email">{identity?.secondary}</p>
          <div class="account__status" aria-label="Account status">
            <span><Icon name="badge-check" size={16} /> Guide reader</span>
            {isContributor && <span class="account__badge--contributor"><Icon name="pen-line" size={16} /> Contributor</span>}
            {user.authorDreamTeam && <span class="account__badge--team"><Icon name="check" size={16} /> Dream Team</span>}
            <span><Icon name="shield-check" size={16} /> {identity?.providerLabel}</span>
          </div>
        </div>
        <div class="account__profile-actions">
          <p>Your progress and completed paths stay with this account.</p>
          <form method="post" action="/api/auth/logout" class="account__signout-form">
            <button type="submit" class="account__signout"><Icon name="log-out" size={16} /> Sign out</button>
          </form>
        </div>
      </section>
      )}

      {(!isContributor || tab === 'guides') && (guides.length === 0 ? (
        <section class="account__start">
          <div class="account__start-copy">
            <p class="kicker">Begin a path</p>
            <h2>{recommended?.title ?? 'Your first guide is waiting.'}</h2>
            <p>
              {recommended?.summary ?? 'Choose a Field Guide and this page will become your resume point, progress record, and completed-path archive.'}
            </p>
          </div>
          {recommended && (
            <dl class="account__start-facts">
              <div><dt>Level</dt><dd>{recommended.difficulty}</dd></div>
              <div><dt>Resources</dt><dd>{recommended.itemCount}</dd></div>
              <div><dt>Time</dt><dd>{recommended.estimatedMinutes ? `~${formatMinutes(recommended.estimatedMinutes)}` : 'Self-paced'}</dd></div>
            </dl>
          )}
          <a href={recommended ? `/guides/${recommended.slug}` : '/guides'} class="account__start-cta">
            {recommended ? 'Preview this guide' : 'Browse guides'} <Icon name="arrow-right" size={16} />
          </a>
        </section>
      ) : (
        <>
          {inProgress.length > 0 && (
            <section class="account__section" aria-label="In progress">
              <h2 class="account__h2">Continue learning</h2>
              <ul class="account__list">
                {inProgress.map((g) => (
                  <li class="account-row">
                    <div class="account-row__main">
                      <a href={`/guides/${g.slug}`} class="account-row__title">{g.title}</a>
                      <div class="account-row__bar"><span style={`width:${g.percent}%`}></span></div>
                    </div>
                    <span class="account-row__pct">{g.percent}%</span>
                    <a href={`/guides/${g.slug}`} class="account-row__cta">Continue →</a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {completed.length > 0 && (
            <section class="account__section" aria-label="Completed">
              <h2 class="account__h2">Completed</h2>
              <ul class="account__list">
                {completed.map((g) => (
                  <li class="account-row account-row--done">
                    <span class="account-row__check" aria-hidden="true">✓</span>
                    <a href={`/guides/${g.slug}`} class="account-row__title">{g.title}</a>
                    <a href={`/guides/${g.slug}`} class="account-row__cta">Review →</a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      ))}

      {isContributor && tab === 'author' && (
        <section class="account__section author-editor" aria-label="Author profile">
          <div class="author-editor__head">
            <h2 class="account__h2">Your public author profile</h2>
            <p class="author-editor__sub">
              This is what readers see on your byline{authorProfile?.dreamTeam ? ' and Dream Team page' : ''}.
              {authorProfile?.slug && authorProfile?.dreamTeam && (
                <> View it at <a href={`/dream-team/${authorProfile.slug}`}>/dream-team/{authorProfile.slug}</a>.</>
              )}
              Publishing, Dream Team visibility, and your URL are managed by the site admin.
            </p>
          </div>

          {savedFlash && <p class="account__flash account__flash--ok" role="status">Profile saved.</p>}
          {errorFlash && <p class="account__flash account__flash--err" role="alert">{errorFlash}</p>}

          {!authorProfile ? (
            <p class="author-editor__pending">
              Author profile setup pending — ask the site admin to complete your approval.
            </p>
          ) : (
            <form method="post" action="/api/account/author" enctype="multipart/form-data" class="author-form">
              <div class="author-form__grid">
                <label class="author-form__field">
                  <span>Display name</span>
                  <input name="display_name" value={authorProfile.displayName} required minlength="2" maxlength="80" />
                </label>
                <label class="author-form__field">
                  <span>Role title</span>
                  <input name="role_title" value={authorProfile.roleTitle} maxlength="80" placeholder="e.g. People Analytics Lead" />
                </label>
              </div>

              <div class="author-form__grid">
                <label class="author-form__field">
                  <span>Profile URL <em>(your public address)</em></span>
                  <input
                    name="slug"
                    value={authorProfile.slug}
                    minlength="3"
                    maxlength="60"
                    pattern="[a-z0-9]+(-[a-z0-9]+)*"
                    title="Lowercase letters, numbers, and single dashes"
                  />
                  <small class="author-form__hint">data-dreamer.net/dream-team/<strong>{authorProfile.slug}</strong> — changing it moves your page.</small>
                </label>
                <label class="author-form__field">
                  <span>Avatar <em>(square JPEG/PNG/WebP, max 5 MB)</em></span>
                  <div class="author-form__avatar-row">
                    {avatarPreview ? (
                      <img class="author-form__avatar" src={avatarPreview} alt="Current avatar" width="48" height="48" />
                    ) : (
                      <span class="author-form__avatar author-form__avatar--empty" aria-hidden="true">—</span>
                    )}
                    <input type="file" name="avatar_file" accept="image/jpeg,image/png,image/webp" />
                  </div>
                </label>
              </div>

              <label class="author-form__field">
                <span>Bio <em>(markdown supported)</em></span>
                <textarea name="bio" rows="6" maxlength="6000">{authorProfile.bio}</textarea>
              </label>

              <label class="author-form__field">
                <span>Statement <em>(one line under your name)</em></span>
                <textarea name="statement" rows="2" maxlength="600">{authorProfile.statement}</textarea>
              </label>

              <div class="author-form__grid">
                <label class="author-form__field">
                  <span>Links <em>(one per line: Label | https://url)</em></span>
                  <textarea name="links" rows="3" placeholder="LinkedIn | https://linkedin.com/in/you">{authorProfile.linksText}</textarea>
                </label>
                <div class="author-form__field" data-tools-widget>
                  <span>Tools <em>(pick from the shared list or add your own)</em></span>
                  <div class="author-form__picker">
                    <input type="text" list="tool-suggestions" data-tool-search placeholder="Search or type a tool…" />
                    <button type="button" class="author-form__add" data-tool-add>Add</button>
                  </div>
                  <datalist id="tool-suggestions">
                    {toolOptions.map((tool) => <option value={tool} />)}
                  </datalist>
                  <div class="author-form__chips" data-tool-chips aria-live="polite"></div>
                  <label class="author-form__field">
                    <span class="visually-hidden">Tools as a comma-separated list</span>
                    <input name="tools" value={authorProfile.toolsText} data-tools-value placeholder="Excel, HRIS, People Metrics" />
                  </label>
                  <small class="author-form__hint">Matching an existing tool keeps names consistent (e.g. "excel" becomes "Excel").</small>
                </div>
              </div>

              <label class="author-form__field">
                <span>Featured work <em>(max 2, one per line: Title | https://url | description)</em></span>
                <textarea name="featured_work" rows="2">{authorProfile.featuredWorkText}</textarea>
              </label>

              <fieldset class="author-form__specialties" data-specialties-widget>
                <legend>Specialties</legend>
                <p class="author-form__hint">These power your Dream Team profile and the network graph — pick everything that fits.</p>
                {specialtyOptions.length > 6 && (
                  <input type="text" class="author-form__filter" data-specialty-filter placeholder={`Filter ${specialtyOptions.length} specialties…`} />
                )}
                <div class="author-form__checks author-form__checks--scroll">
                  {specialtyOptions.map((s) => (
                    <label class="author-form__check" data-specialty-name={s.name.toLowerCase()}>
                      <input
                        type="checkbox"
                        name="specialties"
                        value={s.id}
                        checked={authorProfile.specialtyIds.includes(s.id)}
                      />
                      <span>{s.name}</span>
                    </label>
                  ))}
                </div>
                <label class="author-form__field author-form__new">
                  <span>Not listed? Add new <em>(comma separated — existing names are matched, not duplicated)</em></span>
                  <input name="new_specialties" placeholder="e.g. Workforce Planning, HR Tech" />
                </label>
              </fieldset>

              <div class="author-form__foot">
                <p class="author-form__note">
                  Changes to your name, bio, links, tools, and specialties go live immediately.
                </p>
                <button type="submit" class="author-form__save">Save profile</button>
              </div>
            </form>
          )}
        </section>
      )}

      {isContributor && tab === 'posts' && (
        <section class="account__section" aria-label="Your posts">
          <div class="author-editor__head">
            <h2 class="account__h2">Your posts</h2>
            <p class="author-editor__sub">
              Posts are written in the Directus studio — sign in there with the same account
              you use here. Write in draft, then submit with <strong>In review</strong> when it is ready for an administrator to publish.
            </p>
          </div>

          <ul class="account__list">
            {posts.map((p) => (
              <li class="account-row">
                <div class="account-row__main">
                  {p.status === 'published' ? (
                    <a href={`/blog/${p.slug}`} class="account-row__title">{p.title}</a>
                  ) : (
                    <span class="account-row__title">{p.title}</span>
                  )}
                </div>
                <span class:list={['post-status', `post-status--${p.status}`]}>{p.status.replace('_', ' ')}</span>
                <a href={`${directusPostsUrl}/${p.id}`} class="account-row__cta" rel="noopener" target="_blank">Edit →</a>
              </li>
            ))}
            {posts.length === 0 && (
              <li class="author-editor__pending">No posts yet — your first draft is a click away.</li>
            )}
          </ul>

          <a class="account__start-cta account__section-cta" href={`${directusPostsUrl}/+`} rel="noopener" target="_blank">
            Write a new post in Directus <Icon name="arrow-right" size={16} />
          </a>
        </section>
      )}
    </div>
  ) : (
    <div class="account account--onboard container-content">
      <section class="onboard">
        <p class="kicker">Guides</p>
        <h1 class="onboard__title">Your learning, saved.</h1>
        <p class="onboard__lede">
          Create a free account to open every guide, track your progress across the path,
          and pick up exactly where you left off.
        </p>
        <div class="onboard__actions">
          <a class="onboard__cta" href="/login?next=%2Faccount">Sign in</a>
          <a class="onboard__ghost" href="/guides">Browse guides<span aria-hidden="true">→</span></a>
        </div>
        <ul class="onboard__benefits">
          {benefits.map((b) => (
            <li>
              <span class="onboard__benefit-icon"><Icon name={b.icon} size={20} /></span>
              <div>
                <strong>{b.title}</strong>
                <p>{b.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </div>
  )}
</BaseLayout>


<script>
  // Tools chip picker — enhances the plain comma-list input (which stays functional
  // without JS and remains the submitted field).
  const widget = document.querySelector<HTMLElement>('[data-tools-widget]');
  if (widget) {
    const valueInput = widget.querySelector<HTMLInputElement>('[data-tools-value]');
    const search = widget.querySelector<HTMLInputElement>('[data-tool-search]');
    const addBtn = widget.querySelector<HTMLButtonElement>('[data-tool-add]');
    const chips = widget.querySelector<HTMLElement>('[data-tool-chips]');
    if (valueInput && search && addBtn && chips) {
      const read = () => valueInput.value.split(',').map((t) => t.trim()).filter(Boolean);
      const write = (tools: string[]) => {
        valueInput.value = tools.join(', ');
        chips.innerHTML = '';
        for (const tool of tools) {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'author-form__chip';
          chip.innerHTML = `${tool} <span aria-hidden="true">×</span>`;
          chip.setAttribute('aria-label', `Remove ${tool}`);
          chip.addEventListener('click', () => write(read().filter((t) => t !== tool)));
          chips.appendChild(chip);
        }
      };
      const add = () => {
        const tool = search.value.trim();
        if (!tool) return;
        const tools = read();
        if (!tools.some((t) => t.toLowerCase() === tool.toLowerCase())) tools.push(tool);
        write(tools);
        search.value = '';
        search.focus();
      };
      addBtn.addEventListener('click', add);
      search.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') { event.preventDefault(); add(); }
      });
      valueInput.addEventListener('change', () => write(read()));
      write(read());
      valueInput.closest('label')?.classList.add('author-form__source--enhanced');
    }
  }

  // Specialty filter — hides non-matching checkboxes as the list grows.
  const filter = document.querySelector<HTMLInputElement>('[data-specialty-filter]');
  if (filter) {
    filter.addEventListener('input', () => {
      const query = filter.value.trim().toLowerCase();
      for (const label of document.querySelectorAll<HTMLElement>('[data-specialty-name]')) {
        const matches = !query || (label.dataset.specialtyName ?? '').includes(query);
        label.style.display = matches ? '' : 'none';
      }
    });
  }
</script>

<style>
  .account {
    padding-block: var(--page-top) var(--page-bottom);
    max-width: 52rem;
  }

  /* ── Signed-in dashboard ── */
  .account__profile {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(11rem, 15rem);
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    background: var(--bg-1);
  }

  .account__avatar {
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--text-on-accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xl);
    font-weight: 700;
    overflow: hidden;
  }

  .account__avatar.has-image { background: var(--bg-2); }
  .account__avatar img { width: 100%; height: 100%; object-fit: cover; }

  .account__id {
    flex: 1;
    min-width: 0;
  }

  .account__id h1 {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .account__email {
    margin-top: var(--space-1);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
  }

  .account__status {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .account__status span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 1.75rem;
    padding-inline: var(--space-2);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border-1));
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .account__profile-actions {
    display: grid;
    justify-items: end;
    gap: var(--space-3);
    padding-left: var(--space-5);
    border-left: 1px solid var(--border-1);
  }

  .account__profile-actions > p {
    color: var(--text-3);
    font-size: var(--fs-xs);
    line-height: var(--lh-sm);
    text-align: right;
  }

  .account__signout-form { margin: 0; }

  .account__signout {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text-2);
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
  }

  .account__signout:hover {
    border-color: var(--danger);
    color: var(--text-1);
  }

  .account__section { margin-top: var(--space-8); }

  .account__start {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-4);
    padding: var(--space-7);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    background: var(--bg-1);
  }

  .account__start-copy h2 {
    max-width: 22ch;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
    font-weight: 560;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .account__start-copy > p:last-child {
    max-width: 52ch;
    margin-top: var(--space-3);
    color: var(--text-2);
    line-height: var(--lh-base);
  }

  .account__start-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-block: 1px solid var(--border-1);
  }

  .account__start-facts div {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-4);
  }

  .account__start-facts div + div {
    padding-inline-start: var(--space-4);
    border-left: 1px solid var(--border-1);
  }

  .account__start-facts dt,
  .account__start-facts dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  .account__start-facts dt { color: var(--text-3); text-transform: uppercase; }
  .account__start-facts dd { color: var(--text-1); text-transform: capitalize; }

  .account__start-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: fit-content;
    min-height: 2.875rem;
    padding-inline: var(--space-5);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: var(--fs-sm);
    font-weight: 650;
    text-decoration: none;
    box-shadow: 0 10px 26px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .account__start-cta:hover { background: var(--accent-hover); color: var(--text-on-accent); }

  .account__h2 {
    font-family: var(--font-text);
    font-size: var(--fs-lg);
    font-weight: 650;
    color: var(--text-2);
