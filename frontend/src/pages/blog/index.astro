---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListing from '../../components/blog/BlogListing.astro';
import { absoluteUrl, SITE_URL } from '../../lib/seo/meta';
import { blogPath, emptyBlogListing, loadBlogListing } from '../../lib/blog/listing';

const author = Astro.url.searchParams.get('author') || undefined;
let listing = emptyBlogListing({ author });
try {
  listing = await loadBlogListing({ author });
} catch (error) {
  console.error('[blog] listing unavailable:', error instanceof Error ? error.message : error);
}
const description =
  'Field notes from DataDreamer on data systems, applied AI, analytics craft, and engineering judgment.';
const nextHref = listing.page.hasMore ? absoluteUrl(blogPath(2)) : undefined;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'DataDreamer Writing',
    url: `${SITE_URL}/blog`,
    description,
  },
];
---

<BaseLayout
  title="Writing"
  description={description}
  ogType="website"
  ogImage={{ url: '/og/og-blog.png' }}
  alternateFeeds={[{ href: absoluteUrl('/rss.xml'), title: 'DataDreamer RSS', type: 'application/rss+xml' }]}
  pagination={nextHref ? { next: nextHref } : undefined}
  jsonLd={jsonLd}
>
  <BlogListing
    kicker="The blog"
    title="Writing"
    intro={description}
    listing={listing}
    pageBasePath="/blog"
  />
</BaseLayout>
