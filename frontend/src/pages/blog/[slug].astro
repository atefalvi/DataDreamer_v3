---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleEnhancements from '../../components/blog/ArticleEnhancements.astro';
import ArticleToc from '../../components/blog/ArticleToc.astro';
import AuthorBlock from '../../components/blog/AuthorBlock.astro';
import BlogListing from '../../components/blog/BlogListing.astro';
import PostCard from '../../components/blog/PostCard.astro';
import ReadingProgress from '../../components/blog/ReadingProgress.astro';
import { authorsRepo, postsRepo } from '../../lib/repositories';
import { absoluteUrl } from '../../lib/seo/meta';
import { blogPostingJsonLd, breadcrumbListJsonLd, wordCountFromHtml } from '../../lib/seo/jsonld';
import { blogPath, emptyBlogListing, loadBlogListing, parsePaginationPage, withListingFilters, type BlogListing as BlogListingData } from '../../lib/blog/listing';
import { directusSrcset } from '../../lib/images';
import { publicAuthorProfilePath, writingAuthorPath } from '../../lib/authors/publicProfile';
import '../../styles/prose.css';
import type { Author, Post, PostListItem } from '../../types/content';
import type { OgImage } from '../../lib/seo/meta';

const slug = Astro.params.slug;

if (!slug) {
  return Astro.rewrite('/404');
}

const description =
  'Structured reflections, practical lessons, useful tools, and lived experience from learning, building, and explaining data systems in the real world.';
const parsedPage = parsePaginationPage(slug);
const isPagination = parsedPage !== undefined;
const numericPage = parsedPage ?? 0;

let view: 'pagination' | 'article' = 'article';
let listing: BlogListingData | null = null;
let paginationPrev: string | undefined;
let paginationNext: string | undefined;

let post: Post | null = null;
let author: Author | null = null;
let related: PostListItem[] = [];
let canonical = '';
let dateLabel = '';
let shortDate = '';
let topicNames: string[] = [];
let cover: Post['coverImage'];
let ogImage: OgImage = { url: '/og/og-blog.png' };
let jsonLd: object[] = [];
let hasImageGrid = false;
let hasRelated = false;
let authorHref: string | undefined;

if (isPagination) {
  if (numericPage === 1) {
    return Astro.redirect('/blog', 301);
  }

  view = 'pagination';
  const activeAuthor = Astro.url.searchParams.get('author') || undefined;
  const activeSearch = Astro.url.searchParams.get('q') || undefined;
  listing = emptyBlogListing({ author: activeAuthor, search: activeSearch, page: numericPage });
  try {
    listing = await loadBlogListing({ author: activeAuthor, search: activeSearch, page: numericPage });
  } catch (error) {
    console.error('[blog] paginated listing unavailable:', error instanceof Error ? error.message : error);
  }

  if (!listing.page.items.length) {
    return Astro.rewrite('/404');
  }

  paginationPrev = absoluteUrl(withListingFilters(blogPath(numericPage - 1), { author: activeAuthor, search: activeSearch }));
  paginationNext = listing.page.hasMore
    ? absoluteUrl(withListingFilters(blogPath(numericPage + 1), { author: activeAuthor, search: activeSearch }))
    : undefined;
} else {
  post = await postsRepo.bySlug(slug);

  if (!post) {
    return Astro.rewrite('/404');
  }

  try {
    [author, related] = await Promise.all([
      authorsRepo.bySlug(post.author.slug, Astro.locals),
      postsRepo.related(post, 3),
    ]);
  } catch (error) {
    console.error('[blog] article secondary content unavailable:', error instanceof Error ? error.message : error);
  }

  canonical = absoluteUrl(`/blog/${post.slug}`);
  dateLabel = post.publishedAt.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
  shortDate = post.publishedAt.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
  topicNames = post.topics.map((topic) => topic.name);
  authorHref = publicAuthorProfilePath(post.author) ?? writingAuthorPath(post.author);
  cover = post.coverImage;
  // Dynamic branded OG card (title + author avatar + main topic) for every article.
  ogImage = {
    url: `/og/blog/${post.slug}.png`,
    alt: post.title,
    type: 'image/png',
    width: 1200,
    height: 630,
  };
  const articleJsonLd = blogPostingJsonLd({
    headline: post.title,
    description: post.seoDescription ?? post.excerpt,
    url: canonical,
    datePublished: post.publishedAt.toISOString(),
    dateModified: post.updatedAt?.toISOString(),
    author: {
      name: post.author.name,
      url: publicAuthorProfilePath(post.author),
      image: post.author.avatar?.src,
    },
    image: cover ? ogImage.url : undefined,
    keywords: topicNames,
    wordCount: wordCountFromHtml(post.bodyHtml),
  });
  const breadcrumbJsonLd = breadcrumbListJsonLd([
    { label: 'Posts', href: '/blog' },
    { label: post.title },
  ]);
  jsonLd = [articleJsonLd, breadcrumbJsonLd];
  hasImageGrid = post.hasImageGrid;
  hasRelated = related.length > 0;
}
---

{view === 'pagination' && listing ? (
  <BaseLayout
    title={`Posts page ${numericPage}`}
    description={description}
    canonical={absoluteUrl(blogPath(numericPage))}
    ogType="website"
    ogImage={{ url: '/og/og-blog.png' }}
    alternateFeeds={[{ href: absoluteUrl('/rss.xml'), title: 'Data Dreamer RSS', type: 'application/rss+xml' }]}
    pagination={{ prev: paginationPrev, next: paginationNext }}
    noindex={Boolean(listing.activeSearch)}
  >
    <BlogListing
      kicker="Posts"
      title="Posts"
      intro={description}
      listing={listing}
      pageBasePath="/blog"
    />
  </BaseLayout>
) : post && (
  <BaseLayout
    title={post.seoTitle ?? post.title}
    description={post.seoDescription ?? post.excerpt}
    canonical={canonical}
    ogType="article"
    ogImage={ogImage}
    article={{
      publishedTime: post.publishedAt.toISOString(),
      modifiedTime: post.updatedAt?.toISOString(),
      author: post.author.name,
      tags: topicNames,
    }}
    jsonLd={jsonLd}
    noindex={post.noindex}
  >
    <ReadingProgress />

    <article class="article-page" data-article>
      <header class:list={['article-hero', { 'article-hero--visual': cover }] }>
        {cover && (
          <div class="article-hero__cover">
            <img
              src={cover.src}
              srcset={directusSrcset(cover.id, [720, 1100, 1600, 2200])}
              sizes="(min-width: 80rem) 1184px, calc(100vw - 32px)"
              width={cover.width}
              height={cover.height}
              alt={cover.alt}
              loading="eager"
              decoding="async"
            />
          </div>
        )}

        <div class="article-hero__meta">
          <a href="/blog">Posts</a>
          {post.seriesLabel && <span>{post.seriesLabel}</span>}
          <time datetime={post.publishedAt.toISOString()}>{shortDate}</time>
        </div>

        <div class="article-hero__grid">
          <div>
            <p class="article-hero__kicker">Post</p>
            <h1>{post.title}</h1>
            <p class="article-hero__dek">{post.excerpt}</p>
          </div>

          <aside class="article-hero__aside" aria-label="Article metadata">
            <dl>
              <div>
                <dt>Author</dt>
                <dd>{authorHref ? <a href={authorHref}>{post.author.name}</a> : post.author.name}</dd>
              </div>
              <div>
                <dt>Published</dt>
                <dd>{dateLabel}</dd>
              </div>
              <div>
                <dt>Read</dt>
                <dd>{post.readingMinutes} min</dd>
              </div>
            </dl>
            {post.topics.length > 0 && (
              <ul aria-label="Topics">
                {post.topics.map((topic) => (
                  <li><a href={`/topics/${topic.slug}`}>{topic.name}</a></li>
                ))}
              </ul>
            )}
          </aside>
        </div>

      </header>

      <div class="article-shell">
        <aside class="article-shell__toc">
          <ArticleToc headings={post.headings} />
        </aside>

        <div class="article-shell__body">
          <div class="blog-content article-prose" data-article-prose set:html={post.bodyHtml} />
          <ArticleEnhancements hasImageGrid={hasImageGrid} />
        </div>

        {author && (
          <footer class="article-footer">
            <AuthorBlock author={author} />
          </footer>
        )}

        {hasRelated && (
          <section class="article-related" aria-labelledby="related-heading">
            <div class="article-related__header">
              <p>Continue reading</p>
              <h2 id="related-heading">Related posts</h2>
            </div>
            <div class="article-related__grid">
              {related.map((item) => <PostCard post={item} variant="card" />)}
            </div>
          </section>
        )}
      </div>
    </article>
  </BaseLayout>
)}

<style>
  .article-page {
    padding: var(--page-top) var(--space-4) var(--page-bottom);
  }

  .article-hero,
  .article-shell,
  .article-footer,
  .article-related {
    width: min(100%, 74rem);
    margin-inline: auto;
  }

  .article-hero {
    position: relative;
    isolation: isolate;
  }

  .article-hero--visual {
    display: flex;
    min-height: clamp(34rem, 55vw, 42rem);
    overflow: hidden;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(var(--space-6), 6vw, var(--space-8));
    border: 1px solid var(--border-1);
    border-radius: var(--radius-lg);
    background: var(--bg-1);
  }

  .article-hero--visual::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--bg-0) 96%, transparent) 0%, color-mix(in srgb, var(--bg-0) 83%, transparent) 58%, color-mix(in srgb, var(--bg-0) 42%, transparent) 100%),
      linear-gradient(0deg, color-mix(in srgb, var(--bg-0) 96%, transparent) 0%, transparent 78%);
    content: '';
  }

  .article-hero__cover {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .article-hero__cover img {
    display: block;
    width: 100%;
    height: 100%;
    filter: saturate(0.55) brightness(0.7) contrast(0.94);
    object-fit: cover;
    transform: scale(1.015);
  }

  .article-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .article-hero__meta a {
    color: var(--accent);
    text-decoration: none;
  }

  .article-hero__meta span::before,
  .article-hero__meta time::before {
    margin-inline-end: var(--space-3);
    color: var(--border-2);
    content: '/';
  }

  .article-hero__grid {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-5);
  }

  .article-hero--visual .article-hero__grid {
    width: 100%;
  }

  .article-hero__kicker {
    margin: 0 0 var(--space-4);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 650;
    text-transform: uppercase;
  }

  .article-hero h1 {
    max-width: 19ch;
    font-family: var(--font-display);
    font-size: var(--fs-display);
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: var(--lh-display);
    text-wrap: balance;
  }

  .article-hero__dek {
    max-width: 50rem;
    margin-top: var(--space-5);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
    text-wrap: pretty;
  }

  .article-hero__aside {
    align-self: end;
    padding: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--border-2) 72%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--bg-1) 72%, transparent);
  }

  .article-hero--visual .article-hero__aside {
    background: color-mix(in srgb, var(--bg-0) 82%, transparent);
  }

  .article-hero__aside dl {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .article-hero__aside div {
    display: grid;
    gap: var(--space-1);
  }

  .article-hero__aside dt {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .article-hero__aside dd {
    margin: 0;
    color: var(--text-1);
    font-size: var(--fs-sm);
    font-weight: 650;
  }

  .article-hero__aside ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .article-hero__aside a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    padding-inline: var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-full);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-decoration: none;
  }

  .article-shell {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-8);
  }

  .article-shell__toc {
    min-width: 0;
  }

  .article-shell__body {
    min-width: 0;
  }

  .article-prose {
    width: min(100%, 46rem);
  }

  .article-footer {
    grid-column: 1 / -1;
    margin-top: var(--space-9);
  }

  .article-related {
    grid-column: 1 / -1;
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-1);
  }

  .article-related__header p {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 650;
    text-transform: uppercase;
  }

  .article-related__header h2 {
    margin-top: var(--space-2);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
  }

  .article-related__grid {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (min-width: 64rem) {
    .article-page {
      padding-inline: var(--space-6);
    }

    .article-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
      align-items: end;
    }

    .article-shell {
      grid-template-columns: minmax(13rem, 17rem) minmax(0, 1fr);
      align-items: start;
    }

    .article-shell__toc {
      align-self: start;
      min-width: 0;
      height: 100%;
    }
  }

  @media (max-width: 47.999rem) {
    .article-page {
      padding-inline: var(--space-4);
    }

    .article-hero__dek {
      font-size: var(--fs-base);
      line-height: var(--lh-base);
    }

    .article-hero__aside {
      padding: var(--space-4);
    }

    .article-hero--visual {
      min-height: 36rem;
      padding: var(--space-5);
    }

    .article-hero--visual::after {
      background: linear-gradient(0deg, color-mix(in srgb, var(--bg-0) 98%, transparent) 0%, color-mix(in srgb, var(--bg-0) 86%, transparent) 72%, color-mix(in srgb, var(--bg-0) 56%, transparent) 100%);
    }
  }

  @media (max-width: 63.999rem) {
    .article-related__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.999rem) {
    .article-related__grid {
      grid-template-columns: 1fr;
    }

    .article-hero h1 {
      font-size: var(--fs-4xl);
      line-height: var(--lh-4xl);
    }

  }
</style>
