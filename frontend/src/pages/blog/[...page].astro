---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogListing from '../../components/blog/BlogListing.astro';
import { absoluteUrl } from '../../lib/seo/meta';
import { blogPath, emptyBlogListing, loadBlogListing } from '../../lib/blog/listing';

const rawPage = Astro.params.page;
const page = rawPage ? Number(rawPage) : 1;

if (!rawPage || !Number.isInteger(page) || page < 1) {
  return Astro.rewrite('/404');
}

if (page === 1) {
  return Astro.redirect('/blog', 301);
}

const author = Astro.url.searchParams.get('author') || undefined;
let listing = emptyBlogListing({ author, page });
try {
  listing = await loadBlogListing({ author, page });
} catch (error) {
  console.error('[blog] paginated listing unavailable:', error instanceof Error ? error.message : error);
}

if (!listing.page.items.length) {
  return Astro.rewrite('/404');
}

const description =
  'Field notes from DataDreamer on data systems, applied AI, analytics craft, and engineering judgment.';
const prev = absoluteUrl(blogPath(page - 1));
const next = listing.page.hasMore ? absoluteUrl(blogPath(page + 1)) : undefined;
---

<BaseLayout
  title={`Writing page ${page}`}
  description={description}
  canonical={absoluteUrl(blogPath(page))}
  ogType="website"
  ogImage={{ url: '/og/og-blog.png' }}
  alternateFeeds={[{ href: absoluteUrl('/rss.xml'), title: 'DataDreamer RSS', type: 'application/rss+xml' }]}
  pagination={{ prev, next }}
>
  <BlogListing
    kicker="The blog"
    title="Writing"
    intro={description}
    listing={listing}
    pageBasePath={blogPath(page)}
  />
</BaseLayout>
