---
/**
 * V4-GUIDE-005 — Field Guide `/guides/[slug]` (05 §15). One route, two states:
 *  - Anonymous: public preview (hero, why/outcome, syllabus) + sign-in CTA. Indexable.
 *  - Authenticated guide reader: full curated path with per-item content, curator
 *    annotations, and server-backed progress.
 * Items render inline — there is no per-item route.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideHero from '../../components/guides/GuideHero.astro';
import GuideAccessPanel from '../../components/guides/GuideAccessPanel.astro';
import GuideSection from '../../components/guides/GuideSection.astro';
import Avatar from '../../components/ui/Avatar.astro';
import { guidesRepo } from '../../lib/repositories';
import { deriveGuideProgress, flattenItems } from '../../lib/guides/progress';
import { creativeWorkJsonLd, breadcrumbListJsonLd } from '../../lib/seo/jsonld';
import { publicAuthorProfilePath } from '../../lib/authors/publicProfile';
import '../../styles/prose.css';
import type { Guide, GuideListItem, DerivedGuideProgress, StoredGuideProgress } from '../../types/content';

const { slug } = Astro.params;
const user = Astro.locals.user;
const signedIn = Boolean(user);

let guide: Guide | null = null;
let stored: StoredGuideProgress | null = null;
try {
  guide = user
    ? await guidesRepo.readerBySlug(slug!, user.accessToken)
    : await guidesRepo.previewBySlug(slug!);
  if (guide && user) {
    stored = await guidesRepo.progressFor(guide.id, user.id);
  }
} catch (error) {
  console.error('[guide] load failed:', error instanceof Error ? error.message : error);
}

if (!guide) {
  return Astro.rewrite('/404');
}

const ogVersion = `3-${guide.updatedAt?.getTime() ?? guide.publishedAt?.getTime() ?? 'base'}`;

// Authenticated responses must not be edge-cached (09 §8).
if (signedIn) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}

const progress: DerivedGuideProgress | undefined = signedIn
  ? deriveGuideProgress(guide, stored)
  : undefined;
const completedIds = new Set(stored?.completedItemIds ?? []);

// Embedded item list for the reader enhancer's instant, server-identical math.
const readerData = signedIn
  ? { slug: guide.slug, items: flattenItems(guide).map((i) => ({ id: i.id, estimatedMinutes: i.estimatedMinutes })) }
  : null;

// Related guides — shared topic, fallback latest. Decorative; never fails the page.
let related: GuideListItem[] = [];
try {
  const { items } = await guidesRepo.list({ pageSize: 7 });
  const topicSlugs = new Set(guide.topics.map((t) => t.slug));
  const pool = items.filter((g) => g.slug !== guide!.slug);
  const byTopic = pool.filter((g) => g.topics.some((t) => topicSlugs.has(t.slug)));
  related = (byTopic.length ? byTopic : pool).slice(0, 3);
} catch {
  related = [];
}

const jsonLd = [
  creativeWorkJsonLd({
    name: guide.title,
    description: guide.seoDescription ?? guide.summary,
    datePublished: guide.publishedAt?.toISOString(),
    url: `/guides/${guide.slug}`,
    keywords: guide.topics.map((t) => t.name),
    image: guide.coverImage?.src,
    author: {
      name: guide.curator.name,
      url: publicAuthorProfilePath(guide.curator),
      image: guide.curator.avatar?.src,
    },
  }),
  breadcrumbListJsonLd([
    { label: 'Guides', href: '/guides' },
    { label: guide.title },
  ]),
];
---

<BaseLayout
  title={guide.seoTitle ?? guide.title}
  description={guide.seoDescription ?? guide.summary}
  ogType="article"
  ogImage={{ url: `/og/guides/${guide.slug}.png?v=${ogVersion}`, alt: guide.title, type: 'image/png', width: 1200, height: 630 }}
  jsonLd={jsonLd}
  noindex={guide.noindex}
>
  <article class="guide container-content">
    <GuideHero guide={guide} />
    <div class="guide__column">
      <GuideAccessPanel guide={guide} signedIn={signedIn} progress={progress} />

    {(guide.whyThisPathHtml || guide.expectedOutcomeHtml || guide.recommendedAudience) && (
      <section class="guide__intro">
        {guide.whyThisPathHtml && (
          <div class="guide__intro-block">
            <p class="kicker">Why this path</p>
            <div class="prose" set:html={guide.whyThisPathHtml} />
          </div>
        )}
        {guide.expectedOutcomeHtml && (
          <div class="guide__intro-block">
            <p class="kicker">What you'll get</p>
            <div class="prose" set:html={guide.expectedOutcomeHtml} />
          </div>
        )}
        {guide.recommendedAudience && (
          <p class="guide__audience">
            <span class="guide__audience-label">Who it's for</span>
            {guide.recommendedAudience}
          </p>
        )}
      </section>
    )}

    <div class="guide__path">
      <header class="guide__path-head">
        <div>
          <p class="kicker">The learning path</p>
          <h2>{guide.sections.length} {guide.sections.length === 1 ? 'stage' : 'stages'}, in a deliberate order.</h2>
        </div>
        <p>
          {signedIn
            ? 'Mark each resource as you finish it. Your next step stays synchronized with your account.'
            : 'The complete route is visible below. Sign in to open the resources and curator notes.'}
        </p>
      </header>
      {guide.sections.map((section, i) => (
        <GuideSection section={section} index={i} completedIds={signedIn ? completedIds : undefined} />
      ))}
    </div>

    {guide.curators.length > 0 && (
      <section class="guide__curators" aria-label="Curators">
        <p class="kicker">{guide.curators.length > 1 ? 'Curated by' : 'Curator'}</p>
        <div class="guide__curators-grid">
          {guide.curators.map((curator) => {
            const href = publicAuthorProfilePath(curator);
            const CuratorTag = href ? 'a' : 'div';
            return (
              <CuratorTag href={href} class="guide__curator-card">
                <Avatar src={curator.avatar?.src} name={curator.name} size={48} />
                <span class="guide__curator-name">{curator.name}</span>
              </CuratorTag>
            );
          })}
        </div>
      </section>
    )}

    {related.length > 0 && (
      <section class="guide__related" aria-labelledby="related-guides-heading">
        <p class="kicker">Continue learning</p>
        <h2 id="related-guides-heading">Related guides</h2>
        <ul class="guide__related-list">
          {related.map((g) => (
            <li>
              <a href={`/guides/${g.slug}`}>
                <span class="guide__related-title">{g.title}</span>
                <span class="guide__related-meta">{g.itemCount} resources · {g.difficulty}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    </div>
  </article>

  {readerData && (
    <script type="application/json" id="guide-progress-data" is:inline set:html={JSON.stringify(readerData)} />
  )}
</BaseLayout>

<script>
  // No-ops on the public preview (no progress panel / no code blocks).
  import { initGuideReader } from '../../lib/guides/reader';
  import { initCodeCopy } from '../../lib/markdown/codeCopy';
  initGuideReader();
  initCodeCopy();
</script>

<style>
  .guide {
    padding-block: var(--page-top) var(--page-bottom);
  }

  .guide__column {
    width: min(100%, 62rem);
    margin-inline: auto;
  }

  .guide__intro {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-7);
    border-top: 1px solid var(--border-1);
  }

  .guide__intro-block .kicker {
    margin-bottom: var(--space-3);
  }

  .guide__intro-block .prose {
    color: var(--text-2);
    font-size: var(--fs-base);
  }

  .guide__audience {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    background: var(--bg-1);
    border: 1px solid var(--border-1);
    color: var(--text-2);
    font-size: var(--fs-sm);
  }

  .guide__audience-label {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .guide__path {
    margin-top: var(--space-9);
  }

  .guide__path-head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
    padding-block: var(--space-6);
    border-block: 1px solid var(--border-2);
  }

  .guide__path-head h2 {
    max-width: 22ch;
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    line-height: var(--lh-2xl);
    font-weight: 560;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .guide__path-head > p {
    max-width: 42ch;
    color: var(--text-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-sm);
  }

  .guide__curators,
  .guide__related {
    margin-top: var(--space-9);
    padding-top: var(--space-7);
    border-top: 1px solid var(--border-1);
  }

  .guide__curators-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .guide__curator-card {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-full);
    background: var(--bg-1);
    color: var(--text-1);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .guide__curator-card:hover {
    border-color: var(--accent);
    color: var(--text-1);
  }

  .guide__curator-name {
    font-size: var(--fs-sm);
    font-weight: 600;
  }

  .guide__related-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .guide__related h2 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--fs-3xl);
    font-weight: 560;
    line-height: var(--lh-3xl);
    text-wrap: balance;
  }

  .guide__related-list a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-1);
    background: var(--bg-1);
    color: var(--text-1);
    text-decoration: none;
    transition: border-color var(--dur-2) var(--ease-out);
  }

  .guide__related-list a:hover {
    border-color: var(--accent);
  }

  .guide__related-title {
    font-weight: 650;
  }

  .guide__related-meta {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }

  @media (min-width: 48rem) {
    .guide__intro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-8);
    }

    .guide__audience {
      grid-column: 1 / -1;
    }

    .guide__path-head {
      grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
      align-items: end;
    }
  }

  @media (max-width: 47.999rem) {
    .guide__related h2 {
      font-size: 2rem;
      line-height: 1.15;
    }
  }
</style>
