---
/**
 * V4-GUIDE-004 — Field Guide catalogue `/guides` (05 §14). Public, SSR.
 * Lists published guides with a featured lead, SSR topic + difficulty filters
 * (`?topic=` / `?level=`), and a responsive card grid. Curated learning paths;
 * starting/reading a guide is login-gated on the detail page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/guides/GuideCard.astro';
import GuideCardFeatured from '../../components/guides/GuideCardFeatured.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import CollectionArchive from '../../components/ui/CollectionArchive.astro';
import CollectionHeader from '../../components/ui/CollectionHeader.astro';
import Chip from '../../components/ui/Chip.astro';
import { guidesRepo } from '../../lib/repositories';
import { itemListJsonLd, collectionPageJsonLd } from '../../lib/seo/jsonld';
import { absoluteUrl } from '../../lib/seo/meta';
import { paginateCollection, parseCollectionPage } from '../../lib/collections/pagination';
import { collectionPageRedirect, collectionQueryPath } from '../../lib/collections/query';
import type { GuideListItem, GuideDifficulty } from '../../types/content';

let all: GuideListItem[] = [];
try {
  const { items } = await guidesRepo.list({ pageSize: 1000 });
  all = items;
} catch (error) {
  console.error('[guides] list unavailable:', error instanceof Error ? error.message : error);
}

const activeTopic = Astro.url.searchParams.get('topic');
const activeLevel = Astro.url.searchParams.get('level');
const rawPage = Astro.url.searchParams.get('page');
const page = parseCollectionPage(rawPage) ?? 1;
const user = Astro.locals.user;

// Topic facets that actually have guides, busiest first (parity with /projects).
const topicCounts = new Map<string, { name: string; slug: string; count: number }>();
for (const guide of all) {
  for (const topic of guide.topics) {
    const entry = topicCounts.get(topic.slug) ?? { ...topic, count: 0 };
    entry.count += 1;
    topicCounts.set(topic.slug, entry);
  }
}
const topics = [...topicCounts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const LEVELS: { label: string; value: GuideDifficulty }[] = [
  { label: 'Beginner', value: 'beginner' },
  { label: 'Intermediate', value: 'intermediate' },
  { label: 'Advanced', value: 'advanced' },
];

const isFiltered = Boolean(activeTopic || activeLevel);
const visible = all.filter(
  (g) =>
    (!activeTopic || g.topics.some((t) => t.slug === activeTopic)) &&
    (!activeLevel || g.difficulty === activeLevel),
);

// The featured guide is an editorial module outside the archive grid. Every
// archive page therefore keeps a complete nine-card (3 × 3 desktop) rhythm.
const featuredGuide = !isFiltered ? all.find((g) => g.featured) : undefined;
const featured = page === 1 ? featuredGuide : undefined;
const archive = featuredGuide ? visible.filter((g) => g.slug !== featuredGuide.slug) : visible;
const archivePage = paginateCollection(archive, page);
const gridItems = archivePage.items;
const totalPages = archivePage.totalPages;

const buildHref = ({
  nextPage = 1,
  topic = activeTopic,
  level = activeLevel,
}: { nextPage?: number; topic?: string | null; level?: string | null } = {}) => {
  return collectionQueryPath('/guides', { topic, level }, nextPage);
};

const pageRedirect = collectionPageRedirect(rawPage, page, totalPages, (nextPage) => buildHref({ nextPage }));
if (pageRedirect) {
  return Astro.redirect(pageRedirect.href, pageRedirect.status);
}

const prevHref = page > 1 ? buildHref({ nextPage: page - 1 }) : undefined;
const nextHref = page < totalPages ? buildHref({ nextPage: page + 1 }) : undefined;

const description =
  'Curated, practical, ordered learning paths with honest prerequisites and practitioner context to help reduce noise.';

const jsonLd = [
  collectionPageJsonLd({ name: 'Guides — Data Dreamer', url: '/guides', description }),
  itemListJsonLd({
    name: 'Data Dreamer Guides',
    items: all.map((g) => ({ '@type': 'CreativeWork', name: g.title, url: absoluteUrl(`/guides/${g.slug}`) })),
  }),
];
---

<BaseLayout
  title={page > 1 ? `Guides page ${page}` : 'Guides'}
  description={description}
  ogImage={{ url: '/og/og-guides.png' }}
  pagination={{
    prev: prevHref ? absoluteUrl(prevHref) : undefined,
    next: nextHref ? absoluteUrl(nextHref) : undefined,
  }}
  jsonLd={jsonLd}
>
  <div class="guides container-wide">
    <CollectionHeader
      kicker="Guides"
      title="Learn from a path, not a pile of links."
      intro={description}
    >
      <span slot="aside" class="guides__count">{all.length.toString().padStart(2, '0')} published {all.length === 1 ? 'guide' : 'guides'}</span>
    </CollectionHeader>

    {all.length === 0 ? (
      <EmptyState message="Guides will appear here as practical learning paths are published." icon="compass" />
    ) : (
      <>
        {featured && (
          <section class="guides__featured" aria-label="Featured guide">
            <GuideCardFeatured guide={featured} />
          </section>
        )}

        <nav class:list={['guides__filters', { 'guides__filters--after-feature': featured }]} aria-label="Filter guides">
          {topics.length > 0 && (
            <div class="guides__filtergroup" role="group" aria-label="Topic">
              <Chip label="All topics" href={buildHref({ topic: null, nextPage: 1 })} selected={!activeTopic} />
              {topics.map((topic) => (
                <Chip
                  label={`${topic.name} ${topic.count}`}
                  href={buildHref({ topic: topic.slug, nextPage: 1 })}
                  selected={activeTopic === topic.slug}
                />
              ))}
            </div>
          )}
          <div class="guides__filtergroup guides__filtergroup--levels" role="group" aria-label="Difficulty">
            <Chip label="All levels" href={buildHref({ level: null, nextPage: 1 })} selected={!activeLevel} />
            {LEVELS.map((level) => (
              <Chip
                label={level.label}
                href={buildHref({ level: level.value, nextPage: 1 })}
                selected={activeLevel === level.value}
              />
            ))}
          </div>
        </nav>

        <aside class="guides__access" aria-label="Guide access status">
          <div>
            <strong>{user ? 'Your learning paths are ready.' : 'Preview any route. Sign in to save progress.'}</strong>
            <span>{user ? 'Continue exactly where you stopped.' : 'Accounts unlock notes, saved steps, and resume points.'}</span>
          </div>
          <a href={user ? '/account?tab=guides' : '/login?next=%2Fguides'}>
            {user ? 'View saved progress' : 'Sign in'} <span aria-hidden="true">→</span>
          </a>
        </aside>

        {gridItems.length > 0 ? (
          <CollectionArchive
            headingId="guide-results-heading"
            title={featured ? 'More guides' : 'Guides'}
            itemCount={gridItems.length}
            singular="guide"
            page={page}
            prevHref={prevHref}
            nextHref={nextHref}
          >
            {gridItems.map((guide) => <GuideCard guide={guide} variant="index" />)}
          </CollectionArchive>
        ) : !featured ? (
          <EmptyState
            message="No guides match these filters yet."
            icon="search-x"
            action={{ label: 'Clear filters', href: '/guides' }}
          />
        ) : null}
      </>
    )}
  </div>
</BaseLayout>

<style>
  .guides {
    padding-block: var(--page-top) var(--page-bottom);
  }

  .guides__count {
    display: block;
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
  }

  .guides__access {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-md);
    background: var(--bg-1);
  }

  .guides__access > div {
    display: grid;
    gap: var(--space-1);
  }

  .guides__access strong {
    color: var(--text-1);
    font-size: var(--fs-sm);
  }

  .guides__access > div > span {
    color: var(--text-3);
    font-size: var(--fs-sm);
  }

  .guides__access a {
    display: inline-flex;
    gap: var(--space-2);
    color: var(--accent);
    font-size: var(--fs-sm);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }

  .guides__featured {
    margin-top: var(--space-7);
  }

  .guides__filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-7);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border-1);
  }

  .guides__filters--after-feature {
    border-top: 1px solid var(--border-1);
  }

  .guides__filtergroup {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (max-width: 40rem) {
    .guides__access {
      align-items: flex-start;
      flex-direction: column;
    }

  }
</style>
