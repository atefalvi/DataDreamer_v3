---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSignalField from '../components/home/HeroSignalField.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import PostCard from '../components/blog/PostCard.astro';
import GuideCard from '../components/guides/GuideCard.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Avatar from '../components/ui/Avatar.astro';
import { postsRepo, authorsRepo, guidesRepo } from '../lib/repositories';
import { FLAGS, HOME_SEO, SOCIAL_LINKS } from '../content/site';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo/jsonld';
import type { AuthorRef, GuideListItem, PostListItem } from '../types/content';

// Each section degrades independently — a CMS outage shows an empty section, never a
// 500 (the hero + shell are static and always render).
let posts: PostListItem[] = [];
try {
  posts = await postsRepo.latest(3);
} catch (error) {
  console.error('[home] latest posts unavailable:', error instanceof Error ? error.message : error);
}

let team: AuthorRef[] = [];
let teamCount = 0;
let specialtyCount = 0;
try {
  const summaries = await authorsRepo.allWithCounts(Astro.locals);
  teamCount = summaries.length;
  specialtyCount = new Set(summaries.flatMap((a) => a.specialties.map((s) => s.slug))).size;
  team = summaries.slice(0, 8).map(({ slug, name, avatar }) => ({ slug, name, avatar, dreamTeam: true }));
} catch (error) {
  console.error('[home] team unavailable:', error instanceof Error ? error.message : error);
}

// Field Guides teaser (v4.1) — only fetched/rendered when the release flag is on.
let guides: GuideListItem[] = [];
if (FLAGS.GUIDES_ENABLED) {
  // Decorative teaser — degrade to no section on any read failure (no per-request log
  // spam; the /guides catalogue is the place that surfaces a real read problem).
  try {
    guides = await guidesRepo.latest(3);
  } catch {
    guides = [];
  }
}

const featured = posts[0];
const compact = posts.slice(1, 3);

const jsonLd = [
  websiteJsonLd(),
  organizationJsonLd(SOCIAL_LINKS.map((link) => link.href).filter((href) => href.startsWith('http'))),
];

const teamSentence =
  teamCount > 0
    ? `${teamCount} ${teamCount === 1 ? 'person' : 'people'} across ${specialtyCount} specialt${specialtyCount === 1 ? 'y' : 'ies'}, connected by the data problems they solve.`
    : '';
---

<BaseLayout
  title={HOME_SEO.title}
  description={HOME_SEO.description}
  ogType="website"
  ogImage={{ url: '/og/og-home.png' }}
  transparentNav
  jsonLd={jsonLd}
>
  <HeroSignalField />

  <section class="home-studio home-band container-content" aria-label="What Data Dreamer explores">
    <div class="home-studio__copy">
      <p class="kicker">What Data Dreamer explores</p>
      <h2>Data work beyond dashboards.</h2>
    </div>
    <div class="home-studio__cards">
      <article class="home-studio-card">
        <div class="home-studio-card__meta">
          <span>01</span>
          <span>Business context</span>
        </div>
        <div class="home-studio-card__body">
          <h3>Define the problem</h3>
          <p>Understand the business question, source systems, definitions, and assumptions before choosing a solution.</p>
        </div>
      </article>
      <article class="home-studio-card">
        <div class="home-studio-card__meta">
          <span>02</span>
          <span>Technical systems</span>
        </div>
        <div class="home-studio-card__body">
          <h3>Build the workflow</h3>
          <p>Turn raw inputs into reliable models, pipelines, automations, and understandable interfaces.</p>
        </div>
      </article>
      <article class="home-studio-card">
        <div class="home-studio-card__meta">
          <span>03</span>
          <span>Decisions and people</span>
        </div>
        <div class="home-studio-card__body">
          <h3>Explain the outcome</h3>
          <p>Document trade-offs, limitations, and human context so the work supports clearer decisions.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="home-section home-band home-band--tint home-section--writing container-content">
    <SectionHeader
      kicker="Latest posts"
      title="Field notes from the messy middle of data work."
      intro="Structured reflections, practical lessons, useful tools, and lived experience from learning, building, and explaining real-world data systems."
      action={{ label: 'All posts', href: '/blog' }}
    />
    {posts.length === 0 ? (
      <EmptyState
        message="New posts will appear here once they are published."
        icon="pen-line"
        action={{ label: 'Explore posts', href: '/blog' }}
      />
    ) : (
      <div class="home-writing">
        {featured && (
          <div class="home-writing__featured" data-reveal>
            <PostCard post={featured} variant="featured" />
          </div>
        )}
        {compact.length > 0 && (
          <div class="home-writing__rest">
            {compact.map((post) => (
              <div data-reveal data-reveal-group="home-posts">
                <PostCard post={post} variant="compact" />
              </div>
            ))}
          </div>
        )}
      </div>
    )}
  </section>

  {/* Selected work — added with the projects content collection (V4-CMS-005 / V4-PROJ-001). */}

  {FLAGS.GUIDES_ENABLED && guides.length > 0 && (
    <section class="home-section home-band home-band--tint container-content" aria-label="Guides">
      <SectionHeader
        kicker="Guides"
        title="Learn from a path, not a pile of links."
        intro="Curated, ordered learning paths with practitioner context to help you focus on what matters and skip unnecessary noise."
        action={{ label: 'Explore guides', href: '/guides' }}
      />
      <div class="home-guides">
        {guides.map((guide) => (
          <div data-reveal data-reveal-group="home-guides">
            <GuideCard guide={guide} />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="home-section home-band container-content">
    <SectionHeader
      kicker="Dream Team"
      title="A human map of data in the real world."
      intro="The Dream Team connects people from different backgrounds, industries, and domains through the problems they solve and the data they use."
      action={{ label: 'Meet the team', href: '/dream-team' }}
    />
    {team.length > 0 ? (
      <a href="/dream-team" class="team-strip" data-reveal>
        <ul class="team-strip__avatars">
          {team.map((member) => (
            <li><Avatar src={member.avatar?.src} name={member.name} size={48} /></li>
          ))}
        </ul>
        <p class="team-strip__text">{teamSentence}</p>
      </a>
    ) : (
      <EmptyState
        message="Dream Team profiles will appear here as the network grows."
        icon="orbit"
        action={{ label: 'Open Dream Team', href: '/dream-team' }}
      />
    )}
  </section>
</BaseLayout>

<style>
  .home-section {
    padding-block: var(--section-y) 0;
  }

  /* Section delineation — every band opens with a full-width hairline + a short accent
     tick so the eye registers a new section starting (premium editorial rhythm). */
  .home-band {
    position: relative;
    margin-top: var(--section-y);
    padding-block-start: var(--section-y);
    border-top: 1px solid color-mix(in srgb, var(--border-2) 80%, transparent);
  }

  .home-band::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: var(--editorial-rule-accent);
    height: 2px;
    background: var(--accent);
  }

  /* Tinted, full-bleed band gives the middle section its own zone (clear separation
     from the sections above and below). */
  .home-band--tint {
    padding-block-end: var(--section-y);
  }

  .home-band--tint::after {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background: color-mix(in srgb, var(--bg-1) 55%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--border-2) 80%, transparent);
  }

  .home-studio {
    display: grid;
    gap: var(--space-8);
  }

  .home-studio__copy {
    display: grid;
    gap: var(--space-4);
    max-width: 50rem;
  }

  .home-studio__copy h2 {
    max-width: 16ch;
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
  }

  .home-studio__cards {
    display: grid;
    border-top: 1px solid var(--border-2);
  }

  .home-studio-card {
    display: grid;
    grid-template-columns: minmax(5rem, 0.18fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border-1);
  }

  .home-studio-card__meta,
  .home-studio-card__body {
    min-width: 0;
  }

  .home-studio-card__meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
  }

  .home-studio-card__meta span:last-child {
    color: var(--text-3);
    line-height: var(--lh-xs);
  }

  .home-studio-card__body {
    display: grid;
    gap: var(--space-3);
  }

  .home-studio-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 580;
    line-height: var(--lh-xl);
  }

  .home-studio-card p {
    max-width: 39rem;
    color: var(--text-2);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
    overflow-wrap: break-word;
  }

  @media (min-width: 56rem) {
    .home-studio {
      grid-template-columns: minmax(20rem, 0.62fr) minmax(0, 1.38fr);
      column-gap: clamp(var(--space-8), 6vw, var(--space-9));
      align-items: start;
    }

    .home-studio__rule {
      grid-column: 1 / -1;
    }
  }

  .home-writing {
    display: grid;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  .home-guides {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  @media (min-width: 48rem) {
    .home-guides {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .home-guides {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .home-section :global(.ui-empty-state) {
    margin-top: var(--space-7);
  }

  @media (min-width: 64rem) {
    .home-writing {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  .home-writing__rest {
    display: grid;
    align-content: start;
  }

  .team-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-7);
    padding-block: var(--space-6);
    border-block: 1px solid var(--border-1);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .team-strip:hover {
    border-color: var(--accent);
  }

  .team-strip::after {
    margin-left: auto;
    color: var(--accent);
    font-size: var(--fs-sm);
    font-weight: 650;
    content: 'Explore the map →';
  }

  .team-strip__avatars {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team-strip__avatars li:not(:first-child) {
    margin-left: -12px;
  }

  .team-strip__avatars :global(.ui-avatar) {
    box-shadow: 0 0 0 2px var(--bg-0);
  }

  .team-strip__text {
    flex: 1 1 16rem;
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  @media (max-width: 47.999rem) {
    .home-studio-card {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding-block: var(--space-6);
    }

    .home-studio-card__meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .home-studio-card h3 {
      font-size: var(--fs-xl);
    }

    .home-studio-card p {
      font-size: var(--fs-sm);
      line-height: var(--lh-sm);
    }

    .team-strip {
      align-items: flex-start;
    }

    .team-strip::after {
      flex-basis: 100%;
      margin-left: 0;
    }
  }
</style>
