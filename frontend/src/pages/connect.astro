---
/**
 * V4-PAGE-002 — Connect (05 §10). Single-column, prose-width. No form in v4.0 (no mail
 * backend; mailto is honest). Primary email card copies to clipboard with an SR live
 * region; channels are labeled external links; content is repo-owned (site.ts).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { CONNECT } from '../content/site';
import { SITE_URL } from '../lib/seo/meta';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact — DataDreamer',
    url: `${SITE_URL}/connect`,
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with DataDreamer — project inquiries, advisory, and collaboration. Email is the fastest way to reach me."
  ogImage={{ url: '/og/og-default.png' }}
  jsonLd={jsonLd}
>
  <div class="page container-content">
    <header class="page__head">
      <p class="kicker">{CONNECT.kicker}</p>
      <h1>{CONNECT.title}</h1>
      <p class="page__intro">{CONNECT.intro}</p>
    </header>

    <section class="email-card" aria-label="Email">
      <p class="email-card__label">Primary channel</p>
      <div class="email-card__row">
        <a class="email-card__address" href={`mailto:${CONNECT.email}`}>{CONNECT.email}</a>
        <button type="button" class="email-card__copy" data-copy-email data-email={CONNECT.email}>
          <Icon name="copy" size={16} />
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <p class="email-card__hint">{CONNECT.availability}</p>
      <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
    </section>

    <section class="channels" aria-label="Other channels">
      <p class="channels__label">Elsewhere</p>
      <ul>
        {CONNECT.channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              rel={channel.external ? 'noopener noreferrer' : undefined}
              target={channel.external ? '_blank' : undefined}
            >
              <span class="channels__icon"><Icon name={channel.icon} size={20} /></span>
              <span class="channels__label-text">{channel.label}</span>
              <span class="channels__handle">{channel.handle}</span>
              <span class="channels__arrow" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="facts" aria-label="What to expect">
      <dl>
        {CONNECT.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--container-prose);
    padding-block: calc(78px + var(--section-y)) var(--section-y);
  }

  .page__head h1 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--fs-4xl);
    line-height: var(--lh-4xl);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .page__intro {
    max-width: 54ch;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-lg);
    line-height: var(--lh-lg);
  }

  /* Email card — the primary action. */
  .email-card {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 46%),
      var(--bg-1);
  }

  .email-card__label,
  .channels__label {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .email-card__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .email-card__address {
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: clamp(1.125rem, 1rem + 1.4vw, 1.75rem);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email-card__address:hover {
    color: var(--accent);
  }

  .email-card__copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
    min-height: 2.5rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-full);
    background: var(--bg-2);
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
  }

  .email-card__copy:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .email-card__copy:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .email-card__copy[data-copied] {
    border-color: var(--success);
    color: var(--success);
  }

  .email-card__hint {
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: var(--fs-sm);
  }

  /* Channels. */
  .channels {
    margin-top: var(--space-8);
  }

  .channels ul {
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-1);
  }

  .channels a {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-2);
    border-bottom: 1px solid var(--border-1);
    color: var(--text-1);
    text-decoration: none;
    transition: padding-inline var(--dur-2) var(--ease-out), background var(--dur-2) var(--ease-out);
  }

  .channels a:hover {
    background: color-mix(in srgb, var(--bg-2) 60%, transparent);
    padding-inline: var(--space-4) var(--space-2);
  }

  .channels__icon {
    display: inline-flex;
    color: var(--text-2);
  }

  .channels a:hover .channels__icon {
    color: var(--accent);
  }

  .channels__label-text {
    font-weight: 560;
  }

  .channels__handle {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
  }

  .channels__arrow {
    display: inline-flex;
    color: var(--text-3);
    transform: translate(-2px, 0);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }

  .channels a:hover .channels__arrow {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--accent);
  }

  /* Facts. */
  .facts {
    margin-top: var(--space-8);
  }

  .facts dl {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  .facts div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.3fr) 1fr;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-1);
  }

  .facts dt {
    color: var(--text-1);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .facts dd {
    margin: 0;
    color: var(--text-2);
    font-size: var(--fs-base);
    line-height: var(--lh-base);
  }

  @media (max-width: 39.999rem) {
    .channels a {
      grid-template-columns: auto 1fr auto;
      row-gap: var(--space-1);
    }
    .channels__handle {
      grid-column: 2 / 4;
      grid-row: 2;
    }
    .facts div {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const label = button?.querySelector<HTMLElement>('[data-copy-label]');

  if (button) {
    let resetTimer = 0;
    button.addEventListener('click', async () => {
      const email = button.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
        if (label) label.textContent = 'Copied';
        button.setAttribute('data-copied', '');
        if (status) status.textContent = `Copied ${email} to clipboard`;
        window.clearTimeout(resetTimer);
        resetTimer = window.setTimeout(() => {
          if (label) label.textContent = 'Copy';
          button.removeAttribute('data-copied');
          if (status) status.textContent = '';
        }, 2400);
      } catch {
        if (status) status.textContent = `Could not copy automatically — the address is ${email}`;
      }
    });
  }
</script>
