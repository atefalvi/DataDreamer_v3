# Directus Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Database ─────────────────────────────────────────
DB_USER=directus
DB_PASSWORD=change_me_strong_password
DB_DATABASE=datadreamer

# ── Directus Core ────────────────────────────────────
# Generate a random 64-char string: openssl rand -hex 32
DIRECTUS_SECRET=change_me_random_secret

DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change_me_admin_password

# ── URLs ─────────────────────────────────────────────
# Production Examples:
DIRECTUS_PUBLIC_URL=https://api.your-domain.com
CORS_ORIGIN=https://your-domain.com

# ── Field Guides learner auth ────────────────────────
# UUID of the low-permission Guide Reader role configured in Directus.
GUIDE_READER_ROLE_ID=replace_with_guide_reader_role_uuid
GOOGLE_REDIRECT_URL=https://your-domain.com/api/auth/google/callback
SESSION_COOKIE_DOMAIN=.your-domain.com
SESSION_COOKIE_SECURE=true

# Google Cloud Web OAuth client. Authorized redirect URI:
# https://api.your-domain.com/auth/login/google/callback
AUTH_GOOGLE_CLIENT_ID=replace_with_google_client_id
AUTH_GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Local development:
# DIRECTUS_PUBLIC_URL=http://localhost:8056
# CORS_ORIGIN=http://localhost:4321
